---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { absoluteUrl, SITE } from '../config/site';

interface Props {
  title: string;
  h1: string;
  description: string;
  updated?: string;
  lede?: string;
}

const { title, h1, description, updated, lede } = Astro.props;
const url = absoluteUrl(Astro.url.pathname);
const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${SITE.url}/#website` },
    ...(updated ? { dateModified: updated } : {}),
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: h1, item: url },
      ],
    },
  },
];
const fmt = (d: string) => new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d + 'T12:00:00'));
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="container-page pt-5 pb-12">
    <Breadcrumb items={[{ label: 'Ana Sayfa', href: '/' }, { label: h1, href: Astro.url.pathname }]} />
    <div class="max-w-3xl">
      <h1 class="text-[2rem] sm:text-[2.5rem] font-extrabold tracking-[-0.025em]">{h1}</h1>
      {lede && <p class="mt-3 text-[1.125rem] text-[var(--color-text-secondary)] leading-relaxed">{lede}</p>}
      {updated && <p class="mt-3 text-[0.8125rem] text-[var(--color-text-muted)]">Son güncelleme: <time datetime={updated}>{fmt(updated)}</time></p>}
      <div class="prose-hh">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
