---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Kesirlerde toplama nasıl yapılır?",
    answer: "Paydaları eşit kesirlerde yalnızca paylar toplanır, payda aynen yazılır. Paydalar farklıysa önce paydalar eşitlenir; bunun için paydaların EKOK'u ortak payda olarak alınır. Örneğin 1/4 + 1/6 işleminde ortak payda 12'dir: 3/12 + 2/12 = 5/12. Genel formül a/b + c/d = (a × d + c × b) / (b × d) şeklindedir; sonuç sadeleştirilir."
  },
  {
    question: "Kesirlerde çarpma ve bölme nasıl yapılır?",
    answer: "Çarpmada paylar kendi arasında, paydalar kendi arasında çarpılır: a/b × c/d = (a × c) / (b × d). Bölmede ise birinci kesir aynen yazılır, ikinci kesir ters çevrilip çarpılır: a/b ÷ c/d = (a × d) / (b × c). Örneğin 2/3 ÷ 4/5 = 2/3 × 5/4 = 10/12 = 5/6 olur."
  },
  {
    question: "Kesir nasıl sadeleştirilir?",
    answer: "Bir kesri sadeleştirmek için pay ve payda, ikisinin en büyük ortak böleni (EBOB) ile bölünür. Örneğin 18/24 için EBOB(18, 24) = 6 olduğundan 18/24 = 3/4 elde edilir. Pay ve paydanın EBOB'u 1 olduğunda kesir en sade halindedir. Sadeleştirme kesrin değerini değiştirmez, yalnızca daha küçük sayılarla ifade eder."
  },
  {
    question: "Bileşik kesir tam sayılı kesre nasıl çevrilir?",
    answer: "Payı paydasından büyük olan bileşik kesri tam sayılı kesre çevirmek için pay paydaya bölünür. Bölüm tam kısım, kalan yeni pay olur, payda aynı kalır. Örneğin 17/5 için 17 ÷ 5 = 3, kalan 2 olduğundan sonuç 3 tam 2/5'tir. Tersi için tam kısım payda ile çarpılıp paya eklenir: 3 × 5 + 2 = 17."
  },
  {
    question: "Kesir ondalık sayıya nasıl çevrilir?",
    answer: "Kesri ondalık sayıya çevirmek için pay paydaya bölünür. 3/4 = 0,75 ve 1/8 = 0,125 gibi paydası yalnızca 2 ve 5 çarpanlarından oluşan kesirler sonlu ondalık sayı verir. 1/3 = 0,333... gibi diğer kesirler ise devirli ondalık sayıya dönüşür. Yüzdeye çevirmek için ondalık sonuç 100 ile çarpılır; 3/4 = %75'tir."
  }
];

const meta = {
  title: "Kesir Hesaplama",
  seoTitle: "Kesir Hesaplama - Toplama, Çıkarma, Çarpma, Bölme",
  description: "Kesir hesaplama aracı ile kesirlerde toplama, çıkarma, çarpma ve bölme yapın. Sonucu sadeleştirilmiş, tam sayılı kesir ve ondalık olarak adım adım görün.",
  summary: "Kesirlerde toplama ve çıkarmada paydalar eşitlenir: a/b ± c/d = (a·d ± c·b) / (b·d). Çarpmada paylar ve paydalar çarpılır, bölmede ikinci kesir ters çevrilip çarpılır. Sonuç pay ve paydanın EBOB'una bölünerek sadeleştirilir; örneğin 1/4 + 1/6 = 5/12 ≈ 0,4167.",
  howTo: [
    "Birinci kesrin payını ve paydasını girin.",
    "Yapmak istediğiniz işlemi seçin: toplama, çıkarma, çarpma veya bölme.",
    "İkinci kesrin payını ve paydasını girin.",
    "Sadeleştirilmiş sonucu, tam sayılı kesir halini ve ondalık karşılığını inceleyin."
  ],
  sources: [],
  category: "matematik",
  slug: "kesir-hesaplama",
  keywords: ["kesir hesaplama", "kesirlerde toplama", "kesirlerde bölme", "kesir sadeleştirme", "kesir çarpma", "rasyonel sayı hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["matematik/ebob-ekok-hesaplama", "matematik/oran-hesaplama", "matematik/yuzde-hesaplama", "matematik/ortalama-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs">
    <CalcInput id="a" label="1. Kesrin Payı" type="number" placeholder="1" step={1} />
    <CalcInput id="b" label="1. Kesrin Paydası" type="number" placeholder="4" step={1} />
    <CalcSelect
      id="islem"
      label="İşlem"
      options={[
        { value: "topla", label: "Toplama (+)" },
        { value: "cikar", label: "Çıkarma (−)" },
        { value: "carp", label: "Çarpma (×)" },
        { value: "bol", label: "Bölme (÷)" }
      ]}
      value="topla"
    />
    <CalcInput id="c" label="2. Kesrin Payı" type="number" placeholder="1" step={1} />
    <CalcInput id="d" label="2. Kesrin Paydası" type="number" placeholder="6" step={1} />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Sonuç (sadeleştirilmiş)</p>
      <p class="calc-result-value" id="sonuc">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row"><span class="calc-detail-label">İşlem</span><span class="calc-detail-value" id="ifade">—</span></div>
      <div class="calc-detail-row"><span class="calc-detail-label">Sadeleştirmeden Önce</span><span class="calc-detail-value" id="ham">—</span></div>
      <div class="calc-detail-row"><span class="calc-detail-label">Tam Sayılı Kesir</span><span class="calc-detail-value" id="tamsayili">—</span></div>
      <div class="calc-detail-row"><span class="calc-detail-label">Ondalık Karşılığı</span><span class="calc-detail-value" id="ondalik">—</span></div>
      <div class="calc-detail-row"><span class="calc-detail-label">Yüzde Karşılığı</span><span class="calc-detail-value" id="yuzde">—</span></div>
    </div>
  </CalcResult>

  <script>
    function gcd(a: number, b: number): number { a = Math.abs(a); b = Math.abs(b); while (b) { [a, b] = [b, a % b]; } return a; }
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('calc-form');
      const inputs = document.querySelectorAll('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
      const setText = (id: string, t: string) => { (document.getElementById(id) as HTMLElement).textContent = t; };
      const dec = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 6 }).format(n);
      const OPS: Record<string, string> = { topla: '+', cikar: '−', carp: '×', bol: '÷' };

      form?.addEventListener('submit', (e) => e.preventDefault());
      const debouncedCalc = debounce(calculate);
      inputs.forEach(input => {
        input.addEventListener('input', debouncedCalc);
        input.addEventListener('change', debouncedCalc);
      });

      function calculate() {
        const [a, b, c, d] = ['a', 'b', 'c', 'd'].map(id => Number(val(id)));
        const islem = val('islem');
        if ([a, b, c, d].some(n => !Number.isInteger(n)) || val('a') === '' || val('c') === '' || b === 0 || d === 0) return;

        let p: number, q: number;
        if (islem === 'topla') { p = a * d + c * b; q = b * d; }
        else if (islem === 'cikar') { p = a * d - c * b; q = b * d; }
        else if (islem === 'carp') { p = a * c; q = b * d; }
        else { if (c === 0) { setText('sonuc', 'Sıfıra bölünemez'); resultArea?.classList.remove('hidden'); return; } p = a * d; q = b * c; }
        if (q < 0) { p = -p; q = -q; }
        const g = gcd(p, q) || 1;
        const sp = p / g, sq = q / g;

        setText('ifade', `${a}/${b} ${OPS[islem]} ${c}/${d}`);
        setText('ham', `${p}/${q}`);
        setText('sonuc', sq === 1 ? `${sp}` : `${sp}/${sq}`);
        if (Math.abs(sp) >= sq && sq !== 1) {
          const tam = Math.trunc(sp / sq);
          const kalan = Math.abs(sp % sq);
          setText('tamsayili', `${tam} tam ${kalan}/${sq}`);
        } else {
          setText('tamsayili', sq === 1 ? `${sp} (tam sayı)` : 'Basit kesir');
        }
        setText('ondalik', dec(sp / sq));
        setText('yuzde', '%' + dec(sp / sq * 100));

        if (resultArea) resultArea.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(input => {
          const el = input as HTMLInputElement;
          if (el.value && el.id) params.set(el.id, el.value);
        });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let hasParams = false;
        inputs.forEach(input => {
          const el = input as HTMLInputElement;
          if (el.id && params.has(el.id)) { el.value = params.get(el.id)!; hasParams = true; }
        });
        if (hasParams) calculate();
      }

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Kesir Nedir?</h2>
    <p>
      Kesir, bir bütünün eşit parçalarından kaç tanesinin alındığını gösteren sayıdır ve a/b biçiminde yazılır. Üstteki sayıya pay, alttaki sayıya payda denir; payda bütünün kaç eşit parçaya bölündüğünü, pay ise kaç parçanın alındığını gösterir. Payda sıfır olamaz. Kesir hesaplama aracı, iki kesir arasında dört işlemi yapar ve sonucu en sade haliyle, tam sayılı kesir olarak ve ondalık sayı biçiminde gösterir.
    </p>

    <h2>Kesir Türleri</h2>
    <ul>
      <li><strong>Basit kesir:</strong> Payı paydasından küçük kesirlerdir (3/5, 1/4).</li>
      <li><strong>Bileşik kesir:</strong> Payı paydasına eşit veya paydasından büyük kesirlerdir (7/4, 5/5).</li>
      <li><strong>Tam sayılı kesir:</strong> Bir tam sayı ve bir basit kesirden oluşur (1 tam 3/4).</li>
      <li><strong>Denk kesirler:</strong> Farklı yazılan ama aynı değeri gösteren kesirlerdir (1/2 = 2/4 = 3/6).</li>
    </ul>

    <h2>Kesirlerde Dört İşlem Formülleri</h2>
    <table>
      <thead>
        <tr><th>İşlem</th><th>Formül</th><th>Örnek</th></tr>
      </thead>
      <tbody>
        <tr><td>Toplama</td><td>a/b + c/d = (a·d + c·b) / (b·d)</td><td>1/4 + 1/6 = 10/24 = 5/12</td></tr>
        <tr><td>Çıkarma</td><td>a/b − c/d = (a·d − c·b) / (b·d)</td><td>3/4 − 1/3 = 5/12</td></tr>
        <tr><td>Çarpma</td><td>a/b × c/d = (a·c) / (b·d)</td><td>2/3 × 3/4 = 6/12 = 1/2</td></tr>
        <tr><td>Bölme</td><td>a/b ÷ c/d = (a·d) / (b·c)</td><td>2/3 ÷ 4/5 = 10/12 = 5/6</td></tr>
      </tbody>
    </table>

    <h2>Örnek Hesaplama</h2>
    <p>5/6 + 3/4 işlemini adım adım çözelim:</p>
    <ul>
      <li>Paydaları eşitle: EKOK(6, 4) = 12</li>
      <li>5/6 = 10/12 ve 3/4 = 9/12</li>
      <li>Payları topla: 10/12 + 9/12 = 19/12</li>
      <li>Sadeleştir: EBOB(19, 12) = 1 olduğundan 19/12 en sade haldedir</li>
      <li>Tam sayılı kesre çevir: 19 ÷ 12 = 1, kalan 7 → 1 tam 7/12</li>
      <li>Ondalık karşılığı: 19 / 12 ≈ 1,583333</li>
    </ul>
    <p>
      Hesaplayıcı paydaları çarparak ortak payda bulur (5/6 + 3/4 = 38/24), ardından EBOB ile sadeleştirerek aynı sonuca, 19/12'ye ulaşır.
    </p>

    <h2>Sık Kullanılan Kesirlerin Ondalık ve Yüzde Karşılıkları</h2>
    <table>
      <thead>
        <tr><th>Kesir</th><th>Ondalık</th><th>Yüzde</th></tr>
      </thead>
      <tbody>
        <tr><td>1/2</td><td>0,5</td><td>%50</td></tr>
        <tr><td>1/3</td><td>0,333...</td><td>%33,33</td></tr>
        <tr><td>1/4</td><td>0,25</td><td>%25</td></tr>
        <tr><td>1/5</td><td>0,2</td><td>%20</td></tr>
        <tr><td>1/8</td><td>0,125</td><td>%12,5</td></tr>
        <tr><td>2/3</td><td>0,666...</td><td>%66,67</td></tr>
        <tr><td>3/4</td><td>0,75</td><td>%75</td></tr>
      </tbody>
    </table>

    <h2>Kesir İşlemlerinde Sık Yapılan Hatalar</h2>
    <ul>
      <li>Toplamada payları ve paydaları ayrı ayrı toplamak (1/2 + 1/3 ≠ 2/5).</li>
      <li>Bölmede birinci kesri ters çevirmek; ters çevrilen her zaman ikinci kesirdir.</li>
      <li>Negatif işareti paydada bırakmak; işaret genellikle paya veya kesrin önüne yazılır.</li>
      <li>Sonucu sadeleştirmeyi unutmak; sınavlarda cevaplar çoğunlukla en sade halde verilir.</li>
    </ul>
    <h2>Kesirleri Karşılaştırma</h2>
    <p>İki kesirden hangisinin büyük olduğunu bulmak için paydalar eşitlenebilir veya çapraz çarpım yapılabilir. a/b ile c/d karşılaştırılırken a × d ile c × b değerlerine bakılır; büyük olan çarpım, o kesrin daha büyük olduğunu gösterir. Örneğin 5/7 ile 3/4 için 5 × 4 = 20 ve 3 × 7 = 21 olduğundan 3/4 daha büyüktür. Payları eşit kesirlerde paydası küçük olan, paydaları eşit kesirlerde ise payı büyük olan kesir daha büyüktür. Kesirleri ondalık sayıya çevirmek de hızlı bir karşılaştırma yoludur; hesaplayıcının gösterdiği ondalık karşılık bu amaçla kullanılabilir.</p>
    <p class="calc-note">
      Not: Hesaplayıcı tam sayı pay ve paydalarla çalışır. Ondalıklı bir sayıyı kesre çevirmek için önce 10'un kuvvetleriyle genişletin (0,75 = 75/100).
    </p>
  </section>
</CalcLayout>
