---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Vücut kitle indeksi nasıl hesaplanır?",
    answer: "VKİ, kilonun (kg) boyun metre cinsinden karesine bölünmesiyle bulunur: VKİ = kg ÷ m². Örneğin 1,75 m boyunda ve 70 kg ağırlığındaki birinin VKİ değeri 70 ÷ (1,75 × 1,75) = 22,9 olur. Boyu santimetre olarak girdiğinizde hesaplayıcı metreye kendisi çevirir; sonuç Dünya Sağlık Örgütü sınıflandırmasına göre yorumlanır."
  },
  {
    question: "Normal VKİ aralığı kaçtır?",
    answer: "Dünya Sağlık Örgütü'ne göre 18 yaş ve üzeri yetişkinlerde normal VKİ aralığı 18,5 ile 24,9 arasıdır. 18,5'in altı zayıf, 25–29,9 fazla kilolu (obezite öncesi), 30 ve üzeri obez kabul edilir. Obezite de kendi içinde 30–34,9 (1. derece), 35–39,9 (2. derece) ve 40 ve üzeri (3. derece, morbid obezite) olarak ayrılır."
  },
  {
    question: "Boyuma göre sağlıklı kilo aralığım nedir?",
    answer: "Sağlıklı kilo aralığı, boyunuzun metre cinsinden karesinin 18,5 ve 24,9 ile çarpılmasıyla bulunur. 1,70 m boyundaki biri için bu aralık yaklaşık 53,5–72,0 kg, 1,80 m için 59,9–80,7 kg'dır. Hesaplayıcı boyunuzu girdiğiniz anda bu aralığı ve mevcut kilonuzun aralığa uzaklığını gösterir."
  },
  {
    question: "VKİ kadın ve erkekte farklı mı hesaplanır?",
    answer: "Hayır. Yetişkinlerde VKİ formülü ve DSÖ sınıflandırma sınırları kadın ve erkek için aynıdır. Ancak aynı VKİ değerinde kadınların vücut yağ oranı genellikle erkeklerden daha yüksektir. Bu yüzden VKİ'yi bel çevresi veya vücut yağ oranı ölçümüyle birlikte değerlendirmek daha doğru bir tablo sunar."
  },
  {
    question: "Çocuklarda ve gençlerde VKİ nasıl yorumlanır?",
    answer: "5–19 yaş arasındaki çocuk ve gençlerde yetişkin sınırları kullanılmaz; VKİ değeri yaş ve cinsiyete göre hazırlanmış DSÖ büyüme eğrileri (persentil veya z-skoru) üzerinden yorumlanır. Bu hesaplayıcı 18 yaş ve üzeri yetişkinler içindir. Çocuğunuzun durumu için Sağlık Bakanlığı'nın çocuk VKİ aracını veya aile hekiminizi kullanın."
  },
  {
    question: "Kaslı biriyim, VKİ'm yüksek çıkıyor. Obez miyim?",
    answer: "Olmayabilirsiniz. VKİ yağ ile kas kütlesini ayırt etmez; düzenli ağırlık antrenmanı yapan kişilerde yüksek kas kütlesi VKİ'yi fazla kilolu aralığına taşıyabilir. Bu durumda bel çevresi (erkekte 94 cm, kadında 80 cm üstü risk artışı) ve vücut yağ oranı daha anlamlı göstergelerdir."
  }
];

const meta = {
  title: "Vücut Kitle İndeksi (VKİ) Hesaplama",
  seoTitle: "VKİ Hesaplama 2026 – Vücut Kitle İndeksi (BMI) Hesapla",
  description: "Boy ve kilonuzu girin, vücut kitle indeksinizi (BMI) DSÖ sınıflarına göre anında öğrenin. Boyunuza uygun sağlıklı kilo aralığını da gösterir.",
  summary: "Vücut kitle indeksi, kilonun boyun metre cinsinden karesine bölünmesiyle hesaplanır (VKİ = kg ÷ m²). Dünya Sağlık Örgütü'ne göre yetişkinlerde 18,5'in altı zayıf, 18,5–24,9 normal, 25–29,9 fazla kilolu, 30 ve üzeri obez kabul edilir.",
  howTo: [
    "Boyunuzu santimetre cinsinden girin (örneğin 172).",
    "Kilonuzu kilogram cinsinden girin (örneğin 68,5).",
    "VKİ değeriniz ve DSÖ kategoriniz anında hesaplanır.",
    "Boyunuza göre sağlıklı kilo aralığını ve bu aralığa uzaklığınızı detaylarda inceleyin.",
    "Sonucu paylaşmak için Linki Kopyala düğmesini kullanın."
  ],
  sources: [
    { name: "Dünya Sağlık Örgütü – Obesity and overweight", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight" },
    { name: "DSÖ Küresel Sağlık Gözlemevi – Body mass index among adults", url: "https://www.who.int/data/gho/data/themes/topics/indicator-groups/indicator-group-details/GHO/bmi-among-adults" },
    { name: "T.C. Sağlık Bakanlığı HSGM – Yetişkin Beden Kitle İndeksi", url: "https://hsgm.saglik.gov.tr/tr/beslenmehareket-hesaplamalar/beslenmehareket-yetiskin-beden-kitle-indeksi.html" },
    { name: "T.C. Sağlık Bakanlığı HSGM – Obezite Nasıl Saptanır", url: "https://hsgm.saglik.gov.tr/tr/obezite/obezite-nasil-saptanir.html" }
  ],
  category: "saglik",
  slug: "vucut-kitle-indeksi",
  keywords: ["vücut kitle indeksi", "VKİ hesaplama", "BMI hesaplama", "kilo hesaplama", "ideal kilo", "obezite hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["saglik/ideal-kilo-hesaplama", "saglik/yag-orani-hesaplama", "saglik/kalori-hesaplama", "saglik/baz-metabolizma-hizi"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="boy"
      label="Boy"
      type="number"
      placeholder="172"
      suffix="cm"
      min={100}
      max={250}
      step={1}
      helpText="Santimetre cinsinden"
    />
    <CalcInput
      id="kilo"
      label="Kilo"
      type="number"
      placeholder="68,5"
      suffix="kg"
      min={20}
      max={350}
      step={0.1}
      helpText="Kilogram cinsinden"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Vücut Kitle İndeksi</p>
      <p class="calc-result-value" id="vki-deger">—</p>
      <p class="calc-result-sub" id="vki-kategori"></p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">DSÖ Kategorisi</span>
        <span class="calc-detail-value" id="sonuc-kategori">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Boyunuza göre sağlıklı kilo aralığı</span>
        <span class="calc-detail-value" id="sonuc-aralik">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Aralığa uzaklık</span>
        <span class="calc-detail-value" id="sonuc-fark">—</span>
      </div>
    </div>
  </CalcResult>

  <p class="calc-note">
    Bu hesaplayıcı 18 yaş ve üzeri yetişkinler için genel bilgi amaçlıdır; tıbbi tanı veya tedavi yerine geçmez. Gebelikte, çocuklarda ve kronik hastalığı olanlarda sonuçlar farklı yorumlanır. Kilo ve sağlık durumunuzla ilgili kararlar için hekiminize veya bir diyetisyene danışın.
  </p>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      function num(id: string) {
        const raw = (document.getElementById(id) as HTMLInputElement).value.replace(',', '.');
        return raw.trim() === '' ? NaN : parseFloat(raw);
      }

      function fmt(n: number, d = 1) {
        return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
      }

      function kategoriBul(vki: number) {
        if (vki < 16) return 'Zayıf (ileri derece)';
        if (vki < 17) return 'Zayıf (orta derece)';
        if (vki < 18.5) return 'Zayıf (hafif)';
        if (vki < 25) return 'Normal';
        if (vki < 30) return 'Fazla kilolu (obezite öncesi)';
        if (vki < 35) return 'Obez – 1. derece';
        if (vki < 40) return 'Obez – 2. derece';
        return 'Obez – 3. derece (morbid)';
      }

      function calculate() {
        const boy = num('boy');
        const kilo = num('kilo');

        if (!isFinite(boy) || !isFinite(kilo) || boy < 50 || boy > 272 || kilo <= 0 || kilo > 650) {
          resultArea?.classList.add('hidden');
          return;
        }

        const m = boy / 100;
        // Kategori sınırları 1 ondalıkla raporlanan değere göre uygulanır (24,96 → 25,0)
        const vki = Math.round((kilo / (m * m)) * 10) / 10;
        const kategori = kategoriBul(vki);
        const alt = 18.5 * m * m;
        const ust = 24.9 * m * m;

        $('vki-deger').textContent = fmt(vki, 1);
        $('vki-kategori').textContent = kategori;
        $('sonuc-kategori').textContent = kategori;
        $('sonuc-aralik').textContent = `${fmt(alt)} – ${fmt(ust)} kg`;

        if (kilo < alt) $('sonuc-fark').textContent = `Alt sınıra ${fmt(alt - kilo)} kg`;
        else if (kilo > ust) $('sonuc-fark').textContent = `Üst sınırın ${fmt(kilo - ust)} kg üzerinde`;
        else $('sonuc-fark').textContent = 'Sağlıklı aralıktasınız';

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (el.id && params.has(el.id)) { el.value = params.get(el.id) ?? ''; has = true; }
        });
        if (has) calculate();
      }

      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Vücut kitle indeksi neyi gösterir?</h2>
    <p>
      Vücut kitle indeksi (VKİ, İngilizce BMI), kilonuzun boyunuza göre makul bir aralıkta olup olmadığını gösteren hızlı bir tarama ölçüsüdür. Dünya Sağlık Örgütü ve Sağlık Bakanlığı toplum düzeyinde zayıflık ve obeziteyi tanımlamak için bu ölçüyü kullanır. VKİ bir tanı değildir; ancak kilo kaynaklı sağlık risklerini fark etmek için iyi bir başlangıç noktasıdır.
    </p>

    <h2>Formül</h2>
    <p><strong>VKİ = Kilo (kg) ÷ Boy² (m²)</strong></p>
    <p>
      Boy santimetre ise önce 100'e bölünerek metreye çevrilir. Sağlıklı kilo aralığını bulmak için formül tersine çevrilir: <strong>Kilo = VKİ × Boy²</strong>. Boyun karesi 18,5 ve 24,9 ile çarpıldığında boyunuza uygun alt ve üst kilo sınırı çıkar.
    </p>

    <h2>Örnek hesaplama</h2>
    <p>
      Boyu 165 cm, kilosu 78 kg olan bir yetişkin düşünelim. Boy metreye çevrilir: 1,65 m. Karesi 1,65 × 1,65 = 2,7225'tir. VKİ = 78 ÷ 2,7225 = 28,7. Bu değer 25–29,9 aralığında olduğu için "fazla kilolu" sınıfına girer.
    </p>
    <p>
      Aynı kişinin sağlıklı kilo aralığı 18,5 × 2,7225 = 50,4 kg ile 24,9 × 2,7225 = 67,8 kg arasıdır. Yani normal aralığın üst sınırına ulaşmak için yaklaşık 10,2 kg vermesi gerekir. Uzmanlar genellikle ilk hedef olarak mevcut kilonun %5–10'unun verilmesini önerir; bu örnekte 4–8 kg, sağlık göstergelerinde anlamlı iyileşme sağlar.
    </p>

    <h2>DSÖ VKİ sınıflandırma tablosu (yetişkin)</h2>
    <table>
      <thead>
        <tr><th>VKİ (kg/m²)</th><th>Sınıf</th><th>Sağlık riski</th></tr>
      </thead>
      <tbody>
        <tr><td>&lt; 16,0</td><td>Zayıf – ileri derece</td><td>Yüksek</td></tr>
        <tr><td>16,0 – 16,9</td><td>Zayıf – orta derece</td><td>Artmış</td></tr>
        <tr><td>17,0 – 18,4</td><td>Zayıf – hafif</td><td>Hafif artmış</td></tr>
        <tr><td>18,5 – 24,9</td><td>Normal</td><td>En düşük</td></tr>
        <tr><td>25,0 – 29,9</td><td>Fazla kilolu (obezite öncesi)</td><td>Artmış</td></tr>
        <tr><td>30,0 – 34,9</td><td>Obez – 1. derece</td><td>Yüksek</td></tr>
        <tr><td>35,0 – 39,9</td><td>Obez – 2. derece</td><td>Çok yüksek</td></tr>
        <tr><td>≥ 40,0</td><td>Obez – 3. derece (morbid)</td><td>Son derece yüksek</td></tr>
      </tbody>
    </table>

    <h2>Boya göre sağlıklı kilo aralığı</h2>
    <table>
      <thead>
        <tr><th>Boy</th><th>VKİ 18,5 (alt sınır)</th><th>VKİ 24,9 (üst sınır)</th></tr>
      </thead>
      <tbody>
        <tr><td>150 cm</td><td>41,6 kg</td><td>56,0 kg</td></tr>
        <tr><td>155 cm</td><td>44,4 kg</td><td>59,8 kg</td></tr>
        <tr><td>160 cm</td><td>47,4 kg</td><td>63,7 kg</td></tr>
        <tr><td>165 cm</td><td>50,4 kg</td><td>67,8 kg</td></tr>
        <tr><td>170 cm</td><td>53,5 kg</td><td>72,0 kg</td></tr>
        <tr><td>175 cm</td><td>56,7 kg</td><td>76,3 kg</td></tr>
        <tr><td>180 cm</td><td>59,9 kg</td><td>80,7 kg</td></tr>
        <tr><td>185 cm</td><td>63,3 kg</td><td>85,2 kg</td></tr>
        <tr><td>190 cm</td><td>66,8 kg</td><td>89,9 kg</td></tr>
      </tbody>
    </table>

    <h2>VKİ'nin sınırlılıkları</h2>
    <ul>
      <li><strong>Kas ile yağı ayırt etmez:</strong> Sporcularda yüksek kas kütlesi VKİ'yi olduğundan yüksek gösterebilir.</li>
      <li><strong>Yağın dağılımını göstermez:</strong> Karın bölgesinde biriken yağ, kalp-damar hastalıkları ve tip 2 diyabetle daha güçlü ilişkilidir. Bel çevresi erkekte 94 cm, kadında 80 cm'yi aştığında risk artar; erkekte 102 cm, kadında 88 cm üzeri belirgin risk kabul edilir.</li>
      <li><strong>Yaşlılarda yanıltabilir:</strong> Yaşla kas kütlesi azaldığı için normal VKİ, yüksek yağ oranını gizleyebilir.</li>
      <li><strong>Gebelikte ve çocuklarda kullanılmaz:</strong> Gebelikte kilo artışı ayrı kriterlerle izlenir; 5–19 yaşta VKİ yaşa ve cinsiyete özgü persentil eğrileriyle değerlendirilir.</li>
    </ul>

    <h3>VKİ'nizi değerlendirirken</h3>
    <p>
      VKİ'niz normal aralığın dışındaysa bunu tek başına alarm işareti olarak değil, bel çevresi, tansiyon, kan şekeri ve kolesterol gibi ölçümlerle birlikte değerlendirilmesi gereken bir veri olarak görün. Daha ayrıntılı bir resim için <a href="/saglik/yag-orani-hesaplama/">vücut yağ oranı</a> ve <a href="/saglik/kalori-hesaplama/">günlük kalori ihtiyacı</a> hesaplayıcılarını da kullanabilirsiniz.
    </p>
  </section>
</CalcLayout>
