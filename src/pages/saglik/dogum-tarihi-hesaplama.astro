---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Tahmini doğum tarihi nasıl hesaplanır?",
    answer: "En yaygın yöntem Naegele kuralıdır: son adet tarihinin (SAT) ilk gününe 280 gün (40 hafta) eklenir. Pratik yolu, SAT'a 7 gün ekleyip 3 ay geri gitmek ve yılı bir artırmaktır. Örneğin SAT 1 Mart 2026 ise 280 gün sonrası 6 Aralık 2026'dır; kısa yol ay uzunlukları nedeniyle 8 Aralık verir. Döngünüz 28 günden farklıysa aradaki fark tarihe eklenir veya çıkarılır."
  },
  {
    question: "Bebek tam tahmini doğum tarihinde mi doğar?",
    answer: "Çoğunlukla hayır. Bebeklerin yalnızca yaklaşık %4–5'i tam tahmini tarihte doğar. 37 hafta 0 gün ile 41 hafta 6 gün arasındaki doğumlar 'miadında' kabul edilir; ACOG bu aralığı erken miat (37–38+6), tam miat (39–40+6) ve geç miat (41–41+6) olarak ayırır. Tahmini tarih, gebelik takibinde referans alınan bir orta noktadır."
  },
  {
    question: "Döllenme tarihinden doğum tarihi nasıl hesaplanır?",
    answer: "Döllenme (ilişki veya yumurtlama) tarihini kesin biliyorsanız bu tarihe 266 gün (38 hafta) eklenir. Bu, 28 günlük döngüde SAT + 280 gün ile aynı sonucu verir; çünkü yumurtlama SAT'tan yaklaşık 14 gün sonra olur. Hesaplayıcıda yöntem olarak 'Döllenme tarihi'ni seçerek bu hesabı yapabilirsiniz."
  },
  {
    question: "Tüp bebek (IVF) gebeliğinde doğum tarihi nasıl hesaplanır?",
    answer: "ACOG'a göre IVF gebeliklerinde tarih embriyonun yaşı ve transfer günü ile belirlenir. 5 günlük embriyo (blastokist) transferinde transfer tarihine 261 gün, 3 günlük embriyo transferinde 263 gün eklenir. Bu yöntem SAT'a dayalı hesaptan daha kesindir; hesaplayıcıda ilgili IVF seçeneğini kullanabilirsiniz."
  },
  {
    question: "Ultrason doğum tarihimi değiştirebilir mi?",
    answer: "Evet. İlk trimesterde (13 hafta 6 gün ve öncesi) yapılan baş-popo mesafesi ölçümü tarihlendirmede en doğru yöntemdir. ACOG'a göre bu dönemde ultrason ile SAT'a göre hesap arasındaki fark 9. haftadan önce 5 günden, 9–13+6 hafta arasında 7 günden fazlaysa tahmini doğum tarihi ultrasona göre güncellenir."
  },
  {
    question: "40 hafta geçerse ne olur?",
    answer: "Tahmini tarihin geçmesi sık görülür ve tek başına sorun değildir. 41. haftadan itibaren hekimler bebeğin iyilik halini daha sık izler; 41–42. haftalarda doğumun başlatılması (indüksiyon) önerilebilir. 42 haftayı aşan gebelikler 'miadı geçmiş' kabul edilir. Bebek hareketlerinde azalma fark ederseniz beklemeden hastaneye başvurun."
  }
];

const meta = {
  title: "Tahmini Doğum Tarihi Hesaplama",
  seoTitle: "Doğum Tarihi Hesaplama 2026 – Tahmini Doğum Tarihi",
  description: "Son adet tarihi, döllenme tarihi veya tüp bebek transfer tarihine göre tahmini doğum tarihinizi hesaplayın. Gebelik haftanızı ve miat aralığını görün.",
  summary: "Tahmini doğum tarihi, Naegele kuralına göre son adet tarihinin ilk gününe 280 gün (40 hafta) eklenerek bulunur. Döllenme tarihi biliniyorsa 266 gün, 5 günlük IVF transferinde 261 gün, 3 günlük transferde 263 gün eklenir. Doğumların çoğu 37+0 ile 41+6 hafta arasında gerçekleşir.",
  howTo: [
    "Hesaplama yöntemini seçin: son adet tarihi, döllenme tarihi veya IVF transfer tarihi.",
    "İlgili tarihi girin.",
    "Son adet tarihi yönteminde döngünüz 28 günden farklıysa ortalama döngü sürenizi yazın.",
    "Tahmini doğum tarihinizi, gebelik haftanızı ve miadında doğum aralığını görün."
  ],
  sources: [
    { name: "ACOG Committee Opinion No. 700 – Methods for Estimating the Due Date", url: "https://www.acog.org/clinical/clinical-guidance/committee-opinion/articles/2017/05/methods-for-estimating-the-due-date" },
    { name: "ACOG – Methods for Estimating the Due Date (PDF)", url: "https://www.acog.org/-/media/project/acog/acogorg/clinical/files/committee-opinion/articles/2017/05/methods-for-estimating-the-due-date.pdf" }
  ],
  category: "saglik",
  slug: "dogum-tarihi-hesaplama",
  keywords: ["tahmini doğum tarihi", "doğum tarihi hesaplama", "Naegele kuralı", "ne zaman doğuracağım", "tüp bebek doğum tarihi", "son adet tarihi"],
  dateModified: "2026-09-26",
  relatedCalcs: ["saglik/gebelik-haftasi-hesaplama", "saglik/su-ihtiyaci-hesaplama", "saglik/kalori-hesaplama", "gunluk/gun-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="yontem"
      label="Hesaplama Yöntemi"
      options={[
        { value: "sat", label: "Son adet tarihi (SAT)" },
        { value: "dollenme", label: "Döllenme / yumurtlama tarihi" },
        { value: "ivf5", label: "Tüp bebek – 5 günlük embriyo transferi" },
        { value: "ivf3", label: "Tüp bebek – 3 günlük embriyo transferi" }
      ]}
      value="sat"
    />
    <CalcInput
      id="sonAdetTarihi"
      label="Tarih"
      type="date"
      helpText="SAT için adetin başladığı ilk gün"
    />
    <CalcInput
      id="dongu"
      label="Ortalama Döngü Süresi"
      type="number"
      suffix="gün"
      placeholder="28"
      min={20}
      max={45}
      step={1}
      required={false}
      helpText="Yalnızca SAT yönteminde; boşsa 28 gün"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Tahmini Doğum Tarihi</p>
      <p class="calc-result-value" id="dogum-tarihi">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Bugünkü gebelik yaşı</span>
        <span class="calc-detail-value" id="d-hafta">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Trimester</span>
        <span class="calc-detail-value" id="d-trimester">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Doğuma kalan</span>
        <span class="calc-detail-value" id="d-kalan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Miadında doğum aralığı (37+0 – 41+6)</span>
        <span class="calc-detail-value" id="d-miat">—</span>
      </div>
    </div>
  </CalcResult>

  <p class="calc-note">
    Hesaplanan tarih bir tahmindir; tıbbi muayene ve ultrason değerlendirmesinin yerini tutmaz. Hekiminiz erken ultrasona göre farklı bir tarih belirlediyse onu esas alın. Kanama, sıvı gelmesi, düzenli kasılmalar veya bebek hareketlerinde azalma olursa hemen sağlık kuruluşuna başvurun.
  </p>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;
      const yontemEl = document.getElementById('yontem') as HTMLSelectElement;
      const tarihEl = document.getElementById('sonAdetTarihi') as HTMLInputElement;
      const donguGroup = document.getElementById('dongu')?.closest('.calc-input-group');
      const tarihLabel = document.querySelector('label[for="sonAdetTarihi"]');

      // Seçilen tarihten "SAT eşdeğeri"ne gün farkı (ACOG CO 700)
      const YONTEM: Record<string, { fark: number; etiket: string }> = {
        sat: { fark: 0, etiket: 'Son Adet Tarihi (ilk gün)' },
        dollenme: { fark: -14, etiket: 'Döllenme / Yumurtlama Tarihi' },
        ivf5: { fark: -19, etiket: 'Embriyo Transfer Tarihi (5. gün)' },
        ivf3: { fark: -17, etiket: 'Embriyo Transfer Tarihi (3. gün)' }
      };

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      // "YYYY-MM-DD" değerini yerel saatle çözer; toISOString/UTC kullanılmaz
      function parseLocalDate(s: string): Date | null {
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
        if (!m) return null;
        const y = +m[1], mo = +m[2] - 1, d = +m[3];
        const date = new Date(y, mo, d);
        return date.getFullYear() === y && date.getMonth() === mo && date.getDate() === d ? date : null;
      }

      function addDays(d: Date, n: number) {
        return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
      }

      function diffDays(a: Date, b: Date) {
        return Math.round((Date.UTC(b.getFullYear(), b.getMonth(), b.getDate()) - Date.UTC(a.getFullYear(), a.getMonth(), a.getDate())) / 86400000);
      }

      function formatDate(d: Date, gunAdi = false) {
        return new Intl.DateTimeFormat('tr-TR', gunAdi
          ? { day: 'numeric', month: 'long', year: 'numeric', weekday: 'long' }
          : { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
      }

      function yontemGuncelle() {
        const y = YONTEM[yontemEl.value] ?? YONTEM.sat;
        if (tarihLabel) tarihLabel.textContent = y.etiket;
        donguGroup?.classList.toggle('hidden', yontemEl.value !== 'sat');
      }

      function calculate() {
        const secilen = parseLocalDate(tarihEl.value);
        const y = YONTEM[yontemEl.value] ?? YONTEM.sat;

        if (!secilen) {
          resultArea?.classList.add('hidden');
          return;
        }

        let fark = y.fark;
        if (yontemEl.value === 'sat') {
          const d = parseInt((document.getElementById('dongu') as HTMLInputElement).value, 10);
          if (isFinite(d) && d >= 20 && d <= 45) fark = d - 28;
        }

        // SAT eşdeğeri: gebelik yaşının 0. günü
        const sat0 = addDays(secilen, fark);
        const dogum = addDays(sat0, 280);
        const now = new Date();
        const bugun = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const gecen = diffDays(sat0, bugun);
        const kalan = diffDays(bugun, dogum);

        $('dogum-tarihi').textContent = formatDate(dogum, true);
        $('d-miat').textContent = `${formatDate(addDays(sat0, 259))} – ${formatDate(addDays(sat0, 293))}`;

        if (diffDays(secilen, bugun) < 0) {
          $('d-hafta').textContent = 'Seçilen tarih ileri bir tarih';
          $('d-trimester').textContent = '—';
        } else if (gecen > 44 * 7) {
          $('d-hafta').textContent = '44 haftadan fazla – tarihi kontrol edin';
          $('d-trimester').textContent = '—';
        } else {
          const g = Math.max(0, gecen);
          $('d-hafta').textContent = `${Math.floor(g / 7)} hafta ${g % 7} gün (${Math.floor(g / 7) + 1}. hafta)`;
          $('d-trimester').textContent = g < 98 ? '1. trimester' : g < 196 ? '2. trimester' : '3. trimester';
        }

        $('d-kalan').textContent = kalan > 0 ? `${kalan} gün` : kalan === 0 ? 'Bugün' : `${-kalan} gün geçti`;

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (!el.id || !params.has(el.id)) return;
          const v = params.get(el.id) ?? '';
          if (el instanceof HTMLSelectElement && !Array.from(el.options).some(o => o.value === v)) return;
          el.value = v;
          has = true;
        });
        yontemGuncelle();
        if (has) calculate();
      }

      yontemEl.addEventListener('change', yontemGuncelle);
      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Tahmini doğum tarihi nasıl bulunur?</h2>
    <p>
      Tahmini doğum tarihi (TDT), gebeliğin 40. haftasının tamamlandığı gündür. Hesaplamanın başlangıç noktası çoğunlukla son adet tarihinin (SAT) ilk günüdür, çünkü döllenme tarihi genellikle kesin bilinmez. Tüp bebek gebeliklerinde ise embriyonun yaşı ve transfer günü bilindiğinden tarih çok daha kesin hesaplanır.
    </p>

    <h2>Yöntemlere göre formüller</h2>
    <table>
      <thead>
        <tr><th>Başlangıç tarihi</th><th>Eklenecek süre</th></tr>
      </thead>
      <tbody>
        <tr><td>Son adet tarihi (28 günlük döngü)</td><td>280 gün (40 hafta)</td></tr>
        <tr><td>Son adet tarihi (farklı döngü)</td><td>280 gün + (döngü süresi − 28)</td></tr>
        <tr><td>Döllenme / yumurtlama tarihi</td><td>266 gün (38 hafta)</td></tr>
        <tr><td>IVF – 5 günlük embriyo transferi</td><td>261 gün</td></tr>
        <tr><td>IVF – 3 günlük embriyo transferi</td><td>263 gün</td></tr>
      </tbody>
    </table>
    <p>
      Naegele kuralının pratik hali şöyledir: SAT'a 7 gün ekleyin, 3 ay geri gidin, yılı bir artırın. Bu kısa yol ayların farklı uzunlukları nedeniyle 280 gün eklemekten 1–3 gün sapabilir; hesaplayıcı her zaman tam 280 günü ekler.
    </p>

    <h2>Örnek hesaplama</h2>
    <p>
      Son adetinin ilk günü 1 Mart 2026 olan ve 28 günlük düzenli döngüsü olan biri için: 1 Mart 2026 + 280 gün = <strong>6 Aralık 2026</strong>. Miadında doğum aralığı (37+0 – 41+6 hafta) 15 Kasım 2026 ile 19 Aralık 2026 arasıdır.
    </p>
    <p>
      Aynı kişinin döngüsü 31 gün olsaydı yumurtlama yaklaşık 3 gün geç olacağı için tahmini doğum tarihi 9 Aralık 2026'ya kayardı. 5 günlük embriyo transferi 10 Nisan 2026'da yapılan bir tüp bebek gebeliğinde ise TDT, 10 Nisan + 261 gün = 27 Aralık 2026 olur.
    </p>

    <h2>Miat kavramları</h2>
    <table>
      <thead>
        <tr><th>Tanım</th><th>Gebelik haftası</th></tr>
      </thead>
      <tbody>
        <tr><td>Erken doğum (preterm)</td><td>37+0 haftadan önce</td></tr>
        <tr><td>Erken miat</td><td>37+0 – 38+6</td></tr>
        <tr><td>Tam miat</td><td>39+0 – 40+6</td></tr>
        <tr><td>Geç miat</td><td>41+0 – 41+6</td></tr>
        <tr><td>Miadı geçmiş (postterm)</td><td>42+0 ve sonrası</td></tr>
      </tbody>
    </table>

    <h2>Tarih neden değişebilir?</h2>
    <p>
      İlk trimester ultrasonunda ölçülen baş-popo mesafesi, gebelik yaşını belirlemenin en güvenilir yoludur. SAT'a göre hesap ile ultrason arasında belirgin fark varsa hekiminiz tahmini doğum tarihinizi ultrasona göre günceller ve takibin geri kalanında bu tarih kullanılır. Bugün kaçıncı haftada olduğunuzu ayrıntılı görmek için <a href="/saglik/gebelik-haftasi-hesaplama/">gebelik haftası hesaplama</a> aracını kullanabilirsiniz.
    </p>
  </section>
</CalcLayout>
