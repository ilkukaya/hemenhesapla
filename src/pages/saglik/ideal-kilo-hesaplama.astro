---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Boyuma göre ideal kilom kaç olmalı?",
    answer: "Tek bir 'ideal' kilo yoktur; sağlıklı bir aralık vardır. Dünya Sağlık Örgütü'nün VKİ 18,5–24,9 aralığına göre 170 cm boyundaki biri için sağlıklı kilo yaklaşık 53,5–72 kg'dır. Devine, Robinson ve Miller gibi formüller bu aralık içinde tek bir referans değer verir; örneğin 170 cm erkek için Devine formülü yaklaşık 65,9 kg sonuç üretir."
  },
  {
    question: "İdeal kilo formülleri nelerdir?",
    answer: "En bilinenleri Devine (1974), Robinson (1983), Miller (1983) ve Hamwi (1964) formülleridir. Hepsi 152,4 cm (5 feet) için bir taban kilo belirler ve bunun üzerindeki her 2,54 cm (1 inç) için sabit bir miktar ekler. Örneğin Devine formülü erkekte 50 kg + inç başına 2,3 kg, kadında 45,5 kg + inç başına 2,3 kg'dır."
  },
  {
    question: "Kadın ve erkek için ideal kilo farklı mıdır?",
    answer: "Formüllerde evet. Aynı boyda kadınların taban değeri daha düşüktür çünkü ortalama kas ve kemik kütlesi daha azdır. Örneğin 165 cm için Devine formülü erkekte yaklaşık 61,4 kg, kadında 56,9 kg verir. VKİ'ye dayalı sağlıklı kilo aralığı ise iki cinsiyet için aynıdır."
  },
  {
    question: "İdeal kilo formülleri kısa boylularda doğru mu?",
    answer: "Formüller 152,4 cm üzerindeki boylar için geliştirilmiştir. Daha kısa boylarda aynı katsayı geriye doğru uygulandığında sonuçlar gerçekçi olmayacak kadar düşük çıkabilir. 152 cm altındaysanız formül sonuçları yerine VKİ'ye dayalı sağlıklı kilo aralığını esas almanız daha doğrudur. Hesaplayıcı bu durumda sizi ayrıca uyarır."
  },
  {
    question: "Devine formülü neden hâlâ kullanılıyor?",
    answer: "Devine formülü 1974'te bazı ilaçların dozunu hesaplamak için önerilmiştir ve bugün de hastanelerde ideal vücut ağırlığına göre ilaç dozlama ile ventilatör ayarlarında referans olarak kullanılır. Yani estetik ya da diyet hedefi olarak değil, klinik bir referans değer olarak geliştirilmiştir. Bu yüzden kişisel hedef belirlerken VKİ aralığıyla birlikte değerlendirilmelidir."
  },
  {
    question: "İdeal kiloya ulaşmak için ne yapmalıyım?",
    answer: "Hedefinize göre günlük kalori ihtiyacınızı hesaplayıp 300–500 kcal açıkla veya fazlalıkla beslenmek, yeterli protein almak ve haftada en az 150 dakika orta yoğunlukta fiziksel aktivite yapmak temel adımlardır. Haftada 0,5–1 kg'dan hızlı kilo değişimi genellikle sürdürülebilir değildir; kronik hastalığınız varsa hekiminize danışın."
  }
];

const meta = {
  title: "İdeal Kilo Hesaplama",
  seoTitle: "İdeal Kilo Hesaplama 2026 – Boya Göre İdeal Kilo",
  description: "Boyunuza ve cinsiyetinize göre ideal kilonuzu Devine, Robinson, Miller ve Hamwi formülleriyle hesaplayın. DSÖ'ye göre sağlıklı kilo aralığınızı da görün.",
  summary: "İdeal kilo tek bir sayı değil, bir aralıktır: DSÖ'ye göre sağlıklı kilo, boyun metre karesinin 18,5 ile 24,9 ile çarpılmasıyla bulunur (170 cm için 53,5–72 kg). Devine formülü erkekte 50 kg, kadında 45,5 kg'a 152,4 cm üzerindeki her 2,54 cm için 2,3 kg ekler.",
  howTo: [
    "Cinsiyetinizi seçin.",
    "Boyunuzu santimetre cinsinden girin (örneğin 168).",
    "Dört formülün ortalamasını ve her formülün sonucunu inceleyin.",
    "VKİ'ye dayalı sağlıklı kilo aralığını hedef aralığınız olarak kullanın."
  ],
  sources: [
    { name: "Pai MP, Paloucek FP (2000), Ann Pharmacother – The origin of the 'ideal' body weight equations", url: "https://pubmed.ncbi.nlm.nih.gov/10981254/" },
    { name: "Dünya Sağlık Örgütü – Obesity and overweight", url: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight" },
    { name: "T.C. Sağlık Bakanlığı HSGM – Yetişkin Beden Kitle İndeksi", url: "https://hsgm.saglik.gov.tr/tr/beslenmehareket-hesaplamalar/beslenmehareket-yetiskin-beden-kitle-indeksi.html" }
  ],
  category: "saglik",
  slug: "ideal-kilo-hesaplama",
  keywords: ["ideal kilo hesaplama", "boya göre ideal kilo", "ideal kilo formülü", "Devine formülü", "sağlıklı kilo aralığı", "kaç kilo olmalıyım"],
  dateModified: "2026-09-26",
  relatedCalcs: ["saglik/vucut-kitle-indeksi", "saglik/kalori-hesaplama", "saglik/yag-orani-hesaplama", "saglik/baz-metabolizma-hizi"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="cinsiyet"
      label="Cinsiyet"
      options={[
        { value: "erkek", label: "Erkek" },
        { value: "kadin", label: "Kadın" }
      ]}
      value="erkek"
    />
    <CalcInput
      id="boy"
      label="Boy"
      type="number"
      suffix="cm"
      placeholder="168"
      min={120}
      max={230}
      step={1}
      helpText="Santimetre cinsinden"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">İdeal Kilo (4 formülün ortalaması)</p>
      <p class="calc-result-value" id="ideal-ort">—</p>
      <p class="calc-result-sub" id="saglikli-aralik"></p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Devine (1974)</span>
        <span class="calc-detail-value" id="devine">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Robinson (1983)</span>
        <span class="calc-detail-value" id="robinson">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Miller (1983)</span>
        <span class="calc-detail-value" id="miller">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Hamwi (1964)</span>
        <span class="calc-detail-value" id="hamwi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Sağlıklı aralık (VKİ 18,5–24,9)</span>
        <span class="calc-detail-value" id="vki-aralik">—</span>
      </div>
      <p class="calc-note hidden" id="kisa-boy-uyari">Formüller 152,4 cm ve üzeri boylar için geliştirilmiştir; bu boyda formül sonuçları yerine VKİ'ye dayalı sağlıklı aralığı esas alın.</p>
    </div>
  </CalcResult>

  <p class="calc-note">
    İdeal kilo formülleri kas oranını, kemik yapısını ve yaşı dikkate almaz; sonuçlar genel bir referanstır, kişisel hedef değildir. Gebelikte, 18 yaş altında ve kronik hastalıklarda kilo hedefinizi hekiminiz veya diyetisyeninizle belirleyin.
  </p>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      function num(id: string) {
        const raw = (document.getElementById(id) as HTMLInputElement).value.replace(',', '.');
        return raw.trim() === '' ? NaN : parseFloat(raw);
      }

      function kg(n: number) {
        return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(n) + ' kg';
      }

      function calculate() {
        const cinsiyet = (document.getElementById('cinsiyet') as HTMLSelectElement).value;
        const boy = num('boy');

        if (!isFinite(boy) || boy < 100 || boy > 260) {
          resultArea?.classList.add('hidden');
          return;
        }

        // 152,4 cm (60 inç) üzerindeki her inç (2,54 cm) için ekleme
        const inc = boy / 2.54 - 60;
        const erkek = cinsiyet === 'erkek';

        const devine = (erkek ? 50 : 45.5) + 2.3 * inc;
        const robinson = erkek ? 52 + 1.9 * inc : 49 + 1.7 * inc;
        const miller = erkek ? 56.2 + 1.41 * inc : 53.1 + 1.36 * inc;
        const hamwi = erkek ? 48 + 2.7 * inc : 45.5 + 2.2 * inc;
        const ortalama = (devine + robinson + miller + hamwi) / 4;

        const m2 = (boy / 100) ** 2;
        const aralik = `${kg(18.5 * m2)} – ${kg(24.9 * m2)}`;

        $('ideal-ort').textContent = kg(ortalama);
        $('saglikli-aralik').textContent = `Sağlıklı aralık: ${aralik}`;
        $('devine').textContent = kg(devine);
        $('robinson').textContent = kg(robinson);
        $('miller').textContent = kg(miller);
        $('hamwi').textContent = kg(hamwi);
        $('vki-aralik').textContent = aralik;
        $('kisa-boy-uyari').classList.toggle('hidden', boy >= 152.4);

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (el.id && params.has(el.id)) { el.value = params.get(el.id) ?? ''; has = true; }
        });
        if (has) calculate();
      }

      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>İdeal kilo nasıl hesaplanır?</h2>
    <p>
      "İdeal kilo" için iki yaklaşım kullanılır. Birincisi, Dünya Sağlık Örgütü'nün vücut kitle indeksi sınırlarından türetilen <strong>sağlıklı kilo aralığıdır</strong>: boyunuzun metre cinsinden karesi 18,5 ve 24,9 ile çarpılır. İkincisi ise klinikte ilaç dozlama gibi amaçlarla geliştirilmiş <strong>ideal vücut ağırlığı formülleridir</strong>. Bu formüller tek bir referans değer verir ve neredeyse her zaman sağlıklı aralığın içinde kalır.
    </p>

    <h2>Formüller</h2>
    <p>Tüm formüllerde boy inç cinsine çevrilir (cm ÷ 2,54) ve 60 inç (152,4 cm) üzerindeki her inç için sabit bir miktar eklenir.</p>
    <table>
      <thead>
        <tr><th>Formül</th><th>Erkek</th><th>Kadın</th></tr>
      </thead>
      <tbody>
        <tr><td>Devine (1974)</td><td>50 kg + 2,3 kg × inç</td><td>45,5 kg + 2,3 kg × inç</td></tr>
        <tr><td>Robinson (1983)</td><td>52 kg + 1,9 kg × inç</td><td>49 kg + 1,7 kg × inç</td></tr>
        <tr><td>Miller (1983)</td><td>56,2 kg + 1,41 kg × inç</td><td>53,1 kg + 1,36 kg × inç</td></tr>
        <tr><td>Hamwi (1964)</td><td>48 kg + 2,7 kg × inç</td><td>45,5 kg + 2,2 kg × inç</td></tr>
      </tbody>
    </table>

    <h2>Örnek hesaplama</h2>
    <p>
      Boyu 168 cm olan bir kadın için: 168 ÷ 2,54 = 66,14 inç. 60 inçin üzerindeki kısım 6,14 inçtir.
    </p>
    <ul>
      <li>Devine: 45,5 + 2,3 × 6,14 = 59,6 kg</li>
      <li>Robinson: 49 + 1,7 × 6,14 = 59,4 kg</li>
      <li>Miller: 53,1 + 1,36 × 6,14 = 61,5 kg</li>
      <li>Hamwi: 45,5 + 2,2 × 6,14 = 59,0 kg</li>
      <li>Ortalama: yaklaşık <strong>59,9 kg</strong></li>
    </ul>
    <p>
      Aynı kişinin VKİ'ye dayalı sağlıklı kilo aralığı 1,68² × 18,5 = 52,2 kg ile 1,68² × 24,9 = 70,3 kg arasıdır. Yani 52–70 kg arasındaki her kilo sağlıklı kabul edilir; formül sonuçları bu aralığın ortasına yakın bir referans verir.
    </p>

    <h2>Boya göre ideal kilo tablosu (Devine)</h2>
    <table>
      <thead>
        <tr><th>Boy</th><th>Erkek</th><th>Kadın</th><th>Sağlıklı aralık (VKİ)</th></tr>
      </thead>
      <tbody>
        <tr><td>155 cm</td><td>52,4 kg</td><td>47,9 kg</td><td>44,4 – 59,8 kg</td></tr>
        <tr><td>160 cm</td><td>56,9 kg</td><td>52,4 kg</td><td>47,4 – 63,7 kg</td></tr>
        <tr><td>165 cm</td><td>61,4 kg</td><td>56,9 kg</td><td>50,4 – 67,8 kg</td></tr>
        <tr><td>170 cm</td><td>65,9 kg</td><td>61,4 kg</td><td>53,5 – 72,0 kg</td></tr>
        <tr><td>175 cm</td><td>70,5 kg</td><td>66,0 kg</td><td>56,7 – 76,3 kg</td></tr>
        <tr><td>180 cm</td><td>75,0 kg</td><td>70,5 kg</td><td>59,9 – 80,7 kg</td></tr>
        <tr><td>185 cm</td><td>79,5 kg</td><td>75,0 kg</td><td>63,3 – 85,2 kg</td></tr>
        <tr><td>190 cm</td><td>84,0 kg</td><td>79,5 kg</td><td>66,8 – 89,9 kg</td></tr>
      </tbody>
    </table>

    <h2>Formüllerin sınırları</h2>
    <ul>
      <li>Formüller kas kütlesini ve kemik yapısını hesaba katmaz; kaslı biri formül sonucunun üzerinde olup yine de sağlıklı olabilir.</li>
      <li>152,4 cm altındaki boylar için geliştirilmemiştir; bu boylarda sonuç gerçekçi olmayacak kadar düşük çıkabilir.</li>
      <li>Yaşlılarda biraz daha yüksek kilonun (VKİ 23–27 civarı) daha iyi sağlık sonuçlarıyla ilişkili olduğunu gösteren çalışmalar vardır.</li>
    </ul>
    <p>
      Mevcut durumunuzu görmek için <a href="/saglik/vucut-kitle-indeksi/">vücut kitle indeksi</a>, hedefinize ulaşmak için gereken enerji için <a href="/saglik/kalori-hesaplama/">kalori hesaplama</a> aracını kullanabilirsiniz.
    </p>
  </section>
</CalcLayout>
