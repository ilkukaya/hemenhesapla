---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Günlük protein ihtiyacı nasıl hesaplanır?",
    answer: "Protein ihtiyacı vücut ağırlığı ile kilogram başına gereken miktarın çarpılmasıyla bulunur. Sağlıklı, hareketsiz yetişkinler için DSÖ/FAO referansı 0,8 g/kg'dır; 70 kg biri için bu 56 g eder. Düzenli egzersiz yapanlar için Uluslararası Spor Beslenmesi Derneği (ISSN) 1,4–2,0 g/kg önerir. Hesaplayıcı seçtiğiniz hedefe göre bir aralık verir."
  },
  {
    question: "Kas yapmak için günde kaç gram protein almalıyım?",
    answer: "Direnç antrenmanı yapanlarda kas kazanımı için günde kilo başına 1,6–2,0 g protein yeterlidir; 1,6 g/kg'ın üzerindeki alımların ek faydası çalışmalarda giderek azalır. 75 kg bir kişi için bu günde yaklaşık 120–150 g demektir. Proteini günde 3–5 öğüne, her öğünde kilo başına yaklaşık 0,4 g olacak şekilde dağıtmak kas protein sentezini destekler."
  },
  {
    question: "Kilo verirken protein ihtiyacı artar mı?",
    answer: "Evet. Kalori açığında vücut kas dokusunu da enerji için kullanmaya başlar. Direnç antrenmanıyla birlikte kilo başına 1,6–2,2 g protein almak kas kaybını azaltır ve tokluk hissini artırır. Fazla kilolu kişilerde hesaplamayı mevcut kilo yerine hedef kilo veya ideal kilo üzerinden yapmak, gereğinden yüksek sonuçları önler."
  },
  {
    question: "Yaşlılarda protein ihtiyacı farklı mı?",
    answer: "Yaşla birlikte kas proteinini yapma verimliliği azalır. Bu nedenle uzman grupları 65 yaş üstü sağlıklı bireyler için kilo başına günde 1,0–1,2 g, akut veya kronik hastalığı olanlar için 1,2–1,5 g protein önermektedir. Böbrek fonksiyonu azalmış yaşlılarda miktar mutlaka hekimle belirlenmelidir."
  },
  {
    question: "Fazla protein böbreklere zarar verir mi?",
    answer: "Böbrek fonksiyonu normal olan sağlıklı kişilerde 2,0 g/kg civarına kadar olan alımların böbreğe zarar verdiğine dair güçlü bir kanıt yoktur. Ancak kronik böbrek hastalığı, diyabetik böbrek hasarı veya tek böbreği olanlarda yüksek protein hastalığın ilerlemesini hızlandırabilir. Bu durumdaysanız protein miktarını nefroloğunuz veya diyetisyeninizle belirleyin."
  },
  {
    question: "Hangi besinlerde ne kadar protein var?",
    answer: "Yaklaşık değerler: 100 g pişmiş tavuk göğsü 30 g, 100 g pişmiş kırmızı et 26 g, 1 yumurta 6 g, 200 g süzme yoğurt 18–20 g, 100 g beyaz peynir 15–17 g, 1 su bardağı pişmiş mercimek 17–18 g, 100 g ton balığı 25 g. Hayvansal ve bitkisel kaynakları birlikte tüketmek amino asit dengesini iyileştirir."
  }
];

const meta = {
  title: "Protein İhtiyacı Hesaplama",
  seoTitle: "Günlük Protein İhtiyacı Hesaplama 2026 – Kaç Gram?",
  description: "Kilonuza ve hedefinize göre günlük protein ihtiyacınızı gram olarak hesaplayın. Spor, kas yapma, kilo verme ve 65 yaş üstü için öğün başı miktarı görün.",
  summary: "Günlük protein ihtiyacı, kilonun g/kg değeriyle çarpılmasıyla bulunur. Hareketsiz yetişkinler için referans 0,8 g/kg (70 kg için 56 g), düzenli egzersiz yapanlar için 1,4–2,0 g/kg, kilo verirken kas korumak için 1,6–2,2 g/kg, 65 yaş üstü için 1,0–1,2 g/kg önerilir.",
  howTo: [
    "Vücut ağırlığınızı kilogram cinsinden girin.",
    "Aktivite düzeyinize veya hedefinize en uygun seçeneği işaretleyin.",
    "Günde kaç öğün yediğinizi seçin.",
    "Günlük protein aralığınızı ve öğün başına düşen miktarı sonuçta görün."
  ],
  sources: [
    { name: "DSÖ/FAO/UNU (2007) – Protein and amino acid requirements in human nutrition (TRS 935)", url: "https://www.who.int/publications/i/item/9789241209359" },
    { name: "Jäger R ve ark. (2017), ISSN Position Stand: protein and exercise", url: "https://pubmed.ncbi.nlm.nih.gov/28642676/" }
  ],
  category: "saglik",
  slug: "protein-ihtiyaci-hesaplama",
  keywords: ["protein ihtiyacı hesaplama", "günlük protein ihtiyacı", "kaç gram protein", "kas yapmak için protein", "sporcu protein ihtiyacı", "kilo başına protein"],
  dateModified: "2026-09-26",
  relatedCalcs: ["saglik/kalori-hesaplama", "saglik/baz-metabolizma-hizi", "saglik/yag-orani-hesaplama", "saglik/ideal-kilo-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="kilo"
      label="Vücut Ağırlığı"
      type="number"
      suffix="kg"
      placeholder="75"
      min={30}
      max={300}
      step={0.1}
      helpText="Fazla kiloluysanız hedef kilonuzu girebilirsiniz"
    />
    <CalcSelect
      id="aktivite"
      label="Aktivite / Hedef"
      options={[
        { value: "sedanter", label: "Hareketsiz yetişkin (0,8–1,0 g/kg)" },
        { value: "yasli", label: "65 yaş üstü (1,0–1,2 g/kg)" },
        { value: "hafif", label: "Hafif aktif, haftada 1-3 gün (1,0–1,2 g/kg)" },
        { value: "dayaniklilik", label: "Düzenli kardiyo / dayanıklılık (1,2–1,4 g/kg)" },
        { value: "kuvvet", label: "Ağırlık antrenmanı, kas kazanımı (1,6–2,0 g/kg)" },
        { value: "diyet", label: "Kilo verirken kas koruma (1,6–2,2 g/kg)" }
      ]}
      value="hafif"
    />
    <CalcSelect
      id="ogun"
      label="Günlük Öğün Sayısı"
      options={[
        { value: "3", label: "3 öğün" },
        { value: "4", label: "4 öğün" },
        { value: "5", label: "5 öğün" }
      ]}
      value="3"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Günlük Protein İhtiyacı</p>
      <p class="calc-result-value" id="protein-sonuc">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Öğün başına</span>
        <span class="calc-detail-value" id="d-ogun">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Kilo başına</span>
        <span class="calc-detail-value" id="d-faktor">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Enerji karşılığı (1 g = 4 kcal)</span>
        <span class="calc-detail-value" id="d-kcal">—</span>
      </div>
    </div>
  </CalcResult>

  <p class="calc-note">
    Sonuçlar sağlıklı yetişkinler için genel önerilerdir. Böbrek veya karaciğer hastalığınız varsa, gebelik ya da emzirme dönemindeyseniz veya özel bir diyet uyguluyorsanız protein miktarını hekiminiz veya diyetisyeninizle birlikte belirleyin.
  </p>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      const ARALIK: Record<string, [number, number]> = {
        sedanter: [0.8, 1.0],
        yasli: [1.0, 1.2],
        hafif: [1.0, 1.2],
        dayaniklilik: [1.2, 1.4],
        kuvvet: [1.6, 2.0],
        diyet: [1.6, 2.2]
      };

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      function num(id: string) {
        const raw = (document.getElementById(id) as HTMLInputElement).value.replace(',', '.');
        return raw.trim() === '' ? NaN : parseFloat(raw);
      }

      function fmt(n: number, d = 0) {
        return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
      }

      function calculate() {
        const kilo = num('kilo');
        const aktivite = (document.getElementById('aktivite') as HTMLSelectElement).value;
        const ogun = parseInt((document.getElementById('ogun') as HTMLSelectElement).value, 10) || 3;
        const aralik = ARALIK[aktivite];

        if (!isFinite(kilo) || kilo < 20 || kilo > 400 || !aralik) {
          resultArea?.classList.add('hidden');
          return;
        }

        const [alt, ust] = aralik;
        const minG = kilo * alt;
        const maxG = kilo * ust;

        $('protein-sonuc').textContent = `${fmt(minG)} – ${fmt(maxG)} g`;
        $('d-ogun').textContent = `${fmt(minG / ogun)} – ${fmt(maxG / ogun)} g`;
        $('d-faktor').textContent = `${fmt(alt, 1)} – ${fmt(ust, 1)} g/kg`;
        $('d-kcal').textContent = `${fmt(minG * 4)} – ${fmt(maxG * 4)} kcal`;

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (!el.id || !params.has(el.id)) return;
          const v = params.get(el.id) ?? '';
          // Select için yalnızca geçerli seçenekleri kabul et
          if (el instanceof HTMLSelectElement && !Array.from(el.options).some(o => o.value === v)) return;
          el.value = v;
          has = true;
        });
        if (has) calculate();
      }

      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Protein ihtiyacı neden kişiye göre değişir?</h2>
    <p>
      Protein; kas, bağ dokusu, enzim, hormon ve bağışıklık hücrelerinin yapı taşıdır. Vücut proteini depolayamadığı için her gün yeterli miktarda alınması gerekir. Hareketsiz bir yetişkinde temel ihtiyacı karşılamak için kilo başına 0,8 g yeterliyken, düzenli antrenman yapan, kilo veren veya yaşı ilerlemiş kişilerde kas kütlesini korumak için bu miktar artar.
    </p>

    <h2>Kilo başına protein önerileri</h2>
    <table>
      <thead>
        <tr><th>Grup / hedef</th><th>g/kg/gün</th><th>70 kg için</th></tr>
      </thead>
      <tbody>
        <tr><td>Hareketsiz sağlıklı yetişkin (DSÖ/FAO referansı)</td><td>0,8</td><td>56 g</td></tr>
        <tr><td>65 yaş üstü sağlıklı birey</td><td>1,0 – 1,2</td><td>70 – 84 g</td></tr>
        <tr><td>Dayanıklılık sporcusu</td><td>1,2 – 1,4</td><td>84 – 98 g</td></tr>
        <tr><td>Kuvvet antrenmanı, kas kazanımı</td><td>1,6 – 2,0</td><td>112 – 140 g</td></tr>
        <tr><td>Kalori açığında kas koruma</td><td>1,6 – 2,2</td><td>112 – 154 g</td></tr>
      </tbody>
    </table>
    <p>
      Uluslararası Spor Beslenmesi Derneği (ISSN), egzersiz yapan bireylerin çoğu için 1,4–2,0 g/kg aralığının hem yeterli hem güvenli olduğunu belirtir. Öğün başına kilo başına yaklaşık 0,25–0,4 g protein (çoğu yetişkin için 20–40 g) kas protein sentezini en verimli şekilde uyarır.
    </p>

    <h2>Örnek hesaplama</h2>
    <p>
      75 kg ağırlığında, haftada dört gün ağırlık antrenmanı yapan ve kas kazanmak isteyen biri için:
    </p>
    <ul>
      <li>Alt sınır: 75 × 1,6 = <strong>120 g</strong></li>
      <li>Üst sınır: 75 × 2,0 = <strong>150 g</strong></li>
      <li>4 öğüne bölündüğünde öğün başına 30–38 g protein</li>
      <li>Enerji karşılığı: 480–600 kcal (günlük 2.500 kcal'lik bir beslenmede yaklaşık %19–24)</li>
    </ul>
    <p>
      Bu miktar örneğin kahvaltıda 3 yumurta ve 50 g beyaz peynir (yaklaşık 26 g), öğlen 150 g tavuk (45 g), ara öğünde 200 g süzme yoğurt (20 g) ve akşam bir kase mercimek çorbası ile 120 g balıktan (35–40 g) karşılanabilir.
    </p>

    <h2>Fazla kilolu kişilerde hangi kilo kullanılmalı?</h2>
    <p>
      Kilo başına öneriler, yağ dokusunun az protein gerektirdiği gerçeğini hesaba katmaz. VKİ'si 30'un üzerindeyseniz hesaplamayı mevcut kilonuz yerine hedef kilonuz veya <a href="/saglik/ideal-kilo-hesaplama/">ideal kilonuz</a> üzerinden yapmanız daha gerçekçi sonuç verir.
    </p>

    <h2>İyi protein kaynakları</h2>
    <ul>
      <li><strong>Hayvansal:</strong> Tavuk, hindi, kırmızı et, balık, yumurta, süt, yoğurt, peynir</li>
      <li><strong>Bitkisel:</strong> Mercimek, nohut, kuru fasulye, soya ve tofu, bulgur ile baklagil kombinasyonları, kuruyemişler</li>
      <li><strong>Pratik seçenekler:</strong> Süzme yoğurt, lor peyniri, ton balığı konservesi, kefir</li>
    </ul>
  </section>
</CalcLayout>
