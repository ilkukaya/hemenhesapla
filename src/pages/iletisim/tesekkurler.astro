---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout title="Mesajınız alındı | Hemen Hesapla" description="Mesajınız bize ulaştı." noindex>
  <div class="container-page py-20 max-w-xl text-center">
    <span class="inline-grid place-items-center w-14 h-14 rounded-full bg-[var(--color-success-soft)] text-[var(--color-success)] mb-5">
      <Icon name="check" size={28} />
    </span>
    <h1 class="text-[2rem] font-extrabold tracking-[-0.025em]">Teşekkürler, mesajınız alındı</h1>
    <p class="mt-3 text-[var(--color-text-secondary)]">En kısa sürede e-posta ile dönüş yapacağız.</p>
    <a href="/" class="btn-primary mt-8">Ana sayfaya dön</a>
  </div>
</BaseLayout>
