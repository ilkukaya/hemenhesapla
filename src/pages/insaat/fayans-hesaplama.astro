---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Kaç adet fayans lazım, nasıl hesaplanır?",
    answer: "Döşenecek alan (m²) fire payıyla artırılır ve tek fayansın alanına bölünür, sonuç yukarı yuvarlanır. 4 × 3,5 m = 14 m² zemin için %10 fireyle 15,4 m² gerekir. 60 × 60 cm fayansın alanı 0,36 m² olduğundan 15,4 ÷ 0,36 = 42,8, yani 43 adet alınır. Kutu 1,44 m² (4 adet) ise 11 kutu gerekir."
  },
  {
    question: "Fayans ve seramikte fire payı ne kadar olmalı?",
    answer: "Düz döşemede ve kesimin az olduğu dikdörtgen alanlarda %5–10, çok köşeli, niş ve kolonlu alanlarda %10–15, çapraz (45°) veya balıksırtı döşemede %15–20 fire önerilir. 60 × 120 cm gibi büyük ebatlarda kırılma riski ve kesim artığı daha fazladır. Aynı üretim partisinden yedek birkaç parça ayırmak ileride tamir için de faydalıdır."
  },
  {
    question: "Kutu sayısı nasıl hesaplanır?",
    answer: "Fayanslar metrekare üzerinden fiyatlandırılıp kutu olarak satılır. Kutunun kaç m² içerdiği etikette yazar; 60 × 60 cm'de genellikle 1,44 m² (4 adet), 30 × 60 cm'de 1,44 m² (8 adet), 60 × 120 cm'de 1,44 m² (2 adet) olur. Gereken adet, kutudaki adete bölünüp yukarı yuvarlanır; kutu bölünerek satılmadığı için ödeyeceğiniz alan biraz daha fazla olur."
  },
  {
    question: "Duvar fayansı nasıl hesaplanır?",
    answer: "Her duvarın uzunluğu ile döşenecek yüksekliğini çarpın, kapı ve pencere alanlarını çıkarın ve duvarları toplayın. 2 × 2,5 m bir banyoda tavana kadar 2,6 m fayans için duvar alanı 2 × (2 + 2,5) × 2,6 = 23,4 m²'dir; 0,8 × 2 m kapı düşülünce 21,8 m² kalır. Hesaplayıcıya en olarak toplam duvar uzunluğunu, boy olarak yüksekliği girebilirsiniz."
  },
  {
    question: "Metrekareye ne kadar fayans yapıştırıcısı gider?",
    answer: "Çimento esaslı seramik yapıştırıcısının sarfiyatı, kullanılan tarak dişine ve fayans ebadına göre 3–5 kg/m² arasındadır. 60 × 60 cm ve üzeri ebatlarda hem fayansın arkasına hem zemine sürme gerektiği için 5–6 kg/m²'ye çıkabilir. Hesaplayıcı ortalama 4 kg/m² ile 25 kg'lık torba sayısını tahmin eder."
  },
  {
    question: "Derz aralığı fayans adedini etkiler mi?",
    answer: "Genellikle 2–3 mm'lik derz, 30 cm ve üzeri fayanslarda adet hesabını %1–2 azaltır; bu küçük fark fire payının içinde kalır. Bu yüzden hesaplamada derz genellikle göz ardı edilir. Rustik veya küçük ebatlı (10 × 10 cm) karolarda derz payı daha önemlidir; bu durumda fayans ölçüsüne derz genişliğini ekleyerek hesaplayabilirsiniz."
  }
];

const meta = {
  title: "Fayans Hesaplama",
  seoTitle: "Fayans Hesaplama – Kaç Adet, Kaç Kutu Seramik Lazım?",
  description: "Zemin veya duvar ölçülerini ve fayans ebadını girin; fire dahil fayans adedini, kutu sayısını, satın alınacak m²'yi ve yapıştırıcı ihtiyacını hesaplayın.",
  summary: "Gereken fayans adedi = alan (m²) × (1 + fire oranı) ÷ tek fayansın alanı (m²), yukarı yuvarlanır. Örneğin 14 m² zemin için 60 × 60 cm fayansla %10 fire dahil 43 adet gerekir; kutu 1,44 m² (4 adet) ise 11 kutu alınır. Düz döşemede %10, çapraz döşemede %15–20 fire önerilir.",
  howTo: [
    "Döşenecek alanın enini ve boyunu metre olarak girin (duvarda toplam uzunluk ve yükseklik).",
    "Fayansın en ve boy ölçüsünü santimetre olarak yazın.",
    "Döşeme şekline uygun fire payını girin.",
    "Kutudaki metrekareyi etiketinden bakarak yazın.",
    "Fayans adedini, kutu sayısını ve yapıştırıcı ihtiyacını sonuçta görün."
  ],
  sources: [],
  category: "insaat",
  slug: "fayans-hesaplama",
  keywords: ["fayans hesaplama", "kaç fayans lazım", "seramik hesaplama", "fayans kutu hesaplama", "metrekare fayans hesaplama", "fayans yapıştırıcısı hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["insaat/parke-hesaplama", "insaat/boya-hesaplama", "insaat/beton-hesaplama", "matematik/alan-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="alanEn"
      label="Alan Eni"
      type="number"
      suffix="m"
      placeholder="4"
      min={0}
      step={0.01}
      helpText="Duvarda toplam duvar uzunluğu"
    />
    <CalcInput
      id="alanBoy"
      label="Alan Boyu"
      type="number"
      suffix="m"
      placeholder="3.5"
      min={0}
      step={0.01}
      helpText="Duvarda döşenecek yükseklik"
    />
    <CalcInput
      id="fayansEn"
      label="Fayans Eni"
      type="number"
      suffix="cm"
      placeholder="60"
      value={60}
      min={1}
      step={0.5}
    />
    <CalcInput
      id="fayansBoy"
      label="Fayans Boyu"
      type="number"
      suffix="cm"
      placeholder="60"
      value={60}
      min={1}
      step={0.5}
    />
    <CalcInput
      id="dusulen"
      label="Düşülecek Alan"
      type="number"
      suffix="m²"
      placeholder="0"
      min={0}
      step={0.1}
      required={false}
      helpText="Kapı, pencere, küvet vb."
    />
    <CalcInput
      id="fire"
      label="Fire Payı"
      type="number"
      suffix="%"
      placeholder="10"
      value={10}
      min={0}
      max={50}
      step={1}
      required={false}
      helpText="Düz %10, çapraz %15–20"
    />
    <CalcInput
      id="kutuM2"
      label="Kutudaki Alan"
      type="number"
      suffix="m²/kutu"
      placeholder="1.44"
      value={1.44}
      min={0}
      step={0.01}
      required={false}
      helpText="Kutu etiketinde yazar; boş bırakılabilir"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Gereken Fayans</p>
      <p class="calc-result-value" id="sonuc-fayans">—</p>
      <p class="calc-result-sub" id="sonuc-alt"></p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Döşenecek alan</span>
        <span class="calc-detail-value" id="detail-alan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Fire hariç adet</span>
        <span class="calc-detail-value" id="detail-firesiz">—</span>
      </div>
      <div class="calc-detail-row is-total">
        <span class="calc-detail-label">Kutu sayısı</span>
        <span class="calc-detail-value" id="detail-kutu">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Satın alınacak alan</span>
        <span class="calc-detail-value" id="detail-satin">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Yapıştırıcı (~4 kg/m²)</span>
        <span class="calc-detail-value" id="detail-yapistirici">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      function num(id: string) {
        const raw = (document.getElementById(id) as HTMLInputElement).value.replace(',', '.').trim();
        return raw === '' ? NaN : Number(raw);
      }

      const fmt = (n: number, d = 2) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: d }).format(n);
      const ceil = (n: number) => Math.ceil(n - 1e-9);

      function calculate() {
        const en = num('alanEn');
        const boy = num('alanBoy');
        const fEn = num('fayansEn');
        const fBoy = num('fayansBoy');
        const dusRaw = num('dusulen');
        const dusulen = isNaN(dusRaw) ? 0 : dusRaw;
        const fireRaw = num('fire');
        const fire = isNaN(fireRaw) ? 0 : fireRaw;
        const kutuM2 = num('kutuM2');

        if (![en, boy, fEn, fBoy].every(v => isFinite(v) && v > 0) || dusulen < 0 || fire < 0) {
          resultArea?.classList.add('hidden');
          return;
        }

        const alan = Math.max(0, en * boy - dusulen);
        if (alan <= 0) {
          resultArea?.classList.add('hidden');
          return;
        }
        const tekAlan = (fEn * fBoy) / 10000;
        const firesiz = ceil(alan / tekAlan);
        const adet = ceil((alan * (1 + fire / 100)) / tekAlan);

        $('sonuc-fayans').textContent = `${fmt(adet, 0)} adet`;
        $('sonuc-alt').textContent = `${fmt(fEn, 1)} × ${fmt(fBoy, 1)} cm, %${fmt(fire, 0)} fire dahil`;
        $('detail-alan').textContent = `${fmt(alan)} m²`;
        $('detail-firesiz').textContent = `${fmt(firesiz, 0)} adet`;

        if (isFinite(kutuM2) && kutuM2 > 0) {
          const kutudaAdet = Math.max(1, Math.round(kutuM2 / tekAlan));
          const kutu = ceil(adet / kutudaAdet);
          $('detail-kutu').textContent = `${fmt(kutu, 0)} kutu (kutuda ${kutudaAdet} adet)`;
          $('detail-satin').textContent = `${fmt(kutu * kutudaAdet * tekAlan)} m²`;
        } else {
          $('detail-kutu').textContent = '—';
          $('detail-satin').textContent = `${fmt(adet * tekAlan)} m²`;
        }

        const yapistirici = alan * 4;
        $('detail-yapistirici').textContent = `${fmt(yapistirici, 0)} kg (${ceil(yapistirici / 25)} torba × 25 kg)`;

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (el.id && params.has(el.id)) { el.value = params.get(el.id) ?? ''; has = true; }
        });
        if (has) calculate();
      }

      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Fayans miktarı nasıl hesaplanır?</h2>
    <p>
      Fayans ihtiyacı üç adımda bulunur: döşenecek net alanı hesaplamak, kesim ve kırılma için fire eklemek ve sonucu tek fayansın alanına bölmek. Fayans ebadı santimetre ile verildiği için alanı metrekareye çevirmek gerekir: 60 × 60 cm = 0,60 × 0,60 = 0,36 m².
    </p>
    <ul>
      <li><strong>Net alan</strong> = en × boy − kapı, pencere, küvet gibi döşenmeyecek alanlar</li>
      <li><strong>Fire dahil alan</strong> = net alan × (1 + fire oranı)</li>
      <li><strong>Adet</strong> = fire dahil alan ÷ tek fayans alanı, yukarı yuvarlanır</li>
      <li><strong>Kutu</strong> = adet ÷ kutudaki adet, yukarı yuvarlanır</li>
    </ul>

    <h2>Örnek hesaplama</h2>
    <p>
      4 m × 3,5 m bir mutfak zeminine 60 × 60 cm porselen seramik döşenecek. Kutuda 1,44 m² (4 adet) var, fire %10.
    </p>
    <ul>
      <li>Net alan: 4 × 3,5 = 14 m²</li>
      <li>Fire dahil: 14 × 1,10 = 15,4 m²</li>
      <li>Adet: 15,4 ÷ 0,36 = 42,8 → <strong>43 adet</strong></li>
      <li>Kutu: 43 ÷ 4 = 10,75 → <strong>11 kutu</strong> (44 adet, 15,84 m² ödenir)</li>
      <li>Yapıştırıcı: 14 × 4 = 56 kg → 3 torba (25 kg)</li>
    </ul>

    <h2>Ebada göre metrekaredeki fayans adedi</h2>
    <table>
      <thead>
        <tr><th>Ebat</th><th>Tek fayans alanı</th><th>1 m²'deki adet</th><th>Tipik kutu</th></tr>
      </thead>
      <tbody>
        <tr><td>20 × 20 cm</td><td>0,04 m²</td><td>25</td><td>1 m² (25 adet)</td></tr>
        <tr><td>30 × 60 cm</td><td>0,18 m²</td><td>5,56</td><td>1,44 m² (8 adet)</td></tr>
        <tr><td>45 × 45 cm</td><td>0,2025 m²</td><td>4,94</td><td>1,42 m² (7 adet)</td></tr>
        <tr><td>60 × 60 cm</td><td>0,36 m²</td><td>2,78</td><td>1,44 m² (4 adet)</td></tr>
        <tr><td>60 × 120 cm</td><td>0,72 m²</td><td>1,39</td><td>1,44 m² (2 adet)</td></tr>
      </tbody>
    </table>
    <p>Kutu içerikleri üreticiye göre değişir; hesaplamadan önce etiketi kontrol edin.</p>

    <h2>Fire oranı seçimi</h2>
    <table>
      <thead>
        <tr><th>Durum</th><th>Önerilen fire</th></tr>
      </thead>
      <tbody>
        <tr><td>Düz döşeme, dikdörtgen oda</td><td>%5–10</td></tr>
        <tr><td>Çok köşeli alan, banyo, niş ve kolonlar</td><td>%10–15</td></tr>
        <tr><td>Çapraz (45°) veya balıksırtı döşeme</td><td>%15–20</td></tr>
        <tr><td>Büyük ebat (60 × 120 cm ve üzeri)</td><td>%10–15</td></tr>
      </tbody>
    </table>
    <p>
      Kalan sağlam fayansların birkaçını saklayın. Aynı model sonradan farklı üretim partisinde (ton) gelebilir ve kırılan bir parçayı değiştirirken renk farkı oluşabilir.
    </p>
  </section>
</CalcLayout>
