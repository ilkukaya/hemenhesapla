---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Kaç paket parke lazım?",
    answer: "Oda alanı fire payıyla artırılır ve paketteki metrekareye bölünür, sonuç yukarı yuvarlanır. 4 × 5 m = 20 m² bir oda için %10 fireyle 22 m² gerekir. Paket 2,22 m² ise 22 ÷ 2,22 = 9,9, yani 10 paket alınır ve 22,2 m² parke ödenir. Paketteki alan marka ve kalınlığa göre değiştiği için etiketi kontrol edin."
  },
  {
    question: "Laminat parkede fire payı ne kadar olmalı?",
    answer: "Düz (paralel) döşemede dikdörtgen odalarda %5–8, çok köşeli, kolonlu veya koridorlu alanlarda %10, çapraz döşemede %12–15, balıksırtı desende %15–20 fire önerilir. Her sıranın sonunda kesilen parça bir sonraki sıraya başlangıç olarak kullanılabildiği için laminatta fire, fayansa göre daha düşüktür."
  },
  {
    question: "Süpürgelik kaç metre gerekir?",
    answer: "Odanın çevresi 2 × (en + boy) formülüyle bulunur, kapı boşlukları çıkarılır ve köşe kesimleri için %10 eklenir. 4 × 5 m bir odada 18 m çevreden 0,9 m kapı düşülünce 17,1 m, fireyle 18,8 m süpürgelik gerekir. Süpürgelikler genellikle 2,4 m boyunda satıldığından 8 adet alınır. İç ve dış köşe parçaları ile kapı eşiği profillerini ayrıca sayın."
  },
  {
    question: "Parke altına şilte gerekir mi?",
    answer: "Laminat parke yüzer sistem döşendiği için altına mutlaka şilte (ses ve nem yalıtım altlığı) serilir. Şilte miktarı oda alanı kadardır; ekleri üst üste bindirilmeyip bantlanır. Beton veya şap zeminde nem bariyerli şilte ya da ayrıca naylon örtü kullanılmalıdır. Yerden ısıtmalı zeminlerde üreticinin önerdiği düşük ısıl dirençli şilteyi seçin."
  },
  {
    question: "Laminat parke döşemeden önce ne yapılmalı?",
    answer: "Paketler döşenecek odada, açılmadan en az 48 saat bekletilerek ortam sıcaklığına ve nemine alıştırılmalıdır. Zeminin düz olması gerekir; 2 m'lik mastarda 3 mm'den fazla bozukluk varsa tesviye şapı yapılır. Duvar kenarlarında ve kapı eşiklerinde 8–10 mm genleşme payı bırakılır; bu boşluk süpürgelikle kapatılır."
  },
  {
    question: "Parke hangi yönde döşenmeli?",
    answer: "Parkeler genellikle odaya en çok ışık alan pencereye dik, yani ışığın geldiği yöne paralel döşenir; böylece birleşim çizgileri daha az belli olur. Dar ve uzun odalarda uzun kenara paralel döşeme mekânı daha geniş gösterir. Yön, fire oranını değiştirmez ama çapraz döşeme fireyi belirgin şekilde artırır."
  }
];

const meta = {
  title: "Parke Hesaplama",
  seoTitle: "Parke Hesaplama – Kaç m², Kaç Paket Laminat Lazım?",
  description: "Oda ölçülerini, fire oranını ve paketteki m²'yi girin; gereken laminat parke miktarını, paket sayısını, şilte alanını ve süpürgelik adedini hemen hesaplayın.",
  summary: "Gereken paket sayısı = oda alanı (m²) × (1 + fire oranı) ÷ paketteki m², yukarı yuvarlanır. Örneğin 4 × 5 m (20 m²) oda için %10 fireyle 22 m² gerekir; 2,22 m²'lik paketlerden 10 paket alınır. Süpürgelik için oda çevresinden kapı genişliği düşülür ve %10 eklenir.",
  howTo: [
    "Odanın enini ve boyunu metre olarak girin.",
    "Döşeme şekline göre fire oranını seçin.",
    "Paket etiketindeki metrekareyi yazın.",
    "Süpürgelik için kapı boşluklarının toplam genişliğini girin.",
    "Paket sayısını, satın alınacak m²'yi, şilte ve süpürgelik ihtiyacını sonuçta görün."
  ],
  sources: [],
  category: "insaat",
  slug: "parke-hesaplama",
  keywords: ["parke hesaplama", "laminat parke hesaplama", "kaç paket parke lazım", "parke m2 hesaplama", "süpürgelik hesaplama", "parke fire oranı"],
  dateModified: "2026-09-26",
  relatedCalcs: ["insaat/fayans-hesaplama", "insaat/boya-hesaplama", "insaat/beton-hesaplama", "matematik/alan-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="odaEn"
      label="Oda Eni"
      type="number"
      suffix="m"
      placeholder="4"
      min={0}
      step={0.01}
    />
    <CalcInput
      id="odaBoy"
      label="Oda Boyu"
      type="number"
      suffix="m"
      placeholder="5"
      min={0}
      step={0.01}
    />
    <CalcSelect
      id="fire"
      label="Döşeme Şekli / Fire"
      options={[
        { value: "7", label: "Düz, sade oda – %7" },
        { value: "10", label: "Düz, köşeli oda – %10" },
        { value: "15", label: "Çapraz (45°) – %15" },
        { value: "20", label: "Balıksırtı – %20" }
      ]}
      value="10"
    />
    <CalcInput
      id="paketM2"
      label="Paketteki Alan"
      type="number"
      suffix="m²/paket"
      placeholder="2.22"
      value={2.22}
      min={0.1}
      step={0.001}
      helpText="Paket etiketinde yazar (genellikle 1,6–2,6 m²)"
    />
    <CalcInput
      id="kapi"
      label="Kapı Boşlukları"
      type="number"
      suffix="m"
      placeholder="0.9"
      value={0.9}
      min={0}
      step={0.1}
      required={false}
      helpText="Süpürgelik düşülecek toplam genişlik"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Gereken Paket</p>
      <p class="calc-result-value" id="sonuc-parke">—</p>
      <p class="calc-result-sub" id="sonuc-alt"></p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Oda alanı</span>
        <span class="calc-detail-value" id="detail-alan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Fire dahil ihtiyaç</span>
        <span class="calc-detail-value" id="detail-parke">—</span>
      </div>
      <div class="calc-detail-row is-total">
        <span class="calc-detail-label">Satın alınacak parke</span>
        <span class="calc-detail-value" id="detail-satin">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Şilte</span>
        <span class="calc-detail-value" id="detail-silte">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Süpürgelik (2,4 m boy)</span>
        <span class="calc-detail-value" id="detail-supurgelik">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      function num(id: string) {
        const raw = (document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value.replace(',', '.').trim();
        return raw === '' ? NaN : Number(raw);
      }

      const fmt = (n: number, d = 2) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: d }).format(n);
      const ceil = (n: number) => Math.ceil(n - 1e-9);

      function calculate() {
        const en = num('odaEn');
        const boy = num('odaBoy');
        const fireRaw = num('fire');
        const fire = isNaN(fireRaw) ? 10 : fireRaw;
        const paketM2 = num('paketM2');
        const kapiRaw = num('kapi');
        const kapi = isNaN(kapiRaw) ? 0 : kapiRaw;

        if (![en, boy, paketM2].every(v => isFinite(v) && v > 0) || fire < 0 || kapi < 0) {
          resultArea?.classList.add('hidden');
          return;
        }

        const alan = en * boy;
        const ihtiyac = alan * (1 + fire / 100);
        const paket = ceil(ihtiyac / paketM2);
        const supurgelikM = Math.max(0, 2 * (en + boy) - kapi) * 1.1;

        $('sonuc-parke').textContent = `${paket} paket`;
        $('sonuc-alt').textContent = `%${fmt(fire, 0)} fire dahil, ${fmt(paketM2, 3)} m²/paket`;
        $('detail-alan').textContent = `${fmt(alan)} m²`;
        $('detail-parke').textContent = `${fmt(ihtiyac)} m²`;
        $('detail-satin').textContent = `${fmt(paket * paketM2)} m²`;
        $('detail-silte').textContent = `${fmt(alan)} m²`;
        $('detail-supurgelik').textContent = `${fmt(supurgelikM, 1)} m (${ceil(supurgelikM / 2.4)} adet)`;

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (el.id && params.has(el.id)) { el.value = params.get(el.id) ?? ''; has = true; }
        });
        if (has) calculate();
      }

      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Parke miktarı nasıl hesaplanır?</h2>
    <p>
      Laminat ve lamine parke metrekare üzerinden fiyatlandırılır ama paketle satılır. Bu yüzden önce odanın alanı bulunur, kesim artıkları için fire eklenir ve sonuç paketteki metrekareye bölünerek yukarı yuvarlanır. Paket bölünmediği için kasada ödediğiniz alan, ihtiyacınızdan biraz fazla olur.
    </p>
    <ul>
      <li><strong>Oda alanı</strong> = en × boy</li>
      <li><strong>İhtiyaç</strong> = oda alanı × (1 + fire oranı)</li>
      <li><strong>Paket</strong> = ihtiyaç ÷ paketteki m², yukarı yuvarlanır</li>
      <li><strong>Süpürgelik</strong> = (2 × (en + boy) − kapı boşlukları) × 1,10</li>
    </ul>
    <p>
      L biçimli veya girintili odaları dikdörtgenlere bölüp her birini ayrı hesaplayın ve paket sayısını toplam alan üzerinden bulun; böylece gereksiz yuvarlamalar birikmez.
    </p>

    <h2>Örnek hesaplama</h2>
    <p>
      4 m × 5 m bir salona düz döşeme yapılacak. Oda köşeli, fire %10; paket 2,22 m², tek kapı 0,9 m.
    </p>
    <ul>
      <li>Oda alanı: 4 × 5 = 20 m²</li>
      <li>Fire dahil: 20 × 1,10 = 22 m²</li>
      <li>Paket: 22 ÷ 2,22 = 9,91 → <strong>10 paket</strong> (22,2 m² satın alınır)</li>
      <li>Şilte: 20 m²</li>
      <li>Süpürgelik: (18 − 0,9) × 1,10 = 18,8 m → 8 adet 2,4 m'lik süpürgelik</li>
    </ul>

    <h2>Döşeme şekline göre fire oranları</h2>
    <table>
      <thead>
        <tr><th>Döşeme</th><th>Fire</th><th>Açıklama</th></tr>
      </thead>
      <tbody>
        <tr><td>Düz, dikdörtgen oda</td><td>%5–8</td><td>Sıra sonu artıkları bir sonraki sırada kullanılır</td></tr>
        <tr><td>Düz, köşeli veya koridorlu</td><td>%10</td><td>Kolon, niş ve kapı kasaları çevresinde kesim artar</td></tr>
        <tr><td>Çapraz (45°)</td><td>%12–15</td><td>Duvar kenarlarında açılı kesimler</td></tr>
        <tr><td>Balıksırtı</td><td>%15–20</td><td>Desen gereği yoğun kesim</td></tr>
      </tbody>
    </table>

    <h2>Döşeme öncesi kontrol listesi</h2>
    <ul>
      <li>Paketleri odada açmadan en az 48 saat bekletin.</li>
      <li>Zeminde 2 m'de 3 mm'den fazla bozukluk varsa önce tesviye yapın.</li>
      <li>Beton zeminde nem bariyerli şilte veya naylon kullanın.</li>
      <li>Duvar diplerinde 8–10 mm genleşme boşluğu bırakın.</li>
      <li>Sonradan onarım için 1–2 fazla parçayı saklayın.</li>
    </ul>
  </section>
</CalcLayout>
