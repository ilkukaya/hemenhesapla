---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Bir oda için kaç litre boya gerekir?",
    answer: "Duvar alanı 2 × (en + boy) × tavan yüksekliği formülüyle bulunur, kapı ve pencere alanı çıkarılır. 4 × 5 m, 2,70 m yüksekliğindeki bir odanın duvarları yaklaşık 45 m²'dir. Litresi 10 m² kaplayan boyayla iki kat için 45 × 2 ÷ 10 = 9 litre, %10 fireyle yaklaşık 10 litre gerekir. Tavan da boyanacaksa 20 m² daha eklenir."
  },
  {
    question: "1 litre boya kaç m² boyar?",
    answer: "İç cephe su bazlı plastik ve silikonlu boyalarda 1 litre, tek katta genellikle 8–12 m² alanı kaplar. Bu değer ambalajda \"sarfiyat\" ya da \"verim\" olarak yazar. Pürüzlü sıva, alçısı yeni yapılmış duvar ve koyu renkten açık renge geçişte sarfiyat artar; bu durumlarda hesaplayıcıya daha düşük bir verim (ör. 8 m²/lt) girin."
  },
  {
    question: "Duvar kaç kat boyanmalı?",
    answer: "Aynı veya yakın renkte yenileme boyasında 2 kat yeterlidir. Koyu renkten açık renge geçişte, yeni alçı veya sıvada ya da parlak renklerde 3 kat gerekebilir. Yeni yüzeylerde ve renk değişiminde son kat boyadan önce bir kat astar uygulamak, hem örtücülüğü artırır hem de toplam boya tüketimini azaltır."
  },
  {
    question: "Boya kg mı litre mi satılır, dönüşüm nasıl yapılır?",
    answer: "İç cephe boyaları genellikle 2,5 L, 7,5 L ve 15 L ambalajlarda satılır; bazı markalar 3,5 kg, 10 kg, 20 kg gibi ağırlıkla satar. Su bazlı plastik boyanın yoğunluğu yaklaşık 1,3–1,5 kg/L olduğundan 20 kg'lık bir kova kabaca 14–15 litreye denk gelir. Kesin değer ürünün teknik föyünde yer alır."
  },
  {
    question: "Kapı ve pencere alanı nasıl hesaplanır?",
    answer: "Standart bir iç kapı yaklaşık 0,9 × 2,1 = 1,9 m², orta boy bir pencere 1,2 × 1,4 = 1,7 m²'dir. Odadaki tüm kapı ve pencerelerin alanlarını toplayıp hesaplayıcıya girin. Küçük pencereleri düşmemek boyayı biraz fazla hesaplatır; bu da rötuş için kenarda boya kalmasını sağladığından çoğu zaman sorun olmaz."
  },
  {
    question: "Bütün ev için ne kadar boya gerekir?",
    answer: "Kaba bir tahmin için net kullanım alanını 2,5–3 ile çarparak boyanacak duvar alanını bulabilirsiniz. 100 m²'lik bir daire için 250–300 m² duvar eder; iki kat ve 10 m²/lt verimle 50–60 litre, tavanlar dahil 70–80 litre boya gerekir. Daha doğru sonuç için her odayı ayrı ayrı hesaplayıp toplayın."
  }
];

const meta = {
  title: "Boya Hesaplama",
  seoTitle: "Boya Hesaplama – Oda İçin Kaç Litre Boya Lazım?",
  description: "Oda ölçülerini, kat sayısını ve boya verimini girin; kapı-pencere düşülmüş duvar alanını, fire dahil litre ihtiyacını ve alınacak kova sayısını hesaplayın.",
  summary: "Gereken boya (litre) = boyanacak alan (m²) × kat sayısı ÷ boyanın verimi (m²/lt), üzerine %10 fire. Duvar alanı 2 × (en + boy) × yükseklik − kapı/pencere alanıdır. 4 × 5 m, 2,70 m yüksekliğindeki bir oda için iki kat duvar boyası yaklaşık 10 litre tutar.",
  howTo: [
    "Odanın en, boy ve tavan yüksekliğini metre olarak girin.",
    "Boyanmayacak kapı ve pencere alanlarının toplamını yazın.",
    "Kat sayısını ve tavanın boyanıp boyanmayacağını seçin.",
    "Ambalajdaki verim değerini (m²/lt) ve fire oranını kontrol edin.",
    "Ambalaj boyutunu seçin; gereken litre ve kova sayısını sonuçta görün."
  ],
  sources: [],
  category: "insaat",
  slug: "boya-hesaplama",
  keywords: ["boya hesaplama", "kaç litre boya lazım", "oda boya hesaplama", "duvar boyası hesaplama", "1 litre boya kaç m2", "boya metrekare hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["insaat/parke-hesaplama", "insaat/fayans-hesaplama", "insaat/beton-hesaplama", "matematik/alan-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="en"
      label="Oda Eni"
      type="number"
      suffix="m"
      placeholder="4"
      min={0}
      step={0.01}
    />
    <CalcInput
      id="boy"
      label="Oda Boyu"
      type="number"
      suffix="m"
      placeholder="5"
      min={0}
      step={0.01}
    />
    <CalcInput
      id="yukseklik"
      label="Tavan Yüksekliği"
      type="number"
      suffix="m"
      placeholder="2.70"
      value={2.7}
      min={0}
      step={0.01}
      helpText="Konutlarda genellikle 2,60–2,80 m"
    />
    <CalcInput
      id="kapiPencere"
      label="Kapı + Pencere Alanı"
      type="number"
      suffix="m²"
      placeholder="3.5"
      value={3.5}
      min={0}
      step={0.1}
      required={false}
      helpText="İç kapı ~1,9 m², pencere ~1,7 m²"
    />
    <CalcSelect
      id="katSayisi"
      label="Kat Sayısı"
      options={[
        { value: "1", label: "1 kat (tazeleme)" },
        { value: "2", label: "2 kat (önerilen)" },
        { value: "3", label: "3 kat (koyu renkten geçiş)" }
      ]}
      value="2"
    />
    <CalcSelect
      id="tavan"
      label="Tavan da Boyanacak mı?"
      options={[
        { value: "hayir", label: "Hayır, sadece duvarlar" },
        { value: "evet", label: "Evet, tavan dahil" }
      ]}
      value="hayir"
    />
    <CalcInput
      id="verim"
      label="Boya Verimi"
      type="number"
      suffix="m²/lt"
      placeholder="10"
      value={10}
      min={1}
      max={20}
      step={0.5}
      helpText="Tek katta 1 litrenin kapladığı alan (ambalajda yazar)"
    />
    <CalcInput
      id="fire"
      label="Fire Payı"
      type="number"
      suffix="%"
      placeholder="10"
      value={10}
      min={0}
      max={50}
      step={1}
      required={false}
    />
    <CalcSelect
      id="ambalaj"
      label="Ambalaj"
      options={[
        { value: "2.5", label: "2,5 litre" },
        { value: "7.5", label: "7,5 litre" },
        { value: "15", label: "15 litre" }
      ]}
      value="7.5"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Gereken Boya</p>
      <p class="calc-result-value" id="sonuc-boya">—</p>
      <p class="calc-result-sub" id="sonuc-alt"></p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Duvar alanı (net)</span>
        <span class="calc-detail-value" id="detail-duvar">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Tavan alanı</span>
        <span class="calc-detail-value" id="detail-tavan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam boyanacak alan</span>
        <span class="calc-detail-value" id="detail-alan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Fire hariç boya</span>
        <span class="calc-detail-value" id="detail-net">—</span>
      </div>
      <div class="calc-detail-row is-total">
        <span class="calc-detail-label">Alınacak ambalaj</span>
        <span class="calc-detail-value" id="detail-paket">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      function debounce(fn: () => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return () => { clearTimeout(timer); timer = setTimeout(fn, delay); };
      }

      function num(id: string) {
        const raw = (document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value.replace(',', '.').trim();
        return raw === '' ? NaN : Number(raw);
      }

      const fmt = (n: number, d = 2) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: d }).format(n);

      function calculate() {
        const en = num('en');
        const boy = num('boy');
        const h = num('yukseklik');
        const kpRaw = num('kapiPencere');
        const kp = isNaN(kpRaw) ? 0 : kpRaw;
        const kat = num('katSayisi') || 2;
        const tavanVar = (document.getElementById('tavan') as HTMLSelectElement).value === 'evet';
        const verim = num('verim');
        const fireRaw = num('fire');
        const fire = isNaN(fireRaw) ? 0 : fireRaw;
        const ambalaj = num('ambalaj') || 7.5;

        if (![en, boy, h, verim].every(v => isFinite(v) && v > 0) || kp < 0 || fire < 0) {
          resultArea?.classList.add('hidden');
          return;
        }

        const duvar = Math.max(0, 2 * (en + boy) * h - kp);
        const tavan = tavanVar ? en * boy : 0;
        const alan = duvar + tavan;
        const net = (alan * kat) / verim;
        const litre = net * (1 + fire / 100);
        const paket = Math.ceil(litre / ambalaj - 1e-9);

        $('sonuc-boya').textContent = `${fmt(litre, 1)} litre`;
        $('sonuc-alt').textContent = `${kat} kat, %${fmt(fire, 0)} fire dahil`;
        $('detail-duvar').textContent = `${fmt(duvar)} m²`;
        $('detail-tavan').textContent = tavanVar ? `${fmt(tavan)} m²` : 'Boyanmayacak';
        $('detail-alan').textContent = `${fmt(alan)} m²`;
        $('detail-net').textContent = `${fmt(net, 1)} litre`;
        $('detail-paket').textContent = `${paket} × ${fmt(ambalaj, 1)} lt = ${fmt(paket * ambalaj, 1)} litre`;

        resultArea?.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(el => { if (el.id && el.value !== '') params.set(el.id, el.value); });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let has = false;
        inputs.forEach(el => {
          if (el.id && params.has(el.id)) { el.value = params.get(el.id) ?? ''; has = true; }
        });
        if (has) calculate();
      }

      const debounced = debounce(calculate);
      inputs.forEach(el => {
        el.addEventListener('input', debounced);
        el.addEventListener('change', debounced);
      });

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Boya miktarı nasıl hesaplanır?</h2>
    <p>
      Boya ihtiyacı, boyanacak alanın kat sayısıyla çarpılıp boyanın verimine bölünmesiyle bulunur. Dikdörtgen bir odada dört duvarın toplam alanı çevre ile yüksekliğin çarpımıdır; kapı ve pencereler bu alandan düşülür. Tavan boyanacaksa taban alanı (en × boy) eklenir.
    </p>
    <ul>
      <li><strong>Duvar alanı</strong> = 2 × (en + boy) × yükseklik − kapı/pencere alanı</li>
      <li><strong>Boya (litre)</strong> = toplam alan × kat sayısı ÷ verim (m²/lt)</li>
      <li><strong>Fire dahil</strong> = boya × (1 + fire oranı); rulo ve fırçada kalan, kaba sıvanın emdiği boya için %10 önerilir</li>
      <li><strong>Ambalaj sayısı</strong> her zaman yukarı yuvarlanır</li>
    </ul>

    <h2>Örnek hesaplama</h2>
    <p>
      4 m × 5 m ölçülerinde, tavan yüksekliği 2,70 m olan bir yatak odası; bir kapı ve bir pencere toplam 3,5 m². İki kat boya, verim 10 m²/lt, %10 fire.
    </p>
    <ul>
      <li>Duvar alanı: 2 × (4 + 5) × 2,70 − 3,5 = 48,6 − 3,5 = 45,1 m²</li>
      <li>Boya: 45,1 × 2 ÷ 10 = 9,02 litre; fireyle 9,92 litre</li>
      <li>Alınacak: 4 adet 2,5 litrelik kutu ya da 2 adet 7,5 litrelik kova</li>
      <li>Tavan da boyanırsa alan 65,1 m², ihtiyaç 14,3 litre olur: 2 adet 7,5 litrelik kova yeterlidir</li>
    </ul>

    <h2>Oda büyüklüğüne göre tahmini boya ihtiyacı</h2>
    <p>2,70 m tavan, 3,5 m² kapı-pencere, 2 kat, 10 m²/lt verim ve %10 fire ile, yalnızca duvarlar:</p>
    <table>
      <thead>
        <tr><th>Oda</th><th>Duvar alanı</th><th>Boya</th><th>7,5 lt kova</th></tr>
      </thead>
      <tbody>
        <tr><td>3 × 3 m (küçük oda)</td><td>28,9 m²</td><td>6,4 lt</td><td>1</td></tr>
        <tr><td>3 × 4 m (yatak odası)</td><td>34,3 m²</td><td>7,6 lt</td><td>2 (veya 1 kova + 1 adet 2,5 lt)</td></tr>
        <tr><td>4 × 5 m (büyük yatak odası)</td><td>45,1 m²</td><td>9,9 lt</td><td>2</td></tr>
        <tr><td>5 × 6 m (salon)</td><td>55,9 m²</td><td>12,3 lt</td><td>2</td></tr>
      </tbody>
    </table>

    <h2>Boya tüketimini etkileyen durumlar</h2>
    <ul>
      <li><strong>Yüzey:</strong> Yeni alçı ve sıva boyayı emer. Önce astar sürmek, son kat boya ihtiyacını azaltır.</li>
      <li><strong>Renk değişimi:</strong> Koyudan açığa geçerken 3 kat gerekebilir; açıktan koyuya geçişte renkli astar kullanılabilir.</li>
      <li><strong>Uygulama aracı:</strong> Rulo, fırçaya göre daha ekonomiktir; püskürtme makinesinde kayıp %20–30'a çıkabilir.</li>
      <li><strong>Boya kalitesi:</strong> Örtücülüğü yüksek silikonlu boyalar daha az katla bitebilir; ucuz boyada sarfiyat artar.</li>
    </ul>
  </section>
</CalcLayout>
