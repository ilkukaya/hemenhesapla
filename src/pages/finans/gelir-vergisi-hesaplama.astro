---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import taxBrackets from '../../data/tax-brackets.json';

const meta = {
  title: "Gelir Vergisi Hesaplama",
  seoTitle: "Gelir Vergisi Hesaplama 2026 – Güncel Vergi Dilimleri",
  description: "2026 gelir vergisi hesaplama: ücret ve ücret dışı gelirler için güncel vergi dilimleri (%15–%40), dilim bazında vergi, marjinal ve ortalama vergi oranı.",
  summary: "2026 gelir vergisi dilimleri: 190.000 TL'ye kadar %15, 400.000 TL'ye kadar %20, ücretlilerde 1.500.000 TL'ye (ücret dışı gelirlerde 1.000.000 TL'ye) kadar %27, 5.300.000 TL'ye kadar %35, üzeri %40. Vergi, her dilime düşen tutara o dilimin oranı uygulanıp toplanarak bulunur; örneğin 500.000 TL ücret matrahının vergisi 97.500 TL'dir.",
  howTo: [
    "Gelir türünü seçin: ücret geliri ya da ücret dışı gelir (kira, serbest meslek, ticari kazanç vb.).",
    "Yıllık vergi matrahınızı (indirimler düşülmüş safi tutar) girin.",
    "Sonuçta toplam vergiyi, her dilime düşen vergiyi, marjinal ve ortalama oranı görün."
  ],
  sources: [
    { name: "Gelir İdaresi Başkanlığı", url: "https://www.gib.gov.tr/" },
    { name: "193 sayılı Gelir Vergisi Kanunu, md. 103", url: "https://www.mevzuat.gov.tr/mevzuatmetin/1.4.193.pdf" }
  ],
  category: "finans",
  slug: "gelir-vergisi-hesaplama",
  keywords: ["gelir vergisi hesaplama", "2026 vergi dilimleri", "gelir vergisi dilimleri 2026", "ücret gelir vergisi", "kira geliri vergisi", "efektif vergi oranı"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/net-brut-maas-hesaplama", "finans/stopaj-hesaplama", "finans/kira-artis-hesaplama", "finans/kdv-hesaplama"],
  faq: [
    {
      question: "2026 gelir vergisi dilimleri nelerdir?",
      answer: "332 Seri No'lu Gelir Vergisi Genel Tebliği'ne göre 2026 tarifesi: 190.000 TL'ye kadar %15; 190.000–400.000 TL %20; ücretlilerde 400.000–1.500.000 TL, ücret dışı gelirlerde 400.000–1.000.000 TL %27; 5.300.000 TL'ye kadar %35; 5.300.000 TL üzeri %40. Tarife 1 Ocak–31 Aralık 2026 döneminde elde edilen gelirlere uygulanır ve 2027 başında yeniden güncellenir."
    },
    {
      question: "Ücret ve ücret dışı gelir tarifesi neden farklı?",
      answer: "Ücretlilerin vergisi her ay kaynakta kesildiği ve kümülatif matrah nedeniyle yıl içinde dilim atladıkları için, 2023'ten beri ücret gelirlerine üçüncü dilimde daha geniş bir aralık tanınıyor. 2026'da bu sınır ücretlilerde 1.500.000 TL, kira, serbest meslek ve ticari kazanç gibi ücret dışı gelirlerde 1.000.000 TL'dir."
    },
    {
      question: "Marjinal vergi oranı ile ortalama vergi oranı arasındaki fark nedir?",
      answer: "Marjinal oran, gelirinize eklenecek bir sonraki liraya uygulanacak orandır; yani girdiğiniz en üst dilimin oranıdır. Ortalama (efektif) oran ise toplam verginin toplam matraha bölümüdür. Örneğin 500.000 TL ücret matrahında marjinal oran %27, toplam vergi 97.500 TL ve ortalama oran %19,5'tir. Tüm gelir en üst orandan vergilendirilmez."
    },
    {
      question: "Kira geliri için gelir vergisi nasıl hesaplanır?",
      answer: "2026 yılında elde edilen konut kira gelirine 58.000 TL istisna uygulanır (ticari, zirai veya mesleki kazancı olanlar ile toplam geliri belirli tutarı aşanlar yararlanamaz). Kalan tutardan %15 götürü gider ya da belgeli gerçek giderler düşülerek matrah bulunur ve ücret dışı gelir tarifesine göre vergilendirilir. Beyanname Mart ayında verilir, vergi Mart ve Temmuz'da iki taksitte ödenir."
    },
    {
      question: "Tek işverenden ücret alan beyanname verir mi?",
      answer: "Tek işverenden alınan ve kaynakta vergisi kesilmiş ücretler, tutarı ne olursa olsun beyan edilmez; ancak 2026 için 5.300.000 TL'yi aşan ücret gelirleri beyana tabidir. Birden fazla işverenden ücret alanlarda ikinci ve sonraki işverenlerden alınan ücretlerin toplamı 400.000 TL'yi aşıyorsa yıllık beyanname verilir."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="gelirTuru"
      label="Gelir Türü"
      options={[
        { value: "ucret", label: "Ücret geliri" },
        { value: "ucretDisi", label: "Ücret dışı gelir (kira, serbest meslek, ticari)" },
      ]}
      value="ucret"
    />
    <CalcInput
      id="yillikGelir"
      label="Yıllık Vergi Matrahı"
      type="number"
      suffix="₺"
      placeholder="600000"
      step="any"
      min={0}
      helpText="İndirim ve istisnalar düşüldükten sonraki yıllık tutar"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Toplam Gelir Vergisi</p>
      <p class="calc-result-value" id="toplam-vergi">—</p>
    </div>
    <div slot="details">
      {[0, 1, 2, 3, 4].map((i) => (
        <div class="calc-detail-row">
          <span class="calc-detail-label" id={`dilim${i + 1}-label`}>{i + 1}. dilim</span>
          <span class="calc-detail-value" id={`dilim${i + 1}`}>—</span>
        </div>
      ))}
      <div class="calc-detail-row">
        <span class="calc-detail-label">Marjinal Vergi Oranı</span>
        <span class="calc-detail-value" id="marjinal-oran">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Ortalama (Efektif) Vergi Oranı</span>
        <span class="calc-detail-value" id="ortalama-oran">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Vergi Sonrası Kalan</span>
        <span class="calc-detail-value" id="vergi-sonrasi">—</span>
      </div>
      <p class="calc-note">2026 tarifesi (332 Seri No'lu GVGT). Ücretlilerde asgari ücret istisnası bu hesaba dahil değildir; aylık bordro için Net Brüt Maaş Hesaplama aracını kullanın.</p>
    </div>
  </CalcResult>

  <script type="application/json" id="tax-data" set:html={JSON.stringify({ ucret: taxBrackets.ucret, ucretDisi: taxBrackets.ucretDisi })}></script>

  <script>
    import { formatTL, formatPercent, readNumber, readValue, readJSON, setText, showResult, initCalculator, progressiveTax, marginalRate, type Bracket } from './_shared';

    const tariffs = readJSON<{ ucret: Bracket[]; ucretDisi: Bracket[] }>('tax-data');
    const fmtInt = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(n);

    function calculate(): boolean {
      const gelir = readNumber('yillikGelir');
      const tur = readValue('gelirTuru') === 'ucretDisi' ? 'ucretDisi' : 'ucret';
      const brackets = tariffs[tur];

      let prev = 0;
      brackets.forEach((b, i) => {
        const range = b.upTo === null ? `${fmtInt(prev)} TL üzeri` : `${fmtInt(prev)} – ${fmtInt(b.upTo)} TL`;
        setText(`dilim${i + 1}-label`, `%${b.rate} (${range})`);
        prev = b.upTo ?? prev;
      });

      if (!(gelir > 0)) {
        showResult(false);
        return false;
      }

      const { total, perBracket } = progressiveTax(gelir, brackets);
      perBracket.forEach((t, i) => setText(`dilim${i + 1}`, formatTL(t)));
      setText('toplam-vergi', formatTL(total));
      setText('marjinal-oran', `%${marginalRate(gelir, brackets)}`);
      setText('ortalama-oran', formatPercent((total / gelir) * 100));
      setText('vergi-sonrasi', formatTL(gelir - total));

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Gelir Vergisi Nasıl Hesaplanır?</h2>
    <p>
      Türkiye'de gelir vergisi artan oranlı bir tarifeyle alınır. Matrah dilimlere bölünür ve her parçaya yalnızca kendi diliminin oranı uygulanır. Bu nedenle bir üst dilime geçmek, tüm gelirin daha yüksek orandan vergilendirilmesi anlamına gelmez; sadece sınırı aşan kısım yüksek oranla vergilenir.
    </p>

    <h2>2026 Gelir Vergisi Tarifesi</h2>
    <h3>Ücret gelirleri</h3>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Matrah</th><th scope="col">Oran</th><th scope="col">Vergi</th></tr></thead>
        <tbody>
          <tr><td>190.000 TL'ye kadar</td><td>%15</td><td>Matrahın %15'i</td></tr>
          <tr><td>400.000 TL'ye kadar</td><td>%20</td><td>190.000 TL için 28.500 TL, fazlası %20</td></tr>
          <tr><td>1.500.000 TL'ye kadar</td><td>%27</td><td>400.000 TL için 70.500 TL, fazlası %27</td></tr>
          <tr><td>5.300.000 TL'ye kadar</td><td>%35</td><td>1.500.000 TL için 367.500 TL, fazlası %35</td></tr>
          <tr><td>5.300.000 TL'den fazlası</td><td>%40</td><td>5.300.000 TL için 1.697.500 TL, fazlası %40</td></tr>
        </tbody>
      </table>
    </div>
    <h3>Ücret dışı gelirler</h3>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Matrah</th><th scope="col">Oran</th><th scope="col">Vergi</th></tr></thead>
        <tbody>
          <tr><td>190.000 TL'ye kadar</td><td>%15</td><td>Matrahın %15'i</td></tr>
          <tr><td>400.000 TL'ye kadar</td><td>%20</td><td>190.000 TL için 28.500 TL, fazlası %20</td></tr>
          <tr><td>1.000.000 TL'ye kadar</td><td>%27</td><td>400.000 TL için 70.500 TL, fazlası %27</td></tr>
          <tr><td>5.300.000 TL'ye kadar</td><td>%35</td><td>1.000.000 TL için 232.500 TL, fazlası %35</td></tr>
          <tr><td>5.300.000 TL'den fazlası</td><td>%40</td><td>5.300.000 TL için 1.737.500 TL, fazlası %40</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Örnek Hesaplama</h2>
    <p>
      Yıllık ücret matrahı 500.000 TL olan bir çalışanın vergisi şöyle bulunur: ilk 190.000 TL için 28.500 TL, 190.000–400.000 TL arasındaki 210.000 TL için %20'den 42.000 TL, kalan 100.000 TL için %27'den 27.000 TL. Toplam vergi <strong>97.500 TL</strong>, ortalama oran %19,5, marjinal oran %27'dir.
    </p>
    <p>
      Aynı 500.000 TL kira geliri gibi ücret dışı bir gelir olsaydı da sonuç değişmezdi; fark ancak matrah 1.000.000 TL'yi aştığında ortaya çıkar. Örneğin 1.200.000 TL matrahta ücret tarifesiyle vergi 286.500 TL, ücret dışı tarifeyle 302.500 TL'dir.
    </p>

    <h2>Matrahı Doğru Belirlemek</h2>
    <ul>
      <li><strong>Ücret:</strong> brüt ücretten SGK ve işsizlik primi düşülen tutar matrahtır. Ücretlilerde asgari ücret istisnası ayrıca uygulanır.</li>
      <li><strong>Kira geliri:</strong> konut kira istisnası (2026 gelirleri için 58.000 TL) ile götürü (%15) veya gerçek gider düşülür.</li>
      <li><strong>Serbest meslek ve ticari kazanç:</strong> gelirden giderler düşülür; bağış, sağlık ve eğitim harcamaları gibi indirimler de matrahı azaltır.</li>
      <li>Yıl içinde kesilen stopajlar, beyanname üzerinden hesaplanan vergiden mahsup edilir.</li>
    </ul>
  </section>
</CalcLayout>
