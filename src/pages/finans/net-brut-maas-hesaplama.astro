---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import taxBrackets from '../../data/tax-brackets.json';
import minWage from '../../data/minimum-wage.json';

const fmt = (n: number, d = 2) =>
  new Intl.NumberFormat('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

const payrollData = {
  brackets: taxBrackets.ucret,
  minGross: minWage.grossMonthly,
  sgkWorker: minWage.rates.sgkWorker,
  unemploymentWorker: minWage.rates.unemploymentWorker,
  sgkEmployer: minWage.rates.sgkEmployer,
  unemploymentEmployer: minWage.rates.unemploymentEmployer,
  stampTax: minWage.rates.stampTax,
  sgkCeiling: minWage.sgkCeiling.monthly,
};

const aylar = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const ayOptions = aylar.map((a, i) => ({ value: String(i + 1), label: a }));

const asgariSgk = Math.round(minWage.grossMonthly * 14) / 100;
const asgariIssizlik = Math.round(minWage.grossMonthly * 1) / 100;

const meta = {
  title: "Net Brüt Maaş Hesaplama",
  seoTitle: "Net Brüt Maaş Hesaplama 2026 – Aylık Vergi ve SGK Kesintisi",
  description: "2026 net brüt maaş hesaplama: kümülatif vergi matrahı, asgari ücret istisnası, SGK tavanı ve işveren maliyetiyle Ocak–Aralık her ay için doğru net maaş.",
  summary: `2026'da net maaş; brüt ücretten %14 SGK işçi payı, %1 işsizlik sigortası, gelir vergisi (%15–%40) ve binde 7,59 damga vergisi düşülerek bulunur. Asgari ücrete isabet eden gelir ve damga vergisi alınmaz; bu yüzden ${fmt(minWage.grossMonthly)} TL brüt asgari ücretin neti ${fmt(minWage.netMonthly)} TL'dir. Kümülatif matrah arttıkça yılın son aylarında net maaş düşebilir.`,
  howTo: [
    "Brütten nete mi, netten brüte mi hesaplayacağınızı seçin.",
    "Aylık brüt ya da net ücret tutarını yazın.",
    "Hesaplamak istediğiniz ayı seçin; kümülatif vergi matrahı Ocak'tan itibaren aynı ücret alındığı varsayımıyla hesaplanır.",
    "İşvereninizin yararlandığı SGK prim indirimini seçerek işveren maliyetini görün.",
    "Sonuçların altındaki 12 aylık tabloda yıl içindeki net maaş değişimini inceleyin."
  ],
  sources: [
    { name: "Gelir İdaresi Başkanlığı – Gelir Vergisi Tarifesi", url: "https://www.gib.gov.tr/" },
    { name: "SGK – İşveren Prim Oranları (2026)", url: "https://www.sgk.gov.tr/Content/Post/c7812ea8-5087-413f-aeb5-d3c1d153e11a/Isveren-Prim-Oranlari-2026-01-13-04-52-38" },
    { name: "Çalışma ve Sosyal Güvenlik Bakanlığı", url: "https://www.csgb.gov.tr/" },
    { name: "193 sayılı Gelir Vergisi Kanunu (mevzuat.gov.tr)", url: "https://www.mevzuat.gov.tr/mevzuatmetin/1.4.193.pdf" }
  ],
  category: "finans",
  slug: "net-brut-maas-hesaplama",
  keywords: ["net brüt maaş hesaplama", "maaş hesaplama 2026", "brütten nete maaş", "netten brüte maaş", "SGK kesintisi", "işveren maliyeti", "kümülatif vergi matrahı"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/gelir-vergisi-hesaplama", "finans/kidem-tazminati-hesaplama", "finans/ihbar-tazminati-hesaplama", "finans/stopaj-hesaplama"],
  faq: [
    {
      question: "2026 asgari ücret net ne kadar?",
      answer: `2026 yılı için brüt asgari ücret ${fmt(minWage.grossMonthly)} TL, net asgari ücret ${fmt(minWage.netMonthly)} TL'dir. Brüt tutardan ${fmt(asgariSgk)} TL SGK işçi payı ve ${fmt(asgariIssizlik)} TL işsizlik sigortası primi kesilir. Asgari ücret gelir vergisi ve damga vergisinden istisna olduğu için başka kesinti yapılmaz. Temmuz 2026'da ara zam yapılmadı; bu tutarlar yıl sonuna kadar geçerlidir.`
    },
    {
      question: "Brüt maaştan net maaş nasıl hesaplanır?",
      answer: "Brüt ücretten önce %14 SGK işçi payı ve %1 işsizlik sigortası primi düşülür; kalan tutar gelir vergisi matrahıdır. Bu matraha kümülatif dilime göre %15–%40 gelir vergisi uygulanır, asgari ücrete isabet eden vergi istisna olarak düşülür. Son olarak brüt ücretin binde 7,59'u damga vergisi olarak hesaplanıp asgari ücretin damga vergisi kadar indirilir."
    },
    {
      question: "Net maaşım neden yılın ikinci yarısında düşüyor?",
      answer: "Gelir vergisi yıllık kümülatif matrah üzerinden hesaplanır. Ocak'tan itibaren biriken matrah 190.000 TL'yi aşınca %20, 400.000 TL'yi aşınca %27 dilime geçersiniz. Brüt ücretiniz değişmese bile ödenen vergi artar ve net maaş düşer. Asgari ücret istisnası da kendi kümülatifiyle Temmuz'da %20 dilime geçtiği için bu düşüşün bir kısmını telafi eder."
    },
    {
      question: "2026 SGK tavan ücreti ne kadar?",
      answer: `2026'da prime esas kazanç üst sınırı asgari ücretin 7,5 katından 9 katına çıkarıldı ve aylık ${fmt(minWage.sgkCeiling.monthly)} TL oldu (günlük ${fmt(minWage.sgkCeiling.daily)} TL). Bu tutarın üzerindeki brüt ücret için SGK ve işsizlik primi kesilmez, ancak gelir vergisi ve damga vergisi tüm brüt üzerinden hesaplanır.`
    },
    {
      question: "2026'da işverenin SGK prim oranı kaç?",
      answer: "2026'da SGK işveren payı teşviksiz %21,75, işsizlik sigortası işveren payı %2'dir. 5510 sayılı Kanun'daki Hazine desteğiyle imalat sektöründe 5 puan, diğer sektörlerde 2 puan indirim uygulanır. Bu nedenle asgari ücretli bir çalışanın işverene maliyeti imalatta 39.223,13 TL, diğer sektörlerde 40.214,03 TL'dir."
    },
    {
      question: "Netten brüte maaş nasıl hesaplanır?",
      answer: "Net ücretten brüte geçerken vergi dilimi ve istisna tutarı brüte bağlı olduğundan doğrudan bir formül yoktur. Hesaplayıcımız, seçtiğiniz ayda hedef net tutarı veren brüt ücreti deneme yoluyla kuruş hassasiyetinde bulur. Aynı net ücret yılın ilerleyen aylarında daha yüksek bir brüt gerektirir; iş teklifi değerlendirirken bunu göz önünde bulundurun."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="hesapTuru"
      label="Hesaplama Türü"
      options={[
        { value: "brutten", label: "Brütten nete" },
        { value: "netten", label: "Netten brüte" },
      ]}
      value="brutten"
    />
    <CalcInput
      id="tutar"
      label="Aylık Ücret"
      type="number"
      suffix="₺"
      placeholder="50000"
      step="any"
      min={0}
      helpText="Brütten nete için brüt, netten brüte için net tutarı girin"
    />
    <CalcSelect
      id="ay"
      label="Hesaplanacak Ay"
      options={ayOptions}
      value="1"
      helpText="Ocak'tan itibaren aynı ücret alındığı varsayılır"
    />
    <CalcSelect
      id="tesvik"
      label="İşveren SGK Prim İndirimi"
      options={[
        { value: "2", label: "2 puan (genel, imalat dışı)" },
        { value: "5", label: "5 puan (imalat sektörü)" },
        { value: "0", label: "İndirim yok" },
      ]}
      value="2"
      helpText="Yalnızca işveren maliyetini etkiler"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label" id="sonuc-etiket">Net Maaş</p>
      <p class="calc-result-value" id="sonuc-ana">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Brüt Maaş</span>
        <span class="calc-detail-value" id="brut">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">SGK İşçi Payı (%14)</span>
        <span class="calc-detail-value" id="sgk-isci">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">İşsizlik Sigortası İşçi Payı (%1)</span>
        <span class="calc-detail-value" id="issizlik-isci">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Gelir Vergisi Matrahı</span>
        <span class="calc-detail-value" id="gv-matrah">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Kümülatif Matrah / Dilim</span>
        <span class="calc-detail-value" id="kumulatif">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Hesaplanan Gelir Vergisi</span>
        <span class="calc-detail-value" id="gv-hesaplanan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Asgari Ücret GV İstisnası</span>
        <span class="calc-detail-value" id="gv-istisna">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Ödenecek Gelir Vergisi</span>
        <span class="calc-detail-value" id="gelir-vergisi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Damga Vergisi (istisna sonrası)</span>
        <span class="calc-detail-value" id="damga-vergisi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Kesinti</span>
        <span class="calc-detail-value" id="toplam-kesinti">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label" id="sgk-isveren-label">SGK İşveren Payı</span>
        <span class="calc-detail-value" id="sgk-isveren">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">İşsizlik Sigortası İşveren Payı (%2)</span>
        <span class="calc-detail-value" id="issizlik-isveren">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam İşveren Maliyeti</span>
        <span class="calc-detail-value" id="toplam-isveren">—</span>
      </div>

      <div class="calc-table-wrap">
        <table class="calc-table">
          <caption>Aynı ücretle 2026 yılı aylık dağılım</caption>
          <thead>
            <tr>
              <th scope="col">Ay</th>
              <th scope="col">Brüt</th>
              <th scope="col">Gelir Vergisi</th>
              <th scope="col">Net</th>
              <th scope="col">Dilim</th>
            </tr>
          </thead>
          <tbody id="aylik-tablo"></tbody>
          <tfoot>
            <tr>
              <th scope="row">Yıllık</th>
              <td id="yillik-brut">—</td>
              <td id="yillik-gv">—</td>
              <td id="yillik-net">—</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="calc-note">
        2026 parametreleri: brüt asgari ücret {fmt(minWage.grossMonthly)} TL, SGK tavanı {fmt(minWage.sgkCeiling.monthly)} TL, ücret gelirleri tarifesi (332 Seri No'lu GVGT). Engelli indirimi, BES kesintisi ve SGK tavanını aşan matrahın devri dikkate alınmaz.
      </p>
    </div>
  </CalcResult>

  <script type="application/json" id="payroll-data" set:html={JSON.stringify(payrollData)}></script>

  <script>
    import { formatTL, formatNumber, readNumber, readValue, readJSON, setText, showResult, initCalculator } from './_shared';
    import { yearlyPayroll, grossForNet, type PayrollParams } from './_payroll';

    const data = readJSON<PayrollParams>('payroll-data');
    const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];

    function calculate(): boolean {
      const mode = readValue('hesapTuru') === 'netten' ? 'netten' : 'brutten';
      const tutar = readNumber('tutar');
      const ay = Math.min(12, Math.max(1, Math.round(readNumber('ay')) || 1));
      const tesvik = readNumber('tesvik') || 0;

      if (!(tutar > 0)) {
        showResult(false);
        return false;
      }

      const brut = mode === 'netten' ? grossForNet(tutar, ay, data) : tutar;
      const yil = yearlyPayroll(brut, data, tesvik);
      const r = yil[ay - 1];

      setText('sonuc-etiket', mode === 'netten' ? `Gerekli Brüt Maaş (${AYLAR[ay - 1]})` : `Net Maaş (${AYLAR[ay - 1]})`);
      setText('sonuc-ana', formatTL(mode === 'netten' ? r.gross : r.net));
      setText('brut', formatTL(r.gross));
      setText('sgk-isci', formatTL(r.sgkWorker));
      setText('issizlik-isci', formatTL(r.unemploymentWorker));
      setText('gv-matrah', formatTL(r.taxBase));
      setText('kumulatif', `${formatTL(r.cumulativeTaxBase)} / %${r.marginalRate}`);
      setText('gv-hesaplanan', formatTL(r.incomeTaxCalculated));
      setText('gv-istisna', formatTL(r.incomeTaxExemption));
      setText('gelir-vergisi', formatTL(r.incomeTax));
      setText('damga-vergisi', formatTL(r.stampTax));
      setText('toplam-kesinti', formatTL(r.sgkWorker + r.unemploymentWorker + r.incomeTax + r.stampTax));
      setText('sgk-isveren-label', `SGK İşveren Payı (%${formatNumber(Math.max(0, data.sgkEmployer - tesvik), 2).replace(/,00$/, '')})`);
      setText('sgk-isveren', formatTL(r.sgkEmployer));
      setText('issizlik-isveren', formatTL(r.unemploymentEmployer));
      setText('toplam-isveren', formatTL(r.employerCost));

      const tbody = document.getElementById('aylik-tablo');
      if (tbody) {
        tbody.replaceChildren(
          ...yil.map((m) => {
            const tr = document.createElement('tr');
            if (m.month === ay) tr.className = 'is-active';
            const cells = [AYLAR[m.month - 1], formatTL(m.gross), formatTL(m.incomeTax), formatTL(m.net), `%${m.marginalRate}`];
            cells.forEach((c, i) => {
              const cell = document.createElement(i === 0 ? 'th' : 'td');
              if (i === 0) cell.setAttribute('scope', 'row');
              cell.textContent = c;
              tr.appendChild(cell);
            });
            return tr;
          })
        );
      }
      const sum = (k: 'gross' | 'incomeTax' | 'net') => yil.reduce((a, m) => a + m[k], 0);
      setText('yillik-brut', formatTL(sum('gross')));
      setText('yillik-gv', formatTL(sum('incomeTax')));
      setText('yillik-net', formatTL(sum('net')));

      showResult(true);
      return true;
    }

    initCalculator({
      calculate,
      onParams: (params) => {
        // Eski paylaşım linkleri: ?brutMaas=...
        const eski = params.get('brutMaas');
        const tutarEl = document.getElementById('tutar') as HTMLInputElement | null;
        if (eski && tutarEl && !params.has('tutar')) {
          tutarEl.value = eski;
          (document.getElementById('hesapTuru') as HTMLSelectElement).value = 'brutten';
        }
        const ayEl = document.getElementById('ay') as HTMLSelectElement | null;
        if (ayEl && !params.has('ay')) ayEl.value = String(new Date().getMonth() + 1);
        if (eski && !params.has('tutar')) calculate();
      },
    });
  </script>

  <section class="calc-content">
    <h2>2026'da Net Maaş Nasıl Hesaplanır?</h2>
    <p>
      Bordroda brüt ücretten dört kesinti yapılır: SGK işçi payı (%14), işsizlik sigortası işçi payı (%1), gelir vergisi ve damga vergisi (binde 7,59). SGK ve işsizlik primleri, 2026'da aylık {fmt(minWage.sgkCeiling.monthly)} TL olan prime esas kazanç üst sınırına kadar olan kısım için kesilir. Gelir vergisi ise brüt ücretten SGK ve işsizlik primleri düşüldükten sonra kalan matraha, yıl başından itibaren biriken <strong>kümülatif matrah</strong> dikkate alınarak uygulanır.
    </p>
    <p>
      2022'den bu yana asgari ücrete isabet eden gelir vergisi ve damga vergisi herkes için istisnadır. Yani asgari ücretin üzerinde kazanan bir çalışan da, hesaplanan vergisinden asgari ücretin vergisi kadar indirim alır. Bu istisna tutarı da asgari ücretin kendi kümülatif matrahına göre hesaplandığından yıl içinde değişir.
    </p>

    <h2>2026 Ücret Gelirleri Vergi Dilimleri</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead>
          <tr><th scope="col">Yıllık kümülatif matrah</th><th scope="col">Oran</th><th scope="col">Dilim başına vergi</th></tr>
        </thead>
        <tbody>
          <tr><td>190.000 TL'ye kadar</td><td>%15</td><td>28.500 TL'ye kadar</td></tr>
          <tr><td>190.000 – 400.000 TL</td><td>%20</td><td>+42.000 TL (toplam 70.500 TL)</td></tr>
          <tr><td>400.000 – 1.500.000 TL</td><td>%27</td><td>+297.000 TL (toplam 367.500 TL)</td></tr>
          <tr><td>1.500.000 – 5.300.000 TL</td><td>%35</td><td>+1.330.000 TL (toplam 1.697.500 TL)</td></tr>
          <tr><td>5.300.000 TL üzeri</td><td>%40</td><td>—</td></tr>
        </tbody>
      </table>
    </div>

    <h2>2026 Asgari Ücret Bordrosu</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <tbody>
          <tr><th scope="row">Brüt asgari ücret</th><td>{fmt(minWage.grossMonthly)} TL</td></tr>
          <tr><th scope="row">SGK işçi payı (%14)</th><td>{fmt(asgariSgk)} TL</td></tr>
          <tr><th scope="row">İşsizlik sigortası işçi payı (%1)</th><td>{fmt(asgariIssizlik)} TL</td></tr>
          <tr><th scope="row">Gelir vergisi / damga vergisi</th><td>İstisna (0 TL)</td></tr>
          <tr><th scope="row">Net asgari ücret</th><td>{fmt(minWage.netMonthly)} TL</td></tr>
          <tr><th scope="row">İşveren maliyeti (imalat, 5 puan indirim)</th><td>{fmt(minWage.employerCostManufacturing)} TL</td></tr>
          <tr><th scope="row">İşveren maliyeti (diğer sektörler, 2 puan indirim)</th><td>{fmt(minWage.employerCostGeneral)} TL</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Örnek Hesaplama: 50.000 TL Brüt Maaş</h2>
    <p>
      Ocak 2026'da 50.000 TL brüt maaş alan bir çalışan için SGK işçi payı 7.000 TL, işsizlik primi 500 TL'dir. Gelir vergisi matrahı 42.500 TL olur ve %15 ile 6.375 TL vergi hesaplanır. Asgari ücret istisnası (4.211,33 TL) düşülünce ödenecek gelir vergisi 2.163,67 TL'ye iner. Damga vergisi 379,50 TL'den asgari ücretin damga vergisi 250,70 TL düşülerek 128,80 TL olur. Böylece net maaş <strong>40.207,53 TL</strong> çıkar.
    </p>
    <p>
      Aynı çalışanın kümülatif matrahı Mayıs'ta 190.000 TL'yi geçer ve %20 dilime girer. Ekim'de ise 400.000 TL'yi aşarak %27 dilime geçer; Kasım ve Aralık'ta net maaş 36.511,30 TL'ye düşer. Yukarıdaki tablo bu değişimi ay ay gösterir.
    </p>

    <h2>İşveren Maliyeti Nasıl Oluşur?</h2>
    <p>
      2026'da malullük, yaşlılık ve ölüm sigortası işveren hissesi 1 puan artırıldı; teşviksiz SGK işveren payı %21,75, işsizlik sigortası işveren payı %2 oldu. Primlerini zamanında ödeyen işverenler imalat sektöründe 5 puan, diğer sektörlerde 2 puan Hazine indiriminden yararlanır. Toplam işveren maliyeti; brüt ücret, indirim sonrası SGK işveren payı ve işsizlik işveren payının toplamıdır.
    </p>

    <h3>Hesaplamanın Varsayımları</h3>
    <ul>
      <li>Ocak'tan seçilen aya kadar her ay aynı brüt ücretin ödendiği kabul edilir. Yıl içinde zam aldıysanız gerçek kümülatif matrahınız bordronuzda yazar.</li>
      <li>Prim, ikramiye, yol-yemek yardımı gibi ek ödemeler ve engellilik indirimi dahil değildir.</li>
      <li>Otomatik BES katkı payı (brütün %3'ü) net maaştan ayrıca kesilir; bu hesaplamaya eklenmemiştir.</li>
    </ul>
  </section>
</CalcLayout>
