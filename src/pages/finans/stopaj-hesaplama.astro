---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Stopaj nedir ve kim öder?",
    answer: "Stopaj (kaynakta vergi kesintisi), bir gelir veya ödeme üzerinden ödeme yapılırken doğrudan kesilen vergidir. Ödemeyi yapan taraf (işveren, şirket vb.) bu vergiyi keserek devlete yatırmakla yükümlüdür. Stopaj; kira, serbest meslek kazancı, mevduat faizi, temettü, ücret gibi pek çok gelir türüne uygulanabilir."
  },
  {
    question: "Stopaj oranları neye göre belirlenir?",
    answer: "Stopaj oranları gelirin türüne ve ödemenin yapıldığı kişi/kuruma göre değişir. Türkiye'de en yaygın stopaj oranları şunlardır: Kira geliri için %20, serbest meslek makbuzu için %20, mevduat faizi için %15, temettü için %10, işçi ücretleri içinse gelir vergisi dilimlerine göre farklı oranlar uygulanır."
  },
  {
    question: "Stopaj brüt tutardan mı hesaplanır?",
    answer: "Evet, stopaj her zaman brüt tutar üzerinden hesaplanır. Örneğin serbest meslek sahibine yapılan 10.000 TL brüt ödemede %20 stopaj uygulanırsa, 2.000 TL devlete kesilir ve kişiye 8.000 TL net ödeme yapılır. Yıllık gelir vergisi beyannamesi verildiğinde ise ödenen stopaj, hesaplanan vergiden mahsup edilir."
  }
];

const meta = {
  title: "Stopaj Hesaplama",
  description: "Brüt tutardan stopaj vergisini ve net tutarı anında hesaplayın. Kira, serbest meslek ve diğer gelir türleri için stopaj hesaplama aracı.",
  category: "finans",
  slug: "stopaj-hesaplama",
  keywords: ["stopaj hesaplama", "stopaj vergisi", "kaynakta vergi kesintisi", "serbest meslek stopaj", "kira stopaj", "net brüt hesaplama"],
  dateModified: "2026-04-01",
  relatedCalcs: ["kdv-hesaplama", "net-brut-maas-hesaplama", "kredi-hesaplama"],
  faq
};
---

<CalcLayout meta={meta}>
  <form id="calc-form">
    <CalcInput
      id="brutTutar"
      label="Brüt Tutar"
      type="number"
      suffix="₺"
      placeholder="10000"
      step={100}
      min={0}
    />
    <CalcSelect
      id="stopajOrani"
      label="Stopaj Oranı"
      options={[
        { value: "0", label: "%0" },
        { value: "5", label: "%5" },
        { value: "10", label: "%10" },
        { value: "15", label: "%15" },
        { value: "20", label: "%20" },
        { value: "25", label: "%25" },
        { value: "30", label: "%30" },
        { value: "35", label: "%35" },
        { value: "40", label: "%40" }
      ]}
      value="15"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Net Tutar</p>
      <p class="calc-result-value" id="net-tutar">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Brüt Tutar</span>
        <span class="calc-detail-value" id="brut-tutar-result">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Stopaj Oranı</span>
        <span class="calc-detail-value" id="stopaj-oran-result">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Stopaj Tutarı</span>
        <span class="calc-detail-value" id="stopaj-tutari">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const inputs = document.querySelectorAll('#calc-form input, #calc-form select');
      const resultArea = document.getElementById('calc-result');

      function debounce(fn: (...args: unknown[]) => void, delay = 150) {
        let timer: ReturnType<typeof setTimeout>;
        return (...args: unknown[]) => {
          clearTimeout(timer);
          timer = setTimeout(() => fn(...args), delay);
        };
      }

      function formatTL(num: number) {
        return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
      }

      const debouncedCalc = debounce(calculate);
      inputs.forEach(input => {
        input.addEventListener('input', debouncedCalc);
        input.addEventListener('change', debouncedCalc);
      });

      function calculate() {
        const brutTutar = parseFloat((document.getElementById('brutTutar') as HTMLInputElement).value);
        const oran = parseFloat((document.getElementById('stopajOrani') as HTMLSelectElement).value);

        if (isNaN(brutTutar) || brutTutar <= 0) return;

        const stopajTutari = brutTutar * oran / 100;
        const netTutar = brutTutar - stopajTutari;

        (document.getElementById('net-tutar') as HTMLElement).textContent = formatTL(netTutar);
        (document.getElementById('brut-tutar-result') as HTMLElement).textContent = formatTL(brutTutar);
        (document.getElementById('stopaj-oran-result') as HTMLElement).textContent = `%${oran}`;
        (document.getElementById('stopaj-tutari') as HTMLElement).textContent = formatTL(stopajTutari);

        if (resultArea) resultArea.classList.remove('hidden');
        updateURL();
      }

      function updateURL() {
        const params = new URLSearchParams();
        inputs.forEach(input => {
          const el = input as HTMLInputElement;
          if (el.value && el.value !== '' && el.id) {
            params.set(el.id, el.value);
          }
        });
        history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
      }

      function loadFromURL() {
        const params = new URLSearchParams(window.location.search);
        let hasParams = false;
        inputs.forEach(input => {
          const el = input as HTMLInputElement;
          if (el.id && params.has(el.id)) {
            el.value = params.get(el.id)!;
            hasParams = true;
          }
        });
        if (hasParams) calculate();
      }

      loadFromURL();
    });
  </script>

  <section class="calc-content">
    <h2>Stopaj Nedir?</h2>
    <p>
      Stopaj, Türk vergi mevzuatında "kaynakta kesilen vergi" olarak da bilinir. Bir ödeme yapılırken alıcıya para aktarılmadan önce belirli bir oranda vergi kesilerek devlete yatırılması işlemine stopaj denir. Bu sistemin amacı vergi tahsilatını güvence altına almak ve vergi kaçakçılığını önlemektir.
    </p>
    <h2>Stopaj Hangi Gelir Türlerine Uygulanır?</h2>
    <p>
      Türkiye'de stopaj çok geniş bir gelir yelpazesine uygulanmaktadır:
    </p>
    <ul>
      <li><strong>Kira gelirleri:</strong> İş yeri kira ödemelerinde %20 stopaj uygulanır.</li>
      <li><strong>Serbest meslek kazançları:</strong> Avukat, mimar, danışman gibi serbest meslek erbabına yapılan ödemelerde %20 oranında stopaj kesilir.</li>
      <li><strong>Mevduat faizleri:</strong> Banka mevduatı faizleri üzerinden %15 stopaj uygulanır.</li>
      <li><strong>Temettü (kâr payı) gelirleri:</strong> Şirket kâr payı dağıtımında %10 stopaj söz konusudur.</li>
      <li><strong>Ücret gelirleri:</strong> Çalışan ücretlerinde gelir vergisi stopajı, dilim oranlarına göre kesilir.</li>
    </ul>
    <h2>Stopaj Nasıl Hesaplanır?</h2>
    <p>
      Stopaj hesaplama oldukça basittir: <strong>Stopaj Tutarı = Brüt Tutar × Stopaj Oranı / 100</strong>. Net tutar ise brüt tutardan stopaj tutarının çıkarılmasıyla bulunur. Örneğin 15.000 TL brüt serbest meslek ödemesinde %20 stopaj uygulandığında 3.000 TL kesilir ve kişiye 12.000 TL net ödeme yapılır.
    </p>
    <h2>Yıllık Beyanname ve Mahsup</h2>
    <p>
      Yıl içinde ödenen stopaj tutarları, yıllık gelir vergisi beyannamesi verildiğinde hesaplanan vergiden düşülür. Fazla stopaj ödenmişse vergi dairesi bu tutarı iade eder. Bu nedenle stopaj, kesin bir vergi değil; yıl sonunda nihai vergi borcu hesaplanana kadar devlete yapılan bir ön ödeme niteliğindedir.
    </p>
    <h2>Stopaj Beyanı ve Sorumluluğu</h2>
    <p>
      Stopajı kesmek ve devlete ödemekle yükümlü olan taraf, ödemeyi gerçekleştiren kişi ya da kurumdur. Muhtasar ve prim hizmetleri beyannamesi aracılığıyla her ay veya üç ayda bir vergi dairesine bildirilir. Stopaj yükümlülüğünü yerine getirmeyen işverenler veya şirketler cezai yaptırımlarla karşılaşabilir.
    </p>

    <h2>Sık Sorulan Sorular</h2>
    {faq.map(item => (
      <details>
        <summary><strong>{item.question}</strong></summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </section>
</CalcLayout>
