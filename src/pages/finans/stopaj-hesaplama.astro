---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const stopajOranlari = [
  { value: "20", label: "%20 – Serbest meslek, işyeri kirası" },
  { value: "17.5", label: "%17,5 – 6 aya kadar TL mevduat" },
  { value: "15", label: "%15 – Kâr payı (temettü), 1 yıla kadar mevduat" },
  { value: "10", label: "%10 – 1 yıldan uzun vadeli mevduat" },
  { value: "5", label: "%5 – Yıllara yaygın inşaat hakedişi" },
  { value: "0", label: "%0" },
];

const meta = {
  title: "Stopaj Hesaplama",
  seoTitle: "Stopaj Hesaplama 2026 – Brütten Nete, Netten Brüte",
  description: "Stopaj hesaplama 2026: serbest meslek, işyeri kirası, temettü ve mevduat için güncel stopaj oranlarıyla brütten nete ve netten brüte tutarı anında bulun.",
  summary: "Stopaj, ödeme yapılırken brüt tutardan kesilen vergidir: Stopaj = Brüt × Oran, Net = Brüt − Stopaj. Netten brüte geçmek için Brüt = Net ÷ (1 − Oran) kullanılır. 2026'da serbest meslek ve işyeri kirasında oran %20'dir; örneğin 10.000 TL net kira için brüt 12.500 TL, stopaj 2.500 TL'dir.",
  howTo: [
    "Elinizdeki tutarın brüt mü net mi olduğunu seçin.",
    "Tutarı girin.",
    "Gelir türüne uygun stopaj oranını seçin.",
    "Brüt tutarı, stopaj kesintisini ve net ödemeyi görün."
  ],
  sources: [
    { name: "193 sayılı Gelir Vergisi Kanunu md. 94 (mevzuat.gov.tr)", url: "https://www.mevzuat.gov.tr/mevzuatmetin/1.4.193.pdf" },
    { name: "10041 sayılı Cumhurbaşkanı Kararı – mevduat stopaj oranları (Resmî Gazete)", url: "https://www.resmigazete.gov.tr/eskiler/2025/07/20250709-6.pdf" },
    { name: "Gelir İdaresi Başkanlığı", url: "https://www.gib.gov.tr/" }
  ],
  category: "finans",
  slug: "stopaj-hesaplama",
  keywords: ["stopaj hesaplama", "stopaj oranları 2026", "kira stopajı hesaplama", "serbest meslek stopaj", "netten brüte stopaj", "temettü stopajı"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/kdv-hesaplama", "finans/gelir-vergisi-hesaplama", "finans/mevduat-faizi-hesaplama", "finans/kira-artis-hesaplama"],
  faq: [
    {
      question: "İşyeri kira stopajı nasıl hesaplanır?",
      answer: "Bir şirket veya işletme, gerçek kişiden işyeri kiraladığında brüt kira üzerinden %20 stopaj keser ve vergi dairesine öder. Sözleşmede net kira yazıyorsa brüt kira = net ÷ 0,80 formülüyle bulunur. Örneğin 40.000 TL net kira için brüt kira 50.000 TL, stopaj 10.000 TL'dir."
    },
    {
      question: "Serbest meslek makbuzunda stopaj oranı kaç?",
      answer: "Avukat, mali müşavir, doktor, mimar gibi serbest meslek erbabına işletmelerin yaptığı ödemelerde gelir vergisi stopajı %20'dir. Makbuzda brüt ücret, %20 stopaj ve net ödeme ayrı ayrı gösterilir. Ayrıca KDV mükellefi olan serbest meslek erbabı brüt ücret üzerinden %20 KDV hesaplar."
    },
    {
      question: "2026 mevduat faizi stopaj oranları nedir?",
      answer: "Temmuz 2025'te yürürlüğe giren ve süresi 31 Aralık 2026'ya uzatılan Cumhurbaşkanı Kararı'na göre TL mevduatta stopaj; 6 aya kadar vadelerde %17,5, 1 yıla kadar vadelerde %15, 1 yıldan uzun vadelerde %10'dur. Oranlar, hesap açılış veya vade yenileme tarihinde geçerli olan karara göre uygulanır."
    },
    {
      question: "Temettü stopajı yüzde kaç?",
      answer: "22 Aralık 2024'te yayımlanan 9286 sayılı Cumhurbaşkanı Kararı ile tam mükellef kurumların gerçek kişi ortaklara dağıttığı kâr payları üzerindeki stopaj oranı %10'dan %15'e çıkarıldı. 2026'da da %15 uygulanmaktadır."
    },
    {
      question: "Konut kirasında stopaj var mı?",
      answer: "Bireyin bireye kiraladığı konutta stopaj yoktur; ev sahibi kira gelirini yıllık beyannameyle bildirir. Stopaj, kiracının şirket, esnaf ya da kamu kurumu gibi bir vergi sorumlusu olduğu ve kiralamanın bu kişinin faaliyetiyle ilgili olduğu durumlarda uygulanır; tipik örnek işyeri kiralarıdır. Özel durumlarda (ör. şirketin personeline lojman kiralaması) mali müşavirinize danışın."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="hesapTuru"
      label="Girilen Tutar"
      options={[
        { value: "brut", label: "Brüt tutar (stopaj dahil)" },
        { value: "net", label: "Net tutar (ele geçen)" },
      ]}
      value="brut"
    />
    <CalcInput
      id="brutTutar"
      label="Tutar"
      type="number"
      suffix="₺"
      placeholder="50000"
      step="any"
      min={0}
    />
    <CalcSelect
      id="stopajOrani"
      label="Stopaj Oranı"
      options={stopajOranlari}
      value="20"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label" id="ana-etiket">Net Tutar</p>
      <p class="calc-result-value" id="net-tutar">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Brüt Tutar</span>
        <span class="calc-detail-value" id="brut-tutar-result">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Stopaj Oranı</span>
        <span class="calc-detail-value" id="stopaj-oran-result">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Stopaj Tutarı</span>
        <span class="calc-detail-value" id="stopaj-tutari">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Net Tutar</span>
        <span class="calc-detail-value" id="net-tutar-result">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    import { formatTL, formatNumber, readNumber, readValue, setText, showResult, initCalculator, round2 } from './_shared';

    function calculate(): boolean {
      const tutar = readNumber('brutTutar');
      const oran = readNumber('stopajOrani');
      const mod = readValue('hesapTuru') === 'net' ? 'net' : 'brut';

      if (!(tutar > 0) || !(oran >= 0) || oran >= 100) {
        showResult(false);
        return false;
      }

      const brut = mod === 'net' ? round2(tutar / (1 - oran / 100)) : tutar;
      const stopaj = round2(brut * oran / 100);
      const net = round2(brut - stopaj);

      setText('ana-etiket', mod === 'net' ? 'Brüt Tutar' : 'Net Tutar');
      setText('net-tutar', formatTL(mod === 'net' ? brut : net));
      setText('brut-tutar-result', formatTL(brut));
      setText('stopaj-oran-result', `%${formatNumber(oran, 0, 2)}`);
      setText('stopaj-tutari', formatTL(stopaj));
      setText('net-tutar-result', formatTL(net));

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Stopaj Nedir?</h2>
    <p>
      Stopaj (vergi tevkifatı), bir ödemeyi yapan kişinin ya da kurumun, karşı tarafın vergisini ödeme anında kesip vergi dairesine yatırmasıdır. Kesilen tutar muhtasar ve prim hizmet beyannamesiyle beyan edilir. Parayı alan taraf yıllık beyanname veriyorsa, yıl içinde kesilen stopajı hesaplanan gelir vergisinden mahsup eder.
    </p>

    <h2>2026 Başlıca Stopaj Oranları</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Ödeme türü</th><th scope="col">Oran</th></tr></thead>
        <tbody>
          <tr><td>Serbest meslek ödemeleri (GVK 94/2-b)</td><td>%20</td></tr>
          <tr><td>Gerçek kişiden kiralanan işyeri kirası (GVK 94/5-a)</td><td>%20</td></tr>
          <tr><td>Kâr payı (temettü) dağıtımı</td><td>%15</td></tr>
          <tr><td>TL mevduat faizi – 6 aya kadar vade</td><td>%17,5</td></tr>
          <tr><td>TL mevduat faizi – 1 yıla kadar vade</td><td>%15</td></tr>
          <tr><td>TL mevduat faizi – 1 yıldan uzun vade</td><td>%10</td></tr>
          <tr><td>Yıllara yaygın inşaat ve onarım hakedişleri</td><td>%5</td></tr>
          <tr><td>Ücretler</td><td>Gelir vergisi tarifesine göre (%15–%40)</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Formüller</h2>
    <ul>
      <li><strong>Brütten nete:</strong> Stopaj = Brüt × Oran; Net = Brüt − Stopaj</li>
      <li><strong>Netten brüte:</strong> Brüt = Net ÷ (1 − Oran)</li>
    </ul>

    <h2>Örnek Hesaplama</h2>
    <p>
      Bir şirket, dükkân sahibine her ay eline 40.000 TL geçecek şekilde kira ödemek istiyor. %20 stopajlı işyeri kirasında brüt kira 40.000 ÷ 0,80 = <strong>50.000 TL</strong> olur. Şirket 10.000 TL stopajı ertesi ayın 26'sına kadar muhtasar beyannameyle öder, 40.000 TL'yi mülk sahibine aktarır. Mülk sahibi yıllık beyannamesinde 600.000 TL brüt kira gelirini beyan eder ve kesilen 120.000 TL'yi vergisinden düşer.
    </p>

    <h3>Stopaj ile KDV Aynı Şey mi?</h3>
    <p>
      Hayır. Stopaj gelir üzerinden alınan gelir vergisinin peşin tahsilidir ve net ödemeyi azaltır. KDV ise tüketim vergisidir ve brüt tutarın üzerine eklenir. Serbest meslek makbuzunda ikisi birlikte görülür: 10.000 TL brüt ücrete 2.000 TL KDV eklenir, 2.000 TL stopaj düşülür.
    </p>
  </section>
</CalcLayout>
