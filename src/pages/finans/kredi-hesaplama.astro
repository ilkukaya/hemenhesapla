---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import legal from '../../data/legal-2026.json';

const v = legal.krediVergileri;

const meta = {
  title: "Kredi Hesaplama",
  seoTitle: "Kredi Hesaplama 2026 – Aylık Taksit ve Ödeme Planı",
  description: "Kredi hesaplama 2026: ihtiyaç kredisi aylık taksitini KKDF ve BSMV dahil hesaplayın; toplam geri ödeme, toplam faiz, vergi yükü ve ay ay ödeme planını görün.",
  summary: `Aylık taksit, eşit taksit formülüyle hesaplanır: Taksit = K × r(1+r)^n ÷ ((1+r)^n − 1). İhtiyaç kredilerinde faizin üzerine %${v.tuketici.kkdf} KKDF ve %${v.tuketici.bsmv} BSMV eklendiği için r, aylık faiz × 1,30 olarak alınır. Örneğin 200.000 TL, %3,29 faiz ve 36 ay vadede aylık taksit 10.986,64 TL'dir.`,
  howTo: [
    "Çekmek istediğiniz kredi tutarını girin.",
    "Bankanın ilan ettiği aylık faiz oranını yazın (vergiler hariç oran).",
    "Vadeyi ay olarak girin.",
    "Kredi türünü seçin: ihtiyaç ve taşıt kredilerinde KKDF ve BSMV eklenir, konut kredisinde eklenmez.",
    "Aylık taksiti, toplam maliyeti ve ödeme planını inceleyin."
  ],
  sources: [
    { name: "TCMB – Para Politikası Kurulu kararları (2026)", url: "https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Temel+Faaliyetler/Para+Politikasi/PPK/2026" },
    { name: "BDDK", url: "https://www.bddk.org.tr/" }
  ],
  category: "finans",
  slug: "kredi-hesaplama",
  keywords: ["kredi hesaplama", "ihtiyaç kredisi hesaplama", "kredi taksit hesaplama", "KKDF BSMV hesaplama", "kredi ödeme planı", "kredi faiz hesaplama 2026"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/konut-kredisi-hesaplama", "finans/tasit-kredisi-hesaplama", "finans/mevduat-faizi-hesaplama", "finans/net-brut-maas-hesaplama"],
  faq: [
    {
      question: "Kredi taksiti nasıl hesaplanır?",
      answer: "Türkiye'de tüketici kredileri eşit taksitli ödenir. Taksit = Kredi × r × (1+r)^n ÷ ((1+r)^n − 1) formülünde r aylık oran, n vade sayısıdır. İhtiyaç ve taşıt kredilerinde r, akdi faizin 1,30 katıdır çünkü faiz üzerinden %15 KKDF ve %15 BSMV alınır. İlk taksitlerde faiz payı yüksek, ana para payı düşüktür."
    },
    {
      question: "KKDF ve BSMV nedir, ne kadar?",
      answer: "KKDF (Kaynak Kullanımını Destekleme Fonu) ve BSMV (Banka ve Sigorta Muameleleri Vergisi), bireysel kredilerde her taksitteki faiz tutarı üzerinden alınır. İhtiyaç ve taşıt kredilerinde her ikisi de %15'tir. Konut kredileri KKDF ve BSMV'den muaftır. Bu vergiler bankaya değil devlete gider ama taksite dahildir."
    },
    {
      question: "100.000 TL kredinin aylık taksiti ne kadar?",
      answer: "Aylık %3,29 faiz ve 12 ay vadeli bir ihtiyaç kredisinde KKDF ve BSMV dahil taksit yaklaşık 10.827 TL, 36 ay vadede yaklaşık 5.493 TL'dir. Uzun vade taksiti düşürür ama toplam faizi artırır. Kendi bankanızın oranını girerek kesin tutarı hesaplayabilirsiniz."
    },
    {
      question: "Kredi erken kapatılırsa faiz indirimi yapılır mı?",
      answer: "Evet. Tüketici kredisini erken kapatan ya da ara ödeme yapan tüketiciye, ödenmeyen dönemlere ait faiz ve masraflar indirilir. Sabit faizli kredilerde banka, 6502 sayılı Tüketicinin Korunması Hakkında Kanun'daki sınırlar içinde erken ödenen tutarın küçük bir yüzdesi kadar erken ödeme tazminatı isteyebilir; kesin oranı sözleşmenizde bulabilirsiniz."
    },
    {
      question: "Yıllık maliyet oranı nedir?",
      answer: "Yıllık maliyet oranı, faizin yanında KKDF, BSMV, dosya masrafı ve sigorta gibi tüm maliyetleri içeren toplam oran olup bankalar sözleşme öncesi bilgi formunda göstermek zorundadır. Farklı bankaları karşılaştırırken yalnızca aylık faiz oranına değil, yıllık maliyet oranına ve toplam geri ödeme tutarına bakmak gerekir."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="tutar"
      label="Kredi Tutarı"
      type="number"
      suffix="₺"
      placeholder="200000"
      step="any"
      min={0}
    />
    <CalcInput
      id="faiz"
      label="Aylık Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="3.29"
      step="any"
      min={0}
      helpText="Vergiler hariç akdi faiz oranı"
    />
    <CalcInput
      id="vade"
      label="Vade"
      type="number"
      suffix="ay"
      placeholder="36"
      step={1}
      min={1}
      max={360}
    />
    <CalcSelect
      id="krediTuru"
      label="Kredi Türü"
      options={[
        { value: "tuketici", label: `İhtiyaç / taşıt (KKDF %${v.tuketici.kkdf} + BSMV %${v.tuketici.bsmv})` },
        { value: "vergisiz", label: "Konut / vergisiz" },
      ]}
      value="tuketici"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Aylık Taksit</p>
      <p class="calc-result-value" id="aylik-taksit">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Geri Ödeme</span>
        <span class="calc-detail-value" id="toplam-odeme">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Faiz</span>
        <span class="calc-detail-value" id="toplam-faiz">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam KKDF</span>
        <span class="calc-detail-value" id="toplam-kkdf">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam BSMV</span>
        <span class="calc-detail-value" id="toplam-bsmv">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Vergiler Dahil Aylık Oran</span>
        <span class="calc-detail-value" id="efektif-oran">—</span>
      </div>
      <div class="calc-table-wrap">
        <table class="calc-table">
          <caption>Ödeme planı</caption>
          <thead>
            <tr><th scope="col">Ay</th><th scope="col">Taksit</th><th scope="col">Ana para</th><th scope="col">Faiz</th><th scope="col">KKDF+BSMV</th><th scope="col">Kalan</th></tr>
          </thead>
          <tbody id="odeme-plani"></tbody>
        </table>
      </div>
      <p class="calc-note">Dosya masrafı ve sigorta primleri dahil değildir. Bankanızın sözleşme öncesi bilgi formundaki tutarlar esas alınır.</p>
    </div>
  </CalcResult>

  <script type="application/json" id="kredi-data" set:html={JSON.stringify(v)}></script>

  <script>
    import { formatTL, formatPercent, readNumber, readValue, readJSON, setText, showResult, initCalculator } from './_shared';
    import { amortize, renderSchedule } from './_loan';

    const vergiler = readJSON<Record<string, { kkdf: number; bsmv: number }>>('kredi-data');

    function calculate(): boolean {
      const tutar = readNumber('tutar');
      const faiz = readNumber('faiz');
      const vade = Math.round(readNumber('vade'));
      const tur = readValue('krediTuru') === 'vergisiz' ? 'konut' : 'tuketici';
      const { kkdf, bsmv } = vergiler[tur] ?? { kkdf: 0, bsmv: 0 };

      if (!(tutar > 0) || !(faiz >= 0) || !(vade >= 1) || vade > 600) {
        showResult(false);
        return false;
      }

      const r = amortize(tutar, faiz, vade, kkdf, bsmv);
      setText('aylik-taksit', formatTL(r.payment));
      setText('toplam-odeme', formatTL(r.totalPayment));
      setText('toplam-faiz', formatTL(r.totalInterest));
      setText('toplam-kkdf', formatTL(r.totalKkdf));
      setText('toplam-bsmv', formatTL(r.totalBsmv));
      setText('efektif-oran', formatPercent(faiz * (1 + (kkdf + bsmv) / 100)));
      renderSchedule('odeme-plani', r.rows, formatTL, kkdf + bsmv > 0);

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Kredi Taksiti Nasıl Hesaplanır?</h2>
    <p>
      Bankalar bireysel kredileri eşit taksitli (annüite) yöntemle geri öder. Her taksit aynı tutardadır ama içindeki faiz payı zamanla azalır, ana para payı artar. Taksit hesabında kullanılan formül şudur:
    </p>
    <p><strong>Taksit = Kredi × r × (1 + r)<sup>n</sup> ÷ ((1 + r)<sup>n</sup> − 1)</strong></p>
    <p>
      Burada n vade (ay), r ise vergiler dahil aylık orandır. İhtiyaç ve taşıt kredilerinde her ayın faizi üzerinden %15 KKDF ve %15 BSMV alındığı için r = aylık faiz × 1,30 olur. Konut kredisinde bu vergiler olmadığından r doğrudan aylık faizdir.
    </p>

    <h2>Örnek Hesaplama</h2>
    <p>
      200.000 TL ihtiyaç kredisi, aylık %3,29 faiz ve 36 ay vade için vergiler dahil aylık oran %4,277'dir. Bu oranla aylık taksit <strong>10.986,64 TL</strong>, toplam geri ödeme 395.519,05 TL olur. Toplam maliyetin 150.399,27 TL'si faiz, 45.119,78 TL'si KKDF ve BSMV'dir.
    </p>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Vade</th><th scope="col">Aylık taksit</th><th scope="col">Toplam ödeme</th></tr></thead>
        <tbody>
          <tr><td>12 ay</td><td>21.654,34 TL</td><td>259.852,12 TL</td></tr>
          <tr><td>24 ay</td><td>13.492,01 TL</td><td>323.808,25 TL</td></tr>
          <tr><td>36 ay</td><td>10.986,64 TL</td><td>395.519,05 TL</td></tr>
        </tbody>
      </table>
    </div>
    <p>Tablo 200.000 TL ve aylık %3,29 faiz için KKDF ve BSMV dahil hesaplanmıştır.</p>

    <h2>Kredi Çekmeden Önce</h2>
    <ul>
      <li>Bankalar kredi tutarının binde 5'ini aşmayacak şekilde kredi tahsis ücreti alabilir; bu hesaplamaya dahil değildir.</li>
      <li>Karşılaştırmayı aylık faizle değil, toplam geri ödeme ve yıllık maliyet oranıyla yapın.</li>
      <li>Taksitinizin aylık net gelirinizin makul bir kısmını aşmamasına dikkat edin; gecikmeler kredi notunuzu düşürür.</li>
    </ul>
  </section>
</CalcLayout>
