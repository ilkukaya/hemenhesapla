---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Kira artışında TÜFE hangi oran kullanılmalıdır?",
    answer: "Kira artışında, sözleşme yenileme tarihinden önceki 12 aylık TÜFE (Tüketici Fiyat Endeksi) ortalaması esas alınmaktadır. TÜİK her ay açıkladığı TÜFE verilerinin son 12 aylık ortalamasını hesaplayarak bu oranı bulabilirsiniz. Türkiye Cumhuriyet Merkez Bankası ve TÜİK'in resmi web sitelerinde güncel TÜFE oranlarına ulaşabilirsiniz. Yasal düzenlemeye göre kira artışı bu oranı aşamaz.",
  },
  {
    question: "Kira artış sınırlaması ne zaman sona eriyor?",
    answer: "6098 sayılı Türk Borçlar Kanunu'nda yapılan geçici değişiklikle konut kiralarında yüzde 25 artış sınırı getirilmişti. Bu düzenleme belirli dönemler için uzatılmış olup güncel yasal durumu takip etmek önemlidir. Mevcut uygulamada konut kiralarında yıllık artış oranı 12 aylık TÜFE ortalamasını aşamaz. En güncel yasal düzenlemeyi Resmi Gazete'den veya bir avukattan öğrenmeniz tavsiye edilir.",
  },
  {
    question: "Ev sahibi TÜFE'den fazla zam yapabilir mi?",
    answer: "Türk Borçlar Kanunu'nun ilgili hükümleri çerçevesinde konut kiralarında yıllık artış oranı, bir önceki kira yılında geçerli olan 12 aylık TÜFE ortalamasını aşamaz. Ev sahibi bu oranın üzerinde zam yapamazken, tarafların anlaşmasıyla TÜFE'nin altında bir artış da belirlenebilir. Yasal sınırı aşan artış talepleri geçersiz sayılır ve kiracı bu artışa uymak zorunda değildir. Uyuşmazlık durumunda sulh hukuk mahkemesine başvurulabilir.",
  },
];

const meta = {
  title: "Kira Artış Hesaplama 2026 — TÜFE ile Yeni Kira",
  description: "Mevcut kiranızı ve TÜFE oranını girerek yeni kira bedelini ve artış tutarını hesaplayın. Yasal kira artış sınırını öğrenin.",
  category: "finans",
  slug: "kira-artis-hesaplama",
  keywords: ["kira artış hesaplama", "TÜFE kira artış", "kira artış oranı 2026", "yeni kira hesaplama", "kira zam hesaplama"],
  dateModified: "2026-04-01",
  relatedCalcs: ["enflasyon-hesaplama", "konut-kredisi-hesaplama", "bilesik-faiz-hesaplama"],
  faq,
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-6">
    <CalcInput
      id="mevcutKira"
      label="Mevcut Kira Bedeli"
      type="number"
      suffix="₺"
      placeholder="10000"
      step={100}
      min={0}
    />
    <CalcInput
      id="tufeOrani"
      label="12 Aylık TÜFE Ortalaması"
      type="number"
      suffix="%"
      placeholder="58.51"
      step={0.01}
      min={0}
      helpText="TÜİK'in açıkladığı son 12 aylık TÜFE ortalamasını girin"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <span class="calc-result-label">Yeni Kira Bedeli</span>
      <span class="calc-result-value" id="yeni-kira">—</span>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Artış Tutarı</span>
        <span class="calc-detail-value" id="artis-tutari">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Artış Oranı</span>
        <span class="calc-detail-value" id="artis-orani">—</span>
      </div>
    </div>
  </CalcResult>

  <section class="calc-content">
    <h2>Kira Artış Hesaplama Nasıl Yapılır?</h2>
    <p>
      Kira artışı hesaplama, kiracı ve ev sahiplerinin yıllık kira yenileme dönemlerinde sıkça ihtiyaç duyduğu bir işlemdir. Türkiye'de kira artışları, Türk Borçlar Kanunu kapsamında belirli kurallara bağlıdır. Konut kiralarında yıllık artış oranı, bir önceki kira yılının 12 aylık TÜFE (Tüketici Fiyat Endeksi) ortalamasını geçemez. Bu kural hem kiracıyı yüksek zamlardan korur hem de ev sahibinin haklarını güvence altına alır.
    </p>
    <p>
      TÜFE oranı, Türkiye İstatistik Kurumu (TÜİK) tarafından her ay düzenli olarak yayımlanmaktadır. 12 aylık ortalama TÜFE değeri, kira sözleşmesinin yenileneceği tarihten geriye doğru hesaplanan bir yıllık dönem için belirlenen enflasyon oranını ifade eder. Bu oranı TÜİK'in resmi web sitesinden veya Merkez Bankası'nın açıkladığı verilerden öğrenebilirsiniz.
    </p>
    <p>
      Kira artış hesaplayıcımız sayesinde mevcut kiranızı ve güncel TÜFE oranını girerek yeni kira bedelini, artış tutarını ve artış oranını anında hesaplayabilirsiniz. Bu araç hem kiracıların hakkını koruması hem de ev sahiplerinin yasal sınırlar içinde hareket etmesi için tasarlanmıştır.
    </p>
    <h3>Kira Artış Formülü</h3>
    <p>
      Kira artışı hesaplama formülü oldukça basittir:
    </p>
    <p>
      <strong>Yeni Kira = Mevcut Kira × (1 + TÜFE Oranı / 100)</strong>
    </p>
    <p>
      <strong>Artış Tutarı = Yeni Kira − Mevcut Kira</strong>
    </p>
    <p>
      Örneğin mevcut kiranız 10.000 TL ve 12 aylık TÜFE ortalaması %58,51 ise: Yeni Kira = 10.000 × (1 + 58,51/100) = 10.000 × 1,5851 = 15.851 TL olarak hesaplanır. Artış tutarı ise 5.851 TL'dir.
    </p>
    <h3>Dikkat Edilmesi Gerekenler</h3>
    <p>
      Kira artışı hesaplanırken kullanılacak TÜFE oranının kira sözleşmesinin yenileme tarihine uygun dönemde olmasına dikkat edilmelidir. Yanlış dönem TÜFE'si kullanılması hatalı hesaplama sonuçları doğurabilir. Ayrıca kira sözleşmesinde özel bir artış oranı belirlenmişse bu oran yasal sınırı aşmamak kaydıyla geçerli olabilir. Uyuşmazlık durumunda her zaman bir hukuk uzmanına danışmanız tavsiye edilir. Hesaplama aracımız bilgilendirme amaçlı olup hukuki bağlayıcılığı yoktur.
    </p>
    <h3>Sıkça Sorulan Sorular</h3>
    {faq.map((item) => (
      <div class="faq-item">
        <h4>{item.question}</h4>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</CalcLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('#calc-form input, #calc-form select');
    const resultArea = document.getElementById('calc-result');

    function debounce(fn: (...args: unknown[]) => void, delay = 150) {
      let timer: ReturnType<typeof setTimeout>;
      return (...args: unknown[]) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), delay); };
    }

    function formatTL(num: number) {
      return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
    }

    function formatPercent(num: number) {
      return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num) + '%';
    }

    const debouncedCalc = debounce(calculate);
    inputs.forEach(i => {
      i.addEventListener('input', debouncedCalc);
      i.addEventListener('change', debouncedCalc);
    });

    function calculate() {
      const mevcutKira = parseFloat((document.getElementById('mevcutKira') as HTMLInputElement).value);
      const tufeOrani = parseFloat((document.getElementById('tufeOrani') as HTMLInputElement).value);

      if (!mevcutKira || mevcutKira <= 0 || isNaN(tufeOrani) || tufeOrani < 0) {
        if (resultArea) resultArea.classList.add('hidden');
        return;
      }

      const yeniKira = mevcutKira * (1 + tufeOrani / 100);
      const artisTutari = yeniKira - mevcutKira;

      (document.getElementById('yeni-kira') as HTMLElement).textContent = formatTL(yeniKira);
      (document.getElementById('artis-tutari') as HTMLElement).textContent = formatTL(artisTutari);
      (document.getElementById('artis-orani') as HTMLElement).textContent = formatPercent(tufeOrani);

      if (resultArea) resultArea.classList.remove('hidden');
      updateURL();
    }

    function updateURL() {
      const params = new URLSearchParams();
      inputs.forEach(i => {
        const el = i as HTMLInputElement;
        if (el.value && el.id) params.set(el.id, el.value);
      });
      history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
    }

    function loadFromURL() {
      const params = new URLSearchParams(window.location.search);
      let hasParams = false;
      inputs.forEach(i => {
        const el = i as HTMLInputElement;
        if (el.id && params.has(el.id)) { el.value = params.get(el.id)!; hasParams = true; }
      });
      if (hasParams) calculate();
    }

    loadFromURL();
  });
</script>
