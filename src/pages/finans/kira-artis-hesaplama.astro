---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import legal from '../../data/legal-2026.json';

const kira = legal.kiraArtis;
const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

const meta = {
  title: "Kira Artış Hesaplama",
  seoTitle: `Kira Artış Hesaplama ${kira.period} – Oran %${fmt(kira.rate)}`,
  description: `Kira artış hesaplama: ${kira.period} için yasal azami oran %${fmt(kira.rate)} (TÜFE 12 aylık ortalama). Mevcut kiranızı girin, yeni kira ve artış tutarını anında görün.`,
  summary: `Konut ve işyeri kiralarında yıllık artış, bir önceki kira yılının TÜFE 12 aylık ortalamalara göre değişim oranını geçemez (TBK md. 344). ${kira.period}'de yenilenen sözleşmeler için bu oran %${fmt(kira.rate)}'dir; 20.000 TL kira en fazla ${fmt(20000 * (1 + kira.rate / 100))} TL'ye çıkarılabilir. Konutlardaki %25 sınırı 1 Temmuz 2024'te sona erdi.`,
  howTo: [
    "Mevcut aylık kira bedelinizi girin.",
    `Kira yenileme ayınızdan önceki ayın TÜFE 12 aylık ortalama değişimini yazın (${kira.period} için %${fmt(kira.rate)} önceden doldurulmuştur).`,
    "Sözleşmede daha düşük bir oran varsa o oranı girin; yasal sınırın üstündeki oranlar geçersizdir.",
    "Yeni kira bedelini ve aylık/yıllık artış tutarını görün."
  ],
  sources: [
    { name: "TÜİK – Tüketici Fiyat Endeksi", url: "https://data.tuik.gov.tr/" },
    { name: "6098 sayılı Türk Borçlar Kanunu md. 344 (mevzuat.gov.tr)", url: "https://www.mevzuat.gov.tr/mevzuatmetin/1.5.6098.pdf" }
  ],
  category: "finans",
  slug: "kira-artis-hesaplama",
  keywords: ["kira artış hesaplama", "kira artış oranı eylül 2026", "kira zammı hesaplama", "TÜFE 12 aylık ortalama", "yasal kira artışı", "kira artış oranı 2026"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/enflasyon-hesaplama", "finans/stopaj-hesaplama", "finans/gelir-vergisi-hesaplama", "finans/konut-kredisi-hesaplama"],
  faq: [
    {
      question: `${kira.period} kira artış oranı ne kadar?`,
      answer: `TÜİK'in ${kira.announced.split('-').reverse().join('.')} tarihinde açıkladığı verilere göre TÜFE'nin 12 aylık ortalamalara göre değişimi %${fmt(kira.rate)} oldu. Bu oran, ${kira.period} ayında yenilenen konut ve çatılı işyeri kira sözleşmelerinde uygulanabilecek en yüksek artış oranıdır. Önceki ay bu oran %${fmt(kira.previous[0].rate)} idi.`
    },
    {
      question: "Kira artışında %25 sınırı devam ediyor mu?",
      answer: "Hayır. Konut kiralarına getirilen %25 geçici sınırı 1 Temmuz 2024'te sona erdi. Bu tarihten sonraki yenilemelerde konut ve işyeri için tek ölçü, bir önceki kira yılındaki TÜFE 12 aylık ortalama değişimidir. Taraflar daha düşük bir artış üzerinde anlaşabilir, daha yükseği ise geçersizdir."
    },
    {
      question: "Kira artış oranı hangi aya göre belirlenir?",
      answer: "Kira dönemi hangi ay yenileniyorsa, o aydan önce açıklanan son TÜFE verisi esas alınır. TÜİK verileri her ayın 3'ünde açıklandığından, örneğin Eylül yenilemelerinde Ağustos ayı TÜFE'sinin 12 aylık ortalaması kullanılır. Yıllık TÜFE ya da aylık TÜFE değil, 12 aylık ortalama değişim oranı esas alınır."
    },
    {
      question: "Ev sahibi 5 yıl sonra kirayı istediği kadar artırabilir mi?",
      answer: "Beş yıldan uzun süreli veya beş yıldan sonra yenilenen sözleşmelerde her beş yılın sonunda kira bedeli, hakim tarafından emsal kiralar ve TÜFE dikkate alınarak hakkaniyete uygun şekilde yeniden belirlenebilir. Ev sahibi bunu tek taraflı yapamaz; anlaşma olmazsa arabuluculuk ve kira tespit davası yoluna gidilir."
    },
    {
      question: "Döviz cinsinden kira nasıl artırılır?",
      answer: "Kira bedeli yabancı para üzerinden kararlaştırılmışsa, beş yıl geçmedikçe bedel değiştirilemez. Ancak Türkiye'de yerleşik kişiler arasındaki konut ve işyeri kira sözleşmelerinde döviz cinsinden bedel kararlaştırılması, istisnalar dışında Türk Parası Kıymetini Koruma mevzuatına göre yasaktır. Mevcut dövizli sözleşmeler TL'ye çevrilmelidir."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="mevcutKira"
      label="Mevcut Aylık Kira"
      type="number"
      suffix="₺"
      placeholder="20000"
      step="any"
      min={0}
    />
    <CalcInput
      id="tufeOrani"
      label="Artış Oranı (TÜFE 12 aylık ortalama)"
      type="number"
      suffix="%"
      placeholder={String(kira.rate)}
      value={String(kira.rate)}
      step="any"
      min={0}
      helpText={`${kira.period} yenilemeleri için yasal azami oran %${fmt(kira.rate)}`}
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Yeni Aylık Kira</p>
      <p class="calc-result-value" id="yeni-kira">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Aylık Artış Tutarı</span>
        <span class="calc-detail-value" id="artis-tutari">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Uygulanan Oran</span>
        <span class="calc-detail-value" id="artis-orani">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Yeni Yıllık Kira Toplamı</span>
        <span class="calc-detail-value" id="yillik-kira">—</span>
      </div>
      <p class="calc-note" id="kira-uyari"></p>
    </div>
  </CalcResult>

  <script type="application/json" id="kira-data" set:html={JSON.stringify({ rate: kira.rate, period: kira.period })}></script>

  <script>
    import { formatTL, formatPercent, readNumber, readJSON, setText, showResult, initCalculator, round2 } from './_shared';

    const data = readJSON<{ rate: number; period: string }>('kira-data');

    function calculate(): boolean {
      const kira = readNumber('mevcutKira');
      const oran = readNumber('tufeOrani');

      if (!(kira > 0) || !(oran >= 0)) {
        showResult(false);
        return false;
      }

      const yeni = round2(kira * (1 + oran / 100));
      setText('yeni-kira', formatTL(yeni));
      setText('artis-tutari', formatTL(yeni - kira));
      setText('artis-orani', formatPercent(oran));
      setText('yillik-kira', formatTL(yeni * 12));
      setText(
        'kira-uyari',
        oran > data.rate
          ? `Girdiğiniz oran, ${data.period} için yasal üst sınır olan ${formatPercent(data.rate)} değerinden yüksek. Yenileme ayınızın oranını TÜİK verisinden kontrol edin.`
          : 'Kiracı ile ev sahibi daha düşük bir artış oranında anlaşabilir.'
      );

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Kira Artışı Nasıl Hesaplanır?</h2>
    <p>
      Türk Borçlar Kanunu'nun 344. maddesine göre yenilenen kira dönemlerinde uygulanacak artış, bir önceki kira yılında TÜİK'in açıkladığı tüketici fiyat endeksinin <strong>12 aylık ortalamalara göre değişim oranını</strong> geçemez. Kural hem konutlar hem de çatılı işyerleri için geçerlidir. Sözleşmede oran yazmasa bile ev sahibi en fazla bu oranda artış isteyebilir.
    </p>
    <p><strong>Formül:</strong> Yeni kira = Mevcut kira × (1 + TÜFE 12 aylık ortalama ÷ 100)</p>

    <h2>Son Açıklanan Kira Artış Oranları</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Yenileme ayı</th><th scope="col">Azami artış oranı</th></tr></thead>
        <tbody>
          <tr><td>{kira.period}</td><td>%{fmt(kira.rate)}</td></tr>
          {kira.previous.map((p) => (
            <tr><td>{p.period}</td><td>%{fmt(p.rate)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>Yeni oranlar her ayın 3'ünde TÜİK tarafından açıklanır; sözleşme yenileme ayınızdan önceki ayın verisine bakın.</p>

    <h2>Örnek Hesaplama</h2>
    <p>
      Eylül 2026'da yenilenen bir sözleşmede aylık kira 20.000 TL ise artış en fazla 20.000 × %{fmt(kira.rate)} = {fmt(20000 * kira.rate / 100)} TL olabilir. Yeni kira <strong>{fmt(20000 * (1 + kira.rate / 100))} TL</strong>, yıllık toplam kira {fmt(12 * 20000 * (1 + kira.rate / 100))} TL olur. Taraflar örneğin %25 artışta anlaşırsa yeni kira 25.000 TL olur; bu oran yasal sınırın altında olduğu için geçerlidir.
    </p>

    <h2>Bilmeniz Gerekenler</h2>
    <ul>
      <li>Konut kiralarındaki %25 geçici üst sınır 1 Temmuz 2024'te sona ermiştir.</li>
      <li>Artış ancak kira yılı dolduğunda, yeni kira dönemi için uygulanabilir; yıl içinde tek taraflı zam yapılamaz.</li>
      <li>Beş yılı dolduran sözleşmelerde kira bedeli, anlaşma olmazsa kira tespit davasıyla emsal kiralara göre belirlenebilir.</li>
      <li>Kira uyuşmazlıklarında dava açmadan önce arabulucuya başvurmak zorunludur.</li>
    </ul>
  </section>
</CalcLayout>
