---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import legal from '../../data/legal-2026.json';

const kdvOranlari = legal.kdvOranlari.map((o) => ({ value: String(o), label: `%${o}` }));

const meta = {
  title: "KDV Hesaplama",
  seoTitle: "KDV Hesaplama 2026 – KDV Dahil ve Hariç Fiyat (%1, %10, %20)",
  description: "KDV hesaplama 2026: KDV hariç tutara KDV ekleyin ya da KDV dahil fiyattan matrahı ve KDV'yi ayırın. %1, %10 ve %20 oranları için anında ve ücretsiz hesap.",
  summary: "KDV tutarı = KDV hariç fiyat × oran; KDV dahil fiyat = KDV hariç fiyat × (1 + oran). KDV dahil fiyattan matraha geçmek için fiyat (1 + oran)'a bölünür: %20 KDV dahil 1.200 TL'nin matrahı 1.000 TL, KDV'si 200 TL'dir. Türkiye'de 2026'da KDV oranları %1, %10 ve genel oran %20'dir.",
  howTo: [
    "Girdiğiniz tutarın KDV hariç mi KDV dahil mi olduğunu seçin.",
    "Tutarı yazın.",
    "Ürün veya hizmete uygulanan KDV oranını (%1, %10, %20) seçin.",
    "KDV tutarını, KDV hariç ve KDV dahil fiyatları görün."
  ],
  sources: [
    { name: "3065 sayılı Katma Değer Vergisi Kanunu (mevzuat.gov.tr)", url: "https://www.mevzuat.gov.tr/mevzuatmetin/1.5.3065.pdf" },
    { name: "Gelir İdaresi Başkanlığı", url: "https://www.gib.gov.tr/" }
  ],
  category: "finans",
  slug: "kdv-hesaplama",
  keywords: ["KDV hesaplama", "KDV dahil hesaplama", "KDV hariç hesaplama", "%20 KDV hesaplama", "KDV oranları 2026", "matrah hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/stopaj-hesaplama", "finans/gelir-vergisi-hesaplama", "matematik/yuzde-hesaplama"],
  faq: [
    {
      question: "KDV dahil fiyattan KDV nasıl ayrılır?",
      answer: "KDV dahil fiyatı (1 + KDV oranı)'na bölerek matrahı bulursunuz; aradaki fark KDV'dir. %20 için 1,20'ye, %10 için 1,10'a, %1 için 1,01'e bölün. Örneğin 2.400 TL'lik %20 KDV dahil bir faturada matrah 2.000 TL, KDV 400 TL'dir. Fiyatı 0,80 ile çarpmak yanlış sonuç verir."
    },
    {
      question: "2026 KDV oranları nelerdir?",
      answer: "Türkiye'de 2026'da üç KDV oranı uygulanır: genel oran %20, indirimli oranlar %10 ve %1. Genel oran Temmuz 2023'te %18'den %20'ye, %8'lik oran da %10'a yükseltilmiştir. Hangi mal ve hizmete hangi oranın uygulanacağı KDV Kanunu'na ekli (I) ve (II) sayılı listelerde belirlenir."
    },
    {
      question: "Hangi ürünlerde %1 KDV uygulanır?",
      answer: "%1 oranı (I) sayılı listede yer alan teslimlere uygulanır. Ekmek ve un gibi temel gıdalar, bazı tarım ürünleri, gazete ve dergiler ile belirli şartları taşıyan konut teslimleri bu kapsamdadır. Listede ayrıca sayılmayan mal ve hizmetlere genel oran olan %20 uygulanır."
    },
    {
      question: "%20 KDV nasıl hesaplanır?",
      answer: "KDV hariç tutarı 0,20 ile çarparak KDV'yi, 1,20 ile çarparak KDV dahil fiyatı bulursunuz. 5.000 TL + KDV bir hizmet için KDV 1.000 TL, toplam fatura 6.000 TL olur. Tersine, KDV dahil fiyatı 1,20'ye bölerek matraha ulaşırsınız."
    },
    {
      question: "KDV ile ÖTV birlikte nasıl hesaplanır?",
      answer: "ÖTV'ye tabi ürünlerde (otomobil, akaryakıt, alkol, tütün vb.) önce ÖTV hesaplanır, KDV ise ÖTV dahil tutar üzerinden alınır. Bu nedenle KDV, vergisiz fiyatın doğrudan %20'si değil, ÖTV eklenmiş fiyatın %20'sidir."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="hesapTuru"
      label="Girilen Tutar"
      options={[
        { value: "haric", label: "KDV hariç (KDV ekle)" },
        { value: "dahil", label: "KDV dahil (KDV ayır)" },
      ]}
      value="haric"
    />
    <CalcInput
      id="tutar"
      label="Tutar"
      type="number"
      placeholder="5000"
      suffix="₺"
      min={0}
      step="any"
    />
    <CalcSelect
      id="kdvOrani"
      label="KDV Oranı"
      options={kdvOranlari}
      value="20"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">KDV Tutarı</p>
      <p class="calc-result-value" id="kdv-tutari">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">KDV Hariç Fiyat (Matrah)</span>
        <span class="calc-detail-value" id="kdv-haric">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">KDV Dahil Fiyat</span>
        <span class="calc-detail-value" id="kdv-dahil">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Uygulanan Oran</span>
        <span class="calc-detail-value" id="kdv-oran">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    import { formatTL, readNumber, readValue, setText, showResult, initCalculator, round2 } from './_shared';

    function calculate(): boolean {
      const tutar = readNumber('tutar');
      const oran = readNumber('kdvOrani');
      const mod = readValue('hesapTuru') === 'dahil' ? 'dahil' : 'haric';

      if (!(tutar > 0) || !(oran >= 0)) {
        showResult(false);
        return false;
      }

      const haric = mod === 'dahil' ? round2(tutar / (1 + oran / 100)) : tutar;
      const dahil = mod === 'dahil' ? tutar : round2(tutar * (1 + oran / 100));
      const kdv = round2(dahil - haric);

      setText('kdv-tutari', formatTL(kdv));
      setText('kdv-haric', formatTL(haric));
      setText('kdv-dahil', formatTL(dahil));
      setText('kdv-oran', `%${oran}`);

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>KDV Nasıl Hesaplanır?</h2>
    <p>
      Katma değer vergisi, mal ve hizmet tesliminde satış bedeli (matrah) üzerine eklenen bir tüketim vergisidir. Satıcı KDV'yi alıcıdan tahsil eder, kendi alışlarında ödediği KDV'yi düşerek farkı vergi dairesine öder. Hesaplamada iki yön vardır:
    </p>
    <ul>
      <li><strong>KDV hariç tutardan:</strong> KDV = Matrah × Oran; KDV dahil fiyat = Matrah × (1 + Oran)</li>
      <li><strong>KDV dahil tutardan:</strong> Matrah = KDV dahil fiyat ÷ (1 + Oran); KDV = KDV dahil fiyat − Matrah</li>
    </ul>

    <h2>2026 KDV Oranları</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Oran</th><th scope="col">Kapsam</th><th scope="col">Dahil fiyattan matrah</th></tr></thead>
        <tbody>
          <tr><td>%1</td><td>(I) sayılı liste: ekmek ve un gibi temel gıdalar, bazı tarım ürünleri, gazete-dergi, şartlı konut teslimleri</td><td>Fiyat ÷ 1,01</td></tr>
          <tr><td>%10</td><td>(II) sayılı liste: gıda ürünlerinin çoğu, bazı sağlık ürünleri ve hizmetler</td><td>Fiyat ÷ 1,10</td></tr>
          <tr><td>%20</td><td>Genel oran: listelerde sayılmayan tüm mal ve hizmetler</td><td>Fiyat ÷ 1,20</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Örnek Hesaplamalar</h2>
    <h3>KDV hariç tutara KDV eklemek</h3>
    <p>
      Bir yazılım firması müşterisine 5.000 TL + KDV fatura kesecek. KDV = 5.000 × 0,20 = 1.000 TL; fatura toplamı <strong>6.000 TL</strong>.
    </p>
    <h3>KDV dahil fiyattan KDV ayırmak</h3>
    <p>
      Etiket fiyatı 1.440 TL olan ve %20 KDV'ye tabi bir ürünün matrahı 1.440 ÷ 1,20 = 1.200 TL, içindeki KDV 240 TL'dir. Aynı ürün %10 KDV'ye tabi olsaydı matrah 1.309,09 TL, KDV 130,91 TL olurdu.
    </p>
    <p>
      Sık yapılan bir hata, KDV dahil fiyatı 0,80 ile çarpıp matrahı bulmaya çalışmaktır. 1.440 × 0,80 = 1.152 TL eder ve yanlıştır; doğru yöntem 1,20'ye bölmektir.
    </p>

    <h2>İşletmeler İçin Kısa Notlar</h2>
    <ul>
      <li>KDV beyannamesi aylık dönemler halinde, izleyen ayın 28'ine kadar verilir.</li>
      <li>Bazı hizmetlerde (ör. yapım, temizlik, güvenlik) alıcı KDV'nin bir kısmını tevkif eder; bu durumda satıcıya ödenen KDV azalır.</li>
      <li>İhracat ve bazı teslimler KDV'den istisnadır; istisna kapsamındaki işlemlerde yüklenilen KDV iade konusu yapılabilir.</li>
    </ul>
  </section>
</CalcLayout>
