---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import legal from '../../data/legal-2026.json';

const v = legal.krediVergileri.tuketici;

const meta = {
  title: "Taşıt Kredisi Hesaplama",
  seoTitle: "Taşıt Kredisi Hesaplama 2026 – Araç Kredisi Taksit",
  description: "Taşıt kredisi hesaplama 2026: araç fiyatı ve peşinatla kredi tutarını, KKDF ve BSMV dahil aylık taksiti, toplam faizi ve ay ay ödeme planını hemen görün.",
  summary: `Taşıt kredisi taksiti, kredi tutarı (araç fiyatı − peşinat) üzerinden eşit taksit formülüyle hesaplanır. Faizin üzerine %${v.kkdf} KKDF ve %${v.bsmv} BSMV eklendiğinden efektif aylık oran, akdi faizin 1,30 katıdır. Örneğin 600.000 TL kredi, aylık %2,99 faiz ve 36 ay vadede taksit 31.237,37 TL'dir.`,
  howTo: [
    "Aracın satış fiyatını girin.",
    "Ödeyeceğiniz peşinatı yazın.",
    "Bankanın aylık faiz oranını ve vadeyi seçin.",
    "Kredi tutarını, aylık taksiti, toplam faizi ve vergi yükünü görün."
  ],
  sources: [
    { name: "BDDK", url: "https://www.bddk.org.tr/" },
    { name: "TCMB – Para Politikası Kurulu kararları (2026)", url: "https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Temel+Faaliyetler/Para+Politikasi/PPK/2026" }
  ],
  category: "finans",
  slug: "tasit-kredisi-hesaplama",
  keywords: ["taşıt kredisi hesaplama", "araç kredisi hesaplama", "araba kredisi taksit", "taşıt kredisi faiz 2026", "peşinatlı araç kredisi", "taşıt kredisi KKDF BSMV"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/kredi-hesaplama", "finans/konut-kredisi-hesaplama", "gunluk/yakit-maliyeti-hesaplama", "finans/yatirim-getiri-hesaplama"],
  faq: [
    {
      question: "Taşıt kredisi taksiti nasıl hesaplanır?",
      answer: "Önce kredi tutarı bulunur: araç fiyatı eksi peşinat. Ardından eşit taksit formülü uygulanır; aylık oran olarak akdi faizin 1,30 katı kullanılır çünkü her ayın faizi üzerinden %15 KKDF ve %15 BSMV alınır. Örneğin 600.000 TL, %2,99 faiz ve 48 ay vadede taksit 27.775,78 TL'dir."
    },
    {
      question: "Taşıt kredisinde en uzun vade kaç ay?",
      answer: "BDDK, bireysel taşıt kredilerinde vadeyi ve kullandırılabilecek kredi oranını aracın nihai fatura değerine göre sınırlar. Düşük değerli araçlarda vade 48 aya kadar çıkabilirken, fiyatı yükseldikçe hem vade kısalır hem de kredi oranı düşer. Güncel sınırları başvurmadan önce bankanızdan öğrenin."
    },
    {
      question: "Taşıt kredisinde KKDF ve BSMV var mı?",
      answer: "Evet. Bireysel taşıt kredileri tüketici kredisi sayıldığından faiz tutarı üzerinden %15 KKDF ve %15 BSMV alınır. Bu vergiler taksite dahildir ve toplam maliyeti önemli ölçüde artırır. Ticari araç kredilerinde (şirket adına) vergilendirme farklıdır."
    },
    {
      question: "Peşinatı artırmak ne kadar tasarruf sağlar?",
      answer: "Peşinat arttıkça kredi tutarı ve dolayısıyla faiz ve vergi yükü doğrusal olarak azalır. 36 ay ve %2,99 faizle 100.000 TL fazla peşinat, aylık taksiti yaklaşık 5.206 TL, toplam geri ödemeyi yaklaşık 187.400 TL azaltır. Yüksek faiz döneminde peşinatı artırmak genellikle en etkili tasarruf yoludur."
    },
    {
      question: "İkinci el araç için taşıt kredisi alınabilir mi?",
      answer: "Evet, bankalar ikinci el araçlar için de taşıt kredisi verir. Bu durumda kredi tutarı ve vade, kasko değeri ve araç yaşı gibi kriterlere göre belirlenir. Araç, kredi süresince bankaya rehinli olur; kredi kapanmadan rehin kaldırılmaz."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="aracFiyati"
      label="Araç Fiyatı"
      type="number"
      suffix="₺"
      placeholder="1200000"
      step="any"
      min={0}
    />
    <CalcInput
      id="pesinat"
      label="Peşinat"
      type="number"
      suffix="₺"
      placeholder="600000"
      step="any"
      min={0}
      required={false}
    />
    <CalcInput
      id="faiz"
      label="Aylık Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="2.99"
      step="any"
      min={0}
      helpText="Vergiler hariç akdi faiz oranı"
    />
    <CalcSelect
      id="vade"
      label="Vade"
      options={[
        { value: "12", label: "12 ay" },
        { value: "24", label: "24 ay" },
        { value: "36", label: "36 ay" },
        { value: "48", label: "48 ay" },
      ]}
      value="36"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Aylık Taksit</p>
      <p class="calc-result-value" id="aylik-taksit">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Kredi Tutarı</span>
        <span class="calc-detail-value" id="kredi-tutari">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Geri Ödeme</span>
        <span class="calc-detail-value" id="toplam-odeme">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Faiz</span>
        <span class="calc-detail-value" id="toplam-faiz">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam KKDF + BSMV</span>
        <span class="calc-detail-value" id="toplam-vergi">—</span>
      </div>
      <div class="calc-table-wrap">
        <table class="calc-table">
          <caption>Ödeme planı</caption>
          <thead>
            <tr><th scope="col">Ay</th><th scope="col">Taksit</th><th scope="col">Ana para</th><th scope="col">Faiz</th><th scope="col">KKDF+BSMV</th><th scope="col">Kalan</th></tr>
          </thead>
          <tbody id="odeme-plani"></tbody>
        </table>
      </div>
      <p class="calc-note" id="tasit-uyari">Kasko, dosya masrafı ve rehin ücretleri dahil değildir.</p>
    </div>
  </CalcResult>

  <script type="application/json" id="tasit-data" set:html={JSON.stringify(v)}></script>

  <script>
    import { formatTL, readNumber, readJSON, setText, showResult, initCalculator } from './_shared';
    import { amortize, renderSchedule } from './_loan';

    const { kkdf, bsmv } = readJSON<{ kkdf: number; bsmv: number }>('tasit-data');

    function calculate(): boolean {
      const fiyat = readNumber('aracFiyati');
      const pesinat = Math.max(0, readNumber('pesinat') || 0);
      const faiz = readNumber('faiz');
      const vade = Math.round(readNumber('vade'));

      if (!(fiyat > 0) || !(faiz >= 0) || !(vade >= 1)) {
        showResult(false);
        return false;
      }

      const kredi = fiyat - pesinat;
      if (kredi <= 0) {
        showResult(true);
        setText('aylik-taksit', formatTL(0));
        setText('kredi-tutari', formatTL(0));
        setText('toplam-odeme', formatTL(0));
        setText('toplam-faiz', formatTL(0));
        setText('toplam-vergi', formatTL(0));
        document.getElementById('odeme-plani')?.replaceChildren();
        setText('tasit-uyari', 'Peşinat araç fiyatına eşit ya da daha yüksek; krediye gerek yok.');
        return true;
      }

      const r = amortize(kredi, faiz, vade, kkdf, bsmv);
      setText('aylik-taksit', formatTL(r.payment));
      setText('kredi-tutari', formatTL(kredi));
      setText('toplam-odeme', formatTL(r.totalPayment));
      setText('toplam-faiz', formatTL(r.totalInterest));
      setText('toplam-vergi', formatTL(r.totalKkdf + r.totalBsmv));
      setText('tasit-uyari', 'Kasko, dosya masrafı ve rehin ücretleri dahil değildir. Kredi oranı ve vade, BDDK sınırlarına göre araç değerine bağlıdır.');
      renderSchedule('odeme-plani', r.rows, formatTL, true);

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Taşıt Kredisi Nasıl Hesaplanır?</h2>
    <p>
      Taşıt kredisinde önce kredi tutarı belirlenir: araç fiyatından peşinat çıkarılır. Bu tutar, bankanın aylık faiz oranı ve seçilen vadeye göre eşit taksitlere bölünür. Bireysel taşıt kredileri tüketici kredisi olduğundan her taksitteki faizin üzerine %{v.kkdf} KKDF ve %{v.bsmv} BSMV eklenir.
    </p>
    <p><strong>Taksit = Kredi × r × (1 + r)<sup>n</sup> ÷ ((1 + r)<sup>n</sup> − 1)</strong>, burada r = aylık faiz × 1,30</p>

    <h2>Örnek Hesaplama</h2>
    <p>
      1.200.000 TL'lik bir araç için 600.000 TL peşinat ödendiğini, kalan 600.000 TL'nin aylık %2,99 faizle kredilendirildiğini düşünelim.
    </p>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Vade</th><th scope="col">Aylık taksit</th><th scope="col">Toplam faiz</th><th scope="col">KKDF + BSMV</th></tr></thead>
        <tbody>
          <tr><td>36 ay</td><td>31.237,37 TL</td><td>403.496,30 TL</td><td>121.048,90 TL</td></tr>
          <tr><td>48 ay</td><td>27.775,78 TL</td><td>564.028,65 TL</td><td>169.208,60 TL</td></tr>
        </tbody>
      </table>
    </div>
    <p>
      Vadeyi 36 aydan 48 aya uzatmak taksiti yaklaşık 3.460 TL düşürür ama toplam faiz ve vergi yükünü 208.000 TL'den fazla artırır.
    </p>

    <h2>Başvurmadan Önce</h2>
    <ul>
      <li>BDDK, araç fiyatı yükseldikçe kullandırılabilecek kredi oranını ve vadeyi düşürür; bu nedenle pahalı araçlarda daha yüksek peşinat gerekir.</li>
      <li>Kredi süresince araç bankaya rehinlidir ve kasko yaptırılması istenir.</li>
      <li>Galeri veya bayi kampanyalarındaki "sıfır faiz" tekliflerinde araç fiyatının yükseltilip yükseltilmediğini kontrol edin.</li>
    </ul>
  </section>
</CalcLayout>
