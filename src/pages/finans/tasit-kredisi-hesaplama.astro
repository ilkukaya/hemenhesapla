---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Taşıt kredisinde peşinat zorunlu mu?",
    answer: "Bankacılık Düzenleme ve Denetleme Kurumu (BDDK) kurallarına göre ikinci el araç alımlarında araç değerinin belirli bir oranında peşinat ödenmesi gerekebilir. Sıfır araçlarda ise peşinat oranı genellikle araç değerinin %20'si ile %30'u arasında belirlenir. Peşinat arttıkça kredi tutarı azalır, dolayısıyla aylık taksit ve toplam faiz düşer."
  },
  {
    question: "Taşıt kredisi için hangi belgeler gerekir?",
    answer: "Taşıt kredisi başvurusunda genellikle nüfus cüzdanı, son üç aylık maaş bordrosu veya gelir belgesi, ikametgah belgesi ve araç ekspertiz raporu istenir. Bankaya göre istenen belgeler farklılık gösterebilir. Kredi notunuzun yüksek olması onay sürecini hızlandırır ve daha iyi faiz oranı almanızı sağlar."
  },
  {
    question: "Taşıt kredisinde erken ödeme yapılabilir mi?",
    answer: "Evet, taşıt kredilerinde erken ödeme mümkündür. Kalan borcun tamamı ya da bir kısmı erken ödendiğinde banka, yasal düzenlemeler çerçevesinde erken ödeme komisyonu talep edebilir. Bu komisyon oranı genellikle kalan borç üzerinden %1 ile %2 arasında değişir. Erken ödeme yapmadan önce bankanızla bu koşulları netleştirmeniz önerilir."
  }
];

const meta = {
  title: "Taşıt Kredisi Hesaplama",
  description: "Araç kredisi aylık taksit, kredi tutarı ve toplam faizi anında hesaplayın. Peşinatlı taşıt kredisi hesaplama aracı.",
  category: "finans",
  slug: "tasit-kredisi-hesaplama",
  keywords: ["taşıt kredisi hesaplama", "araç kredisi taksit", "otomobil kredisi hesaplama", "araç kredisi faiz", "taşıt kredisi vade"],
  dateModified: "2026-04-01",
  relatedCalcs: ["konut-kredisi-hesaplama", "kredi-hesaplama", "yatirim-getiri-hesaplama"],
  faq,
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-6">
    <CalcInput
      id="aracFiyati"
      label="Araç Fiyatı"
      type="number"
      suffix="₺"
      placeholder="500000"
      step={1000}
      min={0}
    />
    <CalcInput
      id="pesinat"
      label="Peşinat"
      type="number"
      suffix="₺"
      placeholder="100000"
      step={1000}
      min={0}
    />
    <CalcInput
      id="faiz"
      label="Aylık Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="3.50"
      step={0.01}
      min={0.01}
    />
    <CalcSelect
      id="vade"
      label="Vade"
      options={[
        { value: "12", label: "12 Ay" },
        { value: "24", label: "24 Ay" },
        { value: "36", label: "36 Ay" },
        { value: "48", label: "48 Ay" },
        { value: "60", label: "60 Ay" },
      ]}
      value="36"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <span class="calc-result-label">Aylık Taksit</span>
      <span class="calc-result-value" id="aylik-taksit">—</span>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Kredi Tutarı</span>
        <span class="calc-detail-value" id="kredi-tutari">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Ödeme</span>
        <span class="calc-detail-value" id="toplam-odeme">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Faiz</span>
        <span class="calc-detail-value" id="toplam-faiz">—</span>
      </div>
    </div>
  </CalcResult>

  <section class="calc-content">
    <h2>Taşıt Kredisi Hesaplama Nasıl Yapılır?</h2>
    <p>
      Taşıt kredisi, yeni veya ikinci el araç satın almak için bankalardan kullanılan tüketici kredisi türüdür. Araç değerinin tamamını nakit ödeyemeyenler için pratik bir finansman seçeneği sunan taşıt kredisinde doğru taksit planlaması yapmak, aylık bütçenizi zorlamadan araç sahibi olmanızı sağlar.
    </p>
    <h3>Taşıt Kredisi Formülü</h3>
    <p>
      Kredi tutarı, araç fiyatından peşinat düşülerek hesaplanır: <strong>Kredi Tutarı = Araç Fiyatı − Peşinat</strong>. Ardından aylık taksit anüite formülüyle bulunur:
    </p>
    <p>
      <strong>Aylık Taksit = Kredi Tutarı × [r × (1+r)^n] / [(1+r)^n − 1]</strong>
    </p>
    <p>
      Formülde r aylık faiz oranı (oran/100), n ise vade (ay) olarak alınır. Araç fiyatı, peşinat miktarı, faiz oranı ve vadeyi girerek aylık taksitinizi anında öğrenebilirsiniz.
    </p>
    <h3>Peşinatın Toplam Maliyete Etkisi</h3>
    <p>
      Peşinat miktarı arttıkça kredi tutarı düşer ve toplam faiz yükü azalır. Örneğin 500.000 TL değerinde bir araç için %20 peşinat (100.000 TL) ödediğinizde 400.000 TL üzerinden kredi kullanırsınız; %30 peşinat (150.000 TL) ödediğinizde ise 350.000 TL üzerinden. Bu 50.000 TL'lik fark, uzun vadede ödenecek faizi önemli ölçüde etkiler.
    </p>
    <h3>Dikkat Edilmesi Gerekenler</h3>
    <p>
      Taşıt kredisinde yalnızca aylık taksiti değil, toplam maliyeti de göz önünde bulundurmanız gerekir. Araç kasko sigortası, trafik sigortası ve MTV (Motorlu Taşıtlar Vergisi) gibi ek yükümlülükler de bütçenize dahil edilmelidir. Farklı bankaların ve otomobil bayilerinin sunduğu finansman tekliflerini karşılaştırırken <strong>Yıllık Maliyet Oranı (YMO)</strong> en sağlıklı karşılaştırma ölçütüdür.
    </p>
    <h3>Sıkça Sorulan Sorular</h3>
    {faq.map((item) => (
      <div class="faq-item">
        <h4>{item.question}</h4>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</CalcLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('#calc-form input, #calc-form select');
    const resultArea = document.getElementById('calc-result');

    function debounce(fn: (...args: unknown[]) => void, delay = 150) {
      let timer: ReturnType<typeof setTimeout>;
      return (...args: unknown[]) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), delay); };
    }

    function formatTL(num: number) {
      return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
    }

    const debouncedCalc = debounce(calculate);
    inputs.forEach(input => {
      input.addEventListener('input', debouncedCalc);
      input.addEventListener('change', debouncedCalc);
    });

    function calculate() {
      const aracFiyati = parseFloat((document.getElementById('aracFiyati') as HTMLInputElement).value);
      const pesinat = parseFloat((document.getElementById('pesinat') as HTMLInputElement).value) || 0;
      const faiz = parseFloat((document.getElementById('faiz') as HTMLInputElement).value);
      const vade = parseInt((document.getElementById('vade') as HTMLSelectElement).value);

      if (!aracFiyati || !faiz || !vade || aracFiyati <= 0 || faiz <= 0 || vade <= 0) {
        if (resultArea) resultArea.classList.add('hidden');
        return;
      }

      const krediTutari = aracFiyati - pesinat;
      if (krediTutari <= 0) {
        if (resultArea) resultArea.classList.add('hidden');
        return;
      }

      const r = faiz / 100;
      const pow = Math.pow(1 + r, vade);
      const aylikTaksit = krediTutari * r * pow / (pow - 1);
      const toplamOdeme = aylikTaksit * vade;
      const toplamFaiz = toplamOdeme - krediTutari;

      (document.getElementById('aylik-taksit') as HTMLElement).textContent = formatTL(aylikTaksit);
      (document.getElementById('kredi-tutari') as HTMLElement).textContent = formatTL(krediTutari);
      (document.getElementById('toplam-odeme') as HTMLElement).textContent = formatTL(toplamOdeme);
      (document.getElementById('toplam-faiz') as HTMLElement).textContent = formatTL(toplamFaiz);

      if (resultArea) resultArea.classList.remove('hidden');
      updateURL();
    }

    function updateURL() {
      const params = new URLSearchParams();
      inputs.forEach(input => {
        const el = input as HTMLInputElement;
        if (el.value && el.id) params.set(el.id, el.value);
      });
      history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
    }

    function loadFromURL() {
      const params = new URLSearchParams(window.location.search);
      let hasParams = false;
      inputs.forEach(input => {
        const el = input as HTMLInputElement;
        if (el.id && params.has(el.id)) { el.value = params.get(el.id)!; hasParams = true; }
      });
      if (hasParams) calculate();
    }

    loadFromURL();
  });
</script>
