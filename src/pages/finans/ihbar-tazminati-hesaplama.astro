---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import legal from '../../data/legal-2026.json';
import taxBrackets from '../../data/tax-brackets.json';

const sureOptions = legal.ihbarSureleri.map((s) => ({ value: s.key, label: `${s.label} (${s.weeks} hafta)` }));
const vergiOptions = taxBrackets.ucret.map((b) => ({ value: String(b.rate), label: `%${b.rate}` }));

const meta = {
  title: "İhbar Tazminatı Hesaplama",
  seoTitle: "İhbar Tazminatı Hesaplama 2026 – İhbar Süresi ve Net Tutar",
  description: "İhbar tazminatı hesaplama 2026: çalışma sürenize göre 2, 4, 6 veya 8 haftalık ihbar süresini, brüt tazminatı, gelir ve damga vergisi kesintisini ve net tutarı bulun.",
  summary: "İhbar tazminatı, İş Kanunu md. 17'deki bildirim süresine uyulmadan yapılan fesihte bu sürenin ücreti kadar ödenir: 6 aydan az çalışmada 2 hafta, 6 ay–1,5 yıl 4 hafta, 1,5–3 yıl 6 hafta, 3 yıldan fazla çalışmada 8 hafta. Tutar = gün sayısı × günlük giydirilmiş brüt ücret; gelir vergisi ve damga vergisi kesilir, SGK primi kesilmez.",
  howTo: [
    "İşyerindeki toplam çalışma sürenizi seçin.",
    "Aylık giydirilmiş brüt ücretinizi (düzenli yan ödemeler dahil) girin.",
    "Bulunduğunuz gelir vergisi dilimini seçin; emin değilseniz bordronuzdaki son oranı kullanın.",
    "Brüt ihbar tazminatını, vergi kesintilerini ve net tutarı görün."
  ],
  sources: [
    { name: "4857 sayılı İş Kanunu md. 17 (mevzuat.gov.tr)", url: "https://www.mevzuat.gov.tr/MevzuatMetin/1.5.4857.pdf" },
    { name: "Gelir İdaresi Başkanlığı", url: "https://www.gib.gov.tr/" }
  ],
  category: "finans",
  slug: "ihbar-tazminati-hesaplama",
  keywords: ["ihbar tazminatı hesaplama", "ihbar süresi", "ihbar tazminatı 2026", "ihbar tazminatı vergi", "ihbar süresi kaç hafta", "iş kanunu 17. madde"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/kidem-tazminati-hesaplama", "finans/net-brut-maas-hesaplama", "finans/gelir-vergisi-hesaplama"],
  faq: [
    {
      question: "İhbar süresi kaç hafta?",
      answer: "4857 sayılı İş Kanunu'nun 17. maddesine göre bildirim süreleri işçinin kıdemine bağlıdır: işi 6 aydan az sürmüş işçi için 2 hafta, 6 aydan 1,5 yıla kadar 4 hafta, 1,5 yıldan 3 yıla kadar 6 hafta, 3 yıldan fazla sürmüş işçi için 8 haftadır. Bu süreler asgaridir; iş sözleşmesiyle artırılabilir ama azaltılamaz."
    },
    {
      question: "İhbar tazminatı nasıl hesaplanır?",
      answer: "İhbar süresinin gün karşılığı (2 hafta için 14 gün, 8 hafta için 56 gün) günlük giydirilmiş brüt ücretle çarpılır. Günlük ücret, aylık giydirilmiş brüt ücretin 30'a bölünmesiyle bulunur. Örneğin aylık 45.000 TL ücretle 3 yıldan fazla çalışan bir işçinin brüt ihbar tazminatı 56 × 1.500 = 84.000 TL'dir."
    },
    {
      question: "İhbar tazminatından vergi kesilir mi?",
      answer: "Evet. İhbar tazminatı gelir vergisinden istisna değildir; çalışanın kümülatif matrahına göre %15 ile %40 arasında gelir vergisi ve binde 7,59 damga vergisi kesilir. SGK primine tabi değildir. Bu nedenle net tutar, kıdem tazminatından farklı olarak vergi dilimine göre değişir."
    },
    {
      question: "İstifa eden işçi ihbar tazminatı alır mı?",
      answer: "Hayır. İhbar tazminatı, bildirim süresine uymadan sözleşmeyi fesheden tarafın karşı tarafa ödediği tazminattır. İşçi bildirim süresine uymadan istifa ederse işverene ihbar tazminatı ödemekle yükümlü olur. Haklı nedenle derhal fesihlerde (md. 24 ve 25) ihbar tazminatı doğmaz."
    },
    {
      question: "İşveren ihbar süresini çalıştırırsa ne olur?",
      answer: "İşveren ihbar süresi boyunca işçiyi çalıştırabilir; bu durumda tazminat ödenmez ancak işçiye yeni iş araması için günde en az 2 saat ücretli izin verilmesi gerekir. İşveren bu süre ücretini peşin ödeyerek sözleşmeyi hemen de sona erdirebilir. İş arama izni kullandırılmazsa bu saatlerin ücreti ayrıca ödenir."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcSelect
      id="calismaSuresi"
      label="Çalışma Süresi"
      options={sureOptions}
      value="3yil-ustu"
      helpText="Aynı işverende geçen toplam süre"
    />
    <CalcInput
      id="aylikBrutMaas"
      label="Aylık Giydirilmiş Brüt Ücret"
      type="number"
      suffix="₺"
      placeholder="45000"
      step="any"
      min={0}
      helpText="Düzenli yol, yemek vb. yan ödemeler dahil"
    />
    <CalcSelect
      id="gvOrani"
      label="Gelir Vergisi Dilimi"
      options={vergiOptions}
      value="15"
      helpText="Fesih ayındaki kümülatif matrahınıza göre dilim"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Net İhbar Tazminatı</p>
      <p class="calc-result-value" id="ihbar-tazminati">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">İhbar Süresi</span>
        <span class="calc-detail-value" id="ihbar-suresi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Günlük Brüt Ücret</span>
        <span class="calc-detail-value" id="gunluk-ucret">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Brüt İhbar Tazminatı</span>
        <span class="calc-detail-value" id="brut-tazminat">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Gelir Vergisi</span>
        <span class="calc-detail-value" id="gelir-vergisi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Damga Vergisi (binde 7,59)</span>
        <span class="calc-detail-value" id="damga">—</span>
      </div>
      <p class="calc-note">Hesaplama tahminidir; tazminat bir sonraki dilime taşıyorsa gelir vergisi biraz daha yüksek çıkabilir. SGK primi kesilmez.</p>
    </div>
  </CalcResult>

  <script type="application/json" id="ihbar-data" set:html={JSON.stringify({ sureler: legal.ihbarSureleri, stampTax: taxBrackets.stampTaxRate })}></script>

  <script>
    import { formatTL, readNumber, readValue, readJSON, setText, showResult, initCalculator, round2 } from './_shared';

    const data = readJSON<{ sureler: { key: string; label: string; weeks: number }[]; stampTax: number }>('ihbar-data');

    function calculate(): boolean {
      const sure = data.sureler.find((s) => s.key === readValue('calismaSuresi'));
      const aylik = readNumber('aylikBrutMaas');
      const gvOrani = readNumber('gvOrani');

      if (!sure || !(aylik > 0) || !(gvOrani >= 0)) {
        showResult(false);
        return false;
      }

      const gun = sure.weeks * 7;
      const gunluk = aylik / 30;
      const brut = round2(gun * gunluk);
      const gv = round2(brut * gvOrani / 100);
      const damga = round2(brut * data.stampTax / 100);
      const net = round2(brut - gv - damga);

      setText('ihbar-tazminati', formatTL(net));
      setText('ihbar-suresi', `${sure.weeks} hafta (${gun} gün)`);
      setText('gunluk-ucret', formatTL(gunluk));
      setText('brut-tazminat', formatTL(brut));
      setText('gelir-vergisi', formatTL(gv));
      setText('damga', formatTL(damga));

      showResult(true);
      return true;
    }

    initCalculator({
      calculate,
      onParams: (params) => {
        // Eski linkler günlük ücret taşıyordu: ?gunlukBrutMaas=...
        const gunluk = Number(params.get('gunlukBrutMaas'));
        const el = document.getElementById('aylikBrutMaas') as HTMLInputElement | null;
        if (el && gunluk > 0 && !params.has('aylikBrutMaas')) {
          el.value = String(round2(gunluk * 30));
          calculate();
        }
      },
    });
  </script>

  <section class="calc-content">
    <h2>İhbar Tazminatı Nedir?</h2>
    <p>
      Belirsiz süreli bir iş sözleşmesini feshetmek isteyen taraf, karşı tarafa önceden bildirimde bulunmak zorundadır. İşveren bu bildirim sürelerine uymadan işçiyi çıkarırsa, sürenin ücretini ihbar tazminatı olarak öder. Kural iki yönlüdür: bildirim süresine uymadan işi bırakan işçi de işverene aynı tutarı ödemekle yükümlüdür.
    </p>

    <h2>İhbar Süreleri (İş Kanunu md. 17)</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Çalışma süresi</th><th scope="col">Bildirim süresi</th><th scope="col">Gün</th></tr></thead>
        <tbody>
          {legal.ihbarSureleri.map((s) => (
            <tr><td>{s.label}</td><td>{s.weeks} hafta</td><td>{s.weeks * 7}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Örnek Hesaplama</h2>
    <p>
      4 yıldır aynı işyerinde çalışan ve aylık giydirilmiş brüt ücreti 45.000 TL olan bir işçi, bildirim yapılmadan işten çıkarılıyor. İhbar süresi 8 hafta, yani 56 gündür.
    </p>
    <ul>
      <li>Günlük brüt ücret: 45.000 ÷ 30 = 1.500 TL</li>
      <li>Brüt ihbar tazminatı: 56 × 1.500 = 84.000 TL</li>
      <li>Gelir vergisi (%15 dilimde): 12.600 TL</li>
      <li>Damga vergisi: 637,56 TL</li>
      <li>Net ihbar tazminatı: <strong>70.762,44 TL</strong></li>
    </ul>
    <p>
      Aynı işçinin kümülatif matrahı fesih ayında 190.000 TL'yi aşmışsa %20 dilim seçilmelidir; bu durumda gelir vergisi 16.800 TL, net tutar 66.562,44 TL olur.
    </p>

    <h2>Dikkat Edilmesi Gerekenler</h2>
    <ul>
      <li>Hesaplamada çıplak ücret değil, düzenli yan ödemelerin eklendiği giydirilmiş brüt ücret kullanılır.</li>
      <li>İhbar tazminatında kıdem tazminatındaki gibi bir tavan yoktur.</li>
      <li>Belirli süreli iş sözleşmeleri kendiliğinden sona erdiği için ihbar tazminatı doğmaz.</li>
      <li>İhbar tazminatı alacağı için zamanaşımı, fesih tarihinden itibaren beş yıldır.</li>
    </ul>
  </section>
</CalcLayout>
