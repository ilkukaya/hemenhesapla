---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Mevduat faizi nasıl hesaplanır?",
    answer: "Mevduat faizi basit faiz yöntemiyle hesaplanır. Brüt Faiz = Anapara × (Yıllık Faiz Oranı / 100) × (Vade Gün / 365) formülü kullanılır. Net faiz ise brüt faizden stopaj kesintisi düşüldükten sonra elde edilen tutardır. Örneğin 100.000 TL anaparayı %50 yıllık faizle 32 gün vadeli mevduata yatırdığınızda yaklaşık 4.384 TL brüt faiz elde edersiniz.",
  },
  {
    question: "Mevduat stopaj oranı ne kadardır?",
    answer: "2024 itibarıyla Türkiye'de mevduat faizlerinden uygulanan stopaj oranları vadeye göre değişmektedir: 6 aya kadar (dahil) vadeli mevduatta %15, 6 aydan 1 yıla kadar vadeli mevduatta %12, 1 yıl ve üzeri vadeli mevduatta %10 stopaj uygulanır. Katılım hesapları ile Türk lirası mevduatlar için oranlar farklılık gösterebilir.",
  },
  {
    question: "Mevduat faizini artırmak için ne yapılabilir?",
    answer: "Faiz getirisini artırmak için vadeyi uzatmak, anapara miktarını yükseltmek veya daha yüksek faiz oranı sunan bankaları tercih etmek etkilidir. Ayrıca bileşik faiz avantajından yararlanmak için vade sonunda faizi anaparaya ekleyerek yeniden yatırım yapabilirsiniz. Farklı bankaların mevduat kampanyalarını düzenli takip etmek de önemlidir.",
  },
];

const meta = {
  title: "Mevduat Faizi Hesaplama",
  description: "Banka mevduatı faiz getirinizi anında hesaplayın. Brüt faiz, stopaj kesintisi ve net faiz getirisi hesaplama aracı.",
  category: "finans",
  slug: "mevduat-faizi-hesaplama",
  keywords: ["mevduat faizi hesaplama", "faiz getirisi hesaplama", "banka faizi", "stopaj kesintisi", "net faiz hesaplama", "vadeli mevduat"],
  dateModified: "2026-04-01",
  relatedCalcs: ["bilesik-faiz-hesaplama", "enflasyon-hesaplama", "kredi-hesaplama"],
  faq,
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-6">
    <CalcInput
      id="anapara"
      label="Anapara"
      type="number"
      suffix="₺"
      placeholder="100000"
      step={1000}
      min={0}
    />
    <CalcInput
      id="faizOrani"
      label="Yıllık Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="50.00"
      step={0.01}
      min={0}
    />
    <CalcSelect
      id="vade"
      label="Vade"
      options={[
        { value: "32", label: "32 Gün" },
        { value: "91", label: "91 Gün" },
        { value: "181", label: "181 Gün" },
        { value: "365", label: "365 Gün" },
      ]}
      value="32"
    />
    <CalcSelect
      id="stopajOrani"
      label="Stopaj Oranı"
      options={[
        { value: "0", label: "%0" },
        { value: "5", label: "%5" },
        { value: "10", label: "%10" },
        { value: "12", label: "%12" },
        { value: "15", label: "%15" },
      ]}
      value="15"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <span class="calc-result-label">Net Faiz Getirisi</span>
      <span class="calc-result-value" id="net-faiz">—</span>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Brüt Faiz</span>
        <span class="calc-detail-value" id="brut-faiz">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Stopaj Kesintisi</span>
        <span class="calc-detail-value" id="stopaj-kesinti">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Vade Sonu Toplam</span>
        <span class="calc-detail-value" id="vade-sonu">—</span>
      </div>
    </div>
  </CalcResult>

  <section class="calc-content">
    <h2>Mevduat Faizi Hesaplama Nasıl Yapılır?</h2>
    <p>
      Vadeli mevduat, birikimlerinizi belirli bir süre boyunca bankada tutarak faiz geliri elde etmenizi sağlayan en yaygın tasarruf araçlarından biridir. Mevduat faizi hesaplama aracımız sayesinde anaparanızı, yıllık faiz oranını, vade süresini ve stopaj oranını girerek net kazancınızı saniyeler içinde öğrenebilirsiniz.
    </p>
    <h3>Mevduat Faizi Formülü</h3>
    <p>
      Türk bankalarında vadeli mevduat faizi basit faiz yöntemiyle hesaplanır. Formül şu şekildedir:
    </p>
    <p>
      <strong>Brüt Faiz = Anapara × (Yıllık Faiz Oranı / 100) × (Vade Gün Sayısı / 365)</strong>
    </p>
    <p>
      <strong>Net Faiz = Brüt Faiz − (Brüt Faiz × Stopaj Oranı / 100)</strong>
    </p>
    <p>
      Vade sonunda hesabınıza yatırılan tutar ise anaparanız ile net faizin toplamına eşittir.
    </p>
    <h3>Stopaj Kesintisi Nedir?</h3>
    <p>
      Mevduat faiz gelirleri üzerinden devlet tarafından stopaj (gelir vergisi kesintisi) alınır. Bu kesinti vadeye göre değişmekle birlikte yaygın uygulama %15 oranındadır. Stopaj tutarı, elde edilen brüt faiz üzerinden otomatik olarak banka tarafından kesilir ve doğrudan devlete aktarılır; bu nedenle hesabınıza net faiz tutarı yatar.
    </p>
    <h3>Dikkat Edilmesi Gerekenler</h3>
    <p>
      Mevduat faizi değerlendirmesinde yalnızca nominal (yüzde) oranına değil, enflasyon oranına da dikkat etmelisiniz. Faiz oranının enflasyon oranının altında kaldığı dönemlerde mevduatın reel getirisi negatif olabilir. Enflasyona karşı koruma sağlamak için TÜFE'ye endeksli mevduat hesaplarını veya alternatif yatırım araçlarını değerlendirebilirsiniz. Ayrıca hesap açmadan önce bankanın TMSF güvencesi kapsamındaki limit olan 1.000.000 TL'yi göz önünde bulundurun.
    </p>
    <h3>Sıkça Sorulan Sorular</h3>
    {faq.map((item) => (
      <div class="faq-item">
        <h4>{item.question}</h4>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</CalcLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('#calc-form input, #calc-form select');
    const resultArea = document.getElementById('calc-result');

    function debounce(fn: (...args: unknown[]) => void, delay = 150) {
      let timer: ReturnType<typeof setTimeout>;
      return (...args: unknown[]) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), delay); };
    }

    function formatTL(num: number) {
      return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
    }

    const debouncedCalc = debounce(calculate);
    inputs.forEach(input => {
      input.addEventListener('input', debouncedCalc);
      input.addEventListener('change', debouncedCalc);
    });

    function calculate() {
      const anapara = parseFloat((document.getElementById('anapara') as HTMLInputElement).value);
      const faizOrani = parseFloat((document.getElementById('faizOrani') as HTMLInputElement).value);
      const vade = parseInt((document.getElementById('vade') as HTMLSelectElement).value);
      const stopaj = parseFloat((document.getElementById('stopajOrani') as HTMLSelectElement).value);

      if (!anapara || !faizOrani || !vade || anapara <= 0 || faizOrani <= 0) {
        if (resultArea) resultArea.classList.add('hidden');
        return;
      }

      const brutFaiz = anapara * (faizOrani / 100) * (vade / 365);
      const stopajKesinti = brutFaiz * (stopaj / 100);
      const netFaiz = brutFaiz - stopajKesinti;
      const vadeSonu = anapara + netFaiz;

      (document.getElementById('net-faiz') as HTMLElement).textContent = formatTL(netFaiz);
      (document.getElementById('brut-faiz') as HTMLElement).textContent = formatTL(brutFaiz);
      (document.getElementById('stopaj-kesinti') as HTMLElement).textContent = formatTL(stopajKesinti);
      (document.getElementById('vade-sonu') as HTMLElement).textContent = formatTL(vadeSonu);

      if (resultArea) resultArea.classList.remove('hidden');
      updateURL();
    }

    function updateURL() {
      const params = new URLSearchParams();
      inputs.forEach(input => {
        const el = input as HTMLInputElement;
        if (el.value && el.id) params.set(el.id, el.value);
      });
      history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
    }

    function loadFromURL() {
      const params = new URLSearchParams(window.location.search);
      let hasParams = false;
      inputs.forEach(input => {
        const el = input as HTMLInputElement;
        if (el.id && params.has(el.id)) { el.value = params.get(el.id)!; hasParams = true; }
      });
      if (hasParams) calculate();
    }

    loadFromURL();
  });
</script>
