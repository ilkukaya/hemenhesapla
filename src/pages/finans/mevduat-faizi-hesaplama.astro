---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';
import legal from '../../data/legal-2026.json';

const tiers = legal.mevduatStopaj.tiers;
const stopajOptions = [
  { value: "oto", label: "Vadeye göre otomatik (2026)" },
  ...tiers.map((t) => ({ value: String(t.rate), label: `%${String(t.rate).replace('.', ',')} – ${t.label}` })),
  { value: "0", label: "%0 (stopajsız)" },
];

const meta = {
  title: "Mevduat Faizi Hesaplama",
  seoTitle: "Mevduat Faizi Hesaplama 2026 – Net Getiri ve Stopaj",
  description: "Mevduat faizi hesaplama 2026: anapara, yıllık faiz ve vade gününe göre brüt faizi, vadeye göre %17,5 / %15 / %10 stopajı ve net getirinizi hesaplayın.",
  summary: "Mevduat brüt faizi = Anapara × Yıllık faiz × Gün ÷ 365. Brüt faizden stopaj düşülerek net faiz bulunur; 2026'da TL mevduatta stopaj 6 aya kadar vadede %17,5, 1 yıla kadar %15, daha uzun vadede %10'dur. Örneğin 100.000 TL, %40 faiz ve 32 günde brüt 3.506,85 TL, net 2.893,15 TL getirir.",
  howTo: [
    "Yatırmak istediğiniz anaparayı girin.",
    "Bankanın verdiği yıllık brüt faiz oranını yazın.",
    "Vade gün sayısını girin (32, 46, 92, 181, 365 gibi).",
    "Stopaj oranını otomatik bırakın ya da hesabınızın oranını seçin; net getiriyi ve vade sonu tutarını görün."
  ],
  sources: [
    { name: "10041 sayılı Cumhurbaşkanı Kararı – mevduat stopaj oranları (Resmî Gazete)", url: "https://www.resmigazete.gov.tr/eskiler/2025/07/20250709-6.pdf" },
    { name: "TCMB – Para Politikası Kurulu kararları (2026)", url: "https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Temel+Faaliyetler/Para+Politikasi/PPK/2026" }
  ],
  category: "finans",
  slug: "mevduat-faizi-hesaplama",
  keywords: ["mevduat faizi hesaplama", "32 günlük faiz hesaplama", "mevduat stopaj oranı 2026", "net faiz getirisi", "vadeli mevduat hesaplama", "faiz getirisi hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/bilesik-faiz-hesaplama", "finans/enflasyon-hesaplama", "finans/yatirim-getiri-hesaplama", "finans/stopaj-hesaplama"],
  faq: [
    {
      question: "2026'da mevduat stopaj oranı kaç?",
      answer: "TL vadeli mevduatta stopaj; vadesiz ve 6 aya kadar vadeli hesaplarda %17,5, 1 yıla kadar vadeli hesaplarda %15, 1 yıldan uzun vadelilerde %10'dur. Bu oranlar 9 Temmuz 2025'te yürürlüğe girdi ve süresi 31 Aralık 2026'ya kadar uzatıldı. Oran, hesabın açıldığı ya da vadenin yenilendiği tarihte geçerli olan karara göre belirlenir."
    },
    {
      question: "Mevduat faizi nasıl hesaplanır?",
      answer: "Brüt faiz, anapara × yıllık faiz oranı × vade günü ÷ 365 formülüyle hesaplanır. Bu tutardan stopaj kesilir, kalan net faiz vade sonunda anaparaya eklenir. Örneğin 250.000 TL, %42 yıllık faiz ve 32 gün vadede brüt faiz 9.205,48 TL, %17,5 stopaj sonrası net faiz 7.594,52 TL'dir."
    },
    {
      question: "100.000 TL'nin 32 günlük faizi ne kadar?",
      answer: "Yıllık %40 brüt faiz oranıyla 100.000 TL'nin 32 günlük brüt faizi 3.506,85 TL'dir. %17,5 stopaj (613,70 TL) düşülünce net getiri 2.893,15 TL olur. Faiz oranı bankaya ve tutara göre değiştiği için kendi oranınızı hesaplayıcıya girerek sonucu güncelleyebilirsiniz."
    },
    {
      question: "Vade yenilendiğinde faiz bileşik mi işler?",
      answer: "Vade sonunda net faiz anaparaya eklenir ve hesap aynı koşullarla yenilenirse bir sonraki dönemde bu toplam üzerinden faiz işler. Böylece kısa vadeli mevduatın yıllık getirisi bileşik etkiyle nominal orandan biraz yüksek olur. Birden çok dönem için Bileşik Faiz Hesaplama aracını kullanabilirsiniz."
    },
    {
      question: "Mevduat faizi enflasyona karşı koruyor mu?",
      answer: "Reel getiri, net faiz oranı ile enflasyon arasındaki farka bağlıdır. Net yıllık getiriniz yıllık enflasyonun altındaysa paranızın satın alma gücü azalır. Karşılaştırma için stopaj sonrası yıllık getiriyi TÜİK'in açıkladığı yıllık TÜFE ile kıyaslayın; reel getiri (1 + net getiri) ÷ (1 + enflasyon) − 1 formülüyle bulunur."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="anapara"
      label="Anapara"
      type="number"
      suffix="₺"
      placeholder="100000"
      step="any"
      min={0}
    />
    <CalcInput
      id="faizOrani"
      label="Yıllık Brüt Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="40"
      step="any"
      min={0}
    />
    <CalcInput
      id="vade"
      label="Vade"
      type="number"
      suffix="gün"
      placeholder="32"
      value="32"
      step={1}
      min={1}
      max={3650}
    />
    <CalcSelect
      id="stopajOrani"
      label="Stopaj Oranı"
      options={stopajOptions}
      value="oto"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Net Faiz Getirisi</p>
      <p class="calc-result-value" id="net-faiz">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Brüt Faiz</span>
        <span class="calc-detail-value" id="brut-faiz">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label" id="stopaj-label">Stopaj Kesintisi</span>
        <span class="calc-detail-value" id="stopaj-kesinti">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Vade Sonu Toplam</span>
        <span class="calc-detail-value" id="vade-sonu">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Net Yıllık Getiri Oranı</span>
        <span class="calc-detail-value" id="net-oran">—</span>
      </div>
    </div>
  </CalcResult>

  <script type="application/json" id="mevduat-data" set:html={JSON.stringify(tiers)}></script>

  <script>
    import { formatTL, formatPercent, formatNumber, readNumber, readValue, readJSON, setText, showResult, initCalculator, round2 } from './_shared';

    const tiers = readJSON<{ maxDays: number | null; rate: number; label: string }[]>('mevduat-data');

    function autoRate(gun: number): number {
      const t = tiers.find((x) => x.maxDays === null || gun <= x.maxDays);
      return t ? t.rate : 0;
    }

    function calculate(): boolean {
      const anapara = readNumber('anapara');
      const faiz = readNumber('faizOrani');
      const gun = Math.round(readNumber('vade'));
      const secim = readValue('stopajOrani');

      if (!(anapara > 0) || !(faiz >= 0) || !(gun >= 1)) {
        showResult(false);
        return false;
      }

      const stopajOrani = secim === 'oto' || secim === '' ? autoRate(gun) : Number(secim);
      const brut = round2(anapara * (faiz / 100) * (gun / 365));
      const stopaj = round2(brut * stopajOrani / 100);
      const net = round2(brut - stopaj);

      setText('net-faiz', formatTL(net));
      setText('brut-faiz', formatTL(brut));
      setText('stopaj-label', `Stopaj Kesintisi (%${formatNumber(stopajOrani, 0, 2)})`);
      setText('stopaj-kesinti', formatTL(stopaj));
      setText('vade-sonu', formatTL(anapara + net));
      setText('net-oran', formatPercent((net / anapara) * (365 / gun) * 100));

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Mevduat Faizi Nasıl Hesaplanır?</h2>
    <p>
      Türk bankaları vadeli mevduatta basit faiz uygular ve yılı 365 gün kabul eder. Vade sonunda hesaplanan brüt faizden stopaj (gelir vergisi kesintisi) düşülür, kalan net faiz anaparaya eklenir.
    </p>
    <ul>
      <li><strong>Brüt faiz</strong> = Anapara × Yıllık faiz oranı × Vade (gün) ÷ 365</li>
      <li><strong>Stopaj</strong> = Brüt faiz × Stopaj oranı</li>
      <li><strong>Net faiz</strong> = Brüt faiz − Stopaj</li>
    </ul>

    <h2>2026 TL Mevduat Stopaj Oranları</h2>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Vade</th><th scope="col">Stopaj oranı</th></tr></thead>
        <tbody>
          {tiers.map((t) => (
            <tr><td>{t.label}</td><td>%{String(t.rate).replace('.', ',')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Oranlar 10041 sayılı Cumhurbaşkanı Kararı ile belirlendi ve 20 Haziran 2026 tarihli karar ile 31 Aralık 2026'ya kadar uzatıldı. Döviz tevdiat hesaplarında farklı oranlar uygulanır.
    </p>

    <h2>Örnek Hesaplama</h2>
    <p>
      250.000 TL'yi yıllık %42 brüt faizle 32 günlük vadeye yatırdığınızı düşünelim. Brüt faiz 250.000 × 0,42 × 32 ÷ 365 = 9.205,48 TL olur. Vade 6 aydan kısa olduğu için %17,5 stopaj uygulanır: 1.610,96 TL. Net faiz <strong>7.594,52 TL</strong>, vade sonunda hesabınızda 257.594,52 TL bulunur. Bu, stopaj sonrası yaklaşık %34,65'lik basit yıllık getiriye karşılık gelir.
    </p>

    <h3>Getiriyi Etkileyen Diğer Konular</h3>
    <ul>
      <li>Bankalar tutar ve vade aralığına göre farklı oran verir; ilan edilen "hoş geldin" oranları çoğu zaman yalnızca ilk vade için geçerlidir.</li>
      <li>Vadeyi bozarsanız o dönemin faizini genellikle kaybedersiniz.</li>
      <li>Mevduatınız, kişi başına ve banka başına belirli bir tutara kadar TMSF güvencesindedir.</li>
    </ul>
  </section>
</CalcLayout>
