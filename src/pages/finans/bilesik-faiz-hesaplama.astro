---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcSelect from '../../components/calculator/CalcSelect.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const periyotlar = [
  { value: "1", label: "Yıllık" },
  { value: "4", label: "3 aylık (çeyreklik)" },
  { value: "12", label: "Aylık" },
  { value: "365", label: "Günlük" },
];

const meta = {
  title: "Bileşik Faiz Hesaplama",
  seoTitle: "Bileşik Faiz Hesaplama – Faizin Faizi ve Efektif Oran",
  description: "Bileşik faiz hesaplama: anapara, yıllık faiz, süre ve bileşim sıklığına göre vade sonu tutarı, faiz getirisi ve efektif yıllık oranı hesaplayın; isteğe bağlı aylık ekleme.",
  summary: "Bileşik faizde vade sonu tutar = Anapara × (1 + r/m)^(m×t) formülüyle bulunur; r yıllık nominal faiz, m yıllık bileşim sayısı, t yıl sayısıdır. Örneğin 100.000 TL, yıllık %36 nominal faiz ve aylık bileşimle 3 yılda 289.827,83 TL olur; efektif yıllık oran %42,58'dir.",
  howTo: [
    "Başlangıç anaparanızı girin.",
    "Yıllık nominal faiz oranını ve yatırım süresini (yıl) yazın.",
    "Faizin ne sıklıkla anaparaya ekleneceğini seçin.",
    "İsterseniz her ay düzenli olarak ekleyeceğiniz tutarı girin.",
    "Vade sonu tutarı, toplam faiz ve efektif yıllık oranı görün."
  ],
  sources: [
    { name: "TCMB – Para Politikası Kurulu kararları (2026)", url: "https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Temel+Faaliyetler/Para+Politikasi/PPK/2026" }
  ],
  category: "finans",
  slug: "bilesik-faiz-hesaplama",
  keywords: ["bileşik faiz hesaplama", "faizin faizi hesaplama", "bileşik faiz formülü", "efektif yıllık faiz", "aylık bileşik faiz", "birikim hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/mevduat-faizi-hesaplama", "finans/yatirim-getiri-hesaplama", "finans/enflasyon-hesaplama", "gunluk/tasarruf-hesaplama"],
  faq: [
    {
      question: "Bileşik faiz formülü nedir?",
      answer: "Bileşik faiz formülü A = P × (1 + r/m)^(m×t) şeklindedir. P anapara, r yıllık nominal faiz oranı, m yıl içindeki bileşim sayısı (aylık için 12), t yıl sayısıdır. Faiz getirisi A − P olarak bulunur. Basit faizden farkı, her dönemin faizinin anaparaya eklenip sonraki dönemde faiz kazanmasıdır."
    },
    {
      question: "Basit faiz ile bileşik faiz arasındaki fark nedir?",
      answer: "Basit faizde faiz hep ilk anapara üzerinden hesaplanır. Bileşik faizde ise kazanılan faiz anaparaya eklenir ve bir sonraki dönem faiz, büyüyen tutar üzerinden işler. 100.000 TL'nin %36 faizle 3 yıllık basit faizi 108.000 TL iken, yıllık bileşik faizle 151.545,60 TL olur."
    },
    {
      question: "Efektif yıllık faiz oranı nasıl hesaplanır?",
      answer: "Efektif yıllık oran = (1 + r/m)^m − 1 formülüyle bulunur. Yıllık %36 nominal faiz aylık bileşimle efektif olarak %42,58, günlük bileşimle %43,31 getiri sağlar. Farklı bileşim sıklıklarına sahip yatırım ürünlerini karşılaştırırken efektif oranı kullanmak gerekir."
    },
    {
      question: "Param kaç yılda ikiye katlanır?",
      answer: "Pratik bir kestirim için 72 kuralı kullanılır: 72'yi yıllık yüzde getiriye bölün. %24 yıllık bileşik getiriyle para yaklaşık 3 yılda ikiye katlanır. Kesin süre ln(2) ÷ ln(1 + r) formülüyle hesaplanır; %24 için bu süre 3,22 yıldır."
    },
    {
      question: "Bileşik faiz hesabında vergi dikkate alınıyor mu?",
      answer: "Bu hesaplayıcı brüt getiriyi gösterir. Türkiye'de mevduat faizinden vadeye göre %10–%17,5 stopaj kesilir; net getiriyi bulmak için faiz oranını (1 − stopaj oranı) ile çarparak girebilirsiniz. Örneğin %40 brüt faiz ve %17,5 stopajda net oran %33'tür."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="anapara"
      label="Anapara"
      type="number"
      suffix="₺"
      placeholder="100000"
      step="any"
      min={0}
    />
    <CalcInput
      id="yillikFaiz"
      label="Yıllık Nominal Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="36"
      step="any"
      min={0}
    />
    <CalcInput
      id="sure"
      label="Süre"
      type="number"
      suffix="yıl"
      placeholder="3"
      step="any"
      min={0}
      max={100}
      helpText="Kesirli değer girebilirsiniz (ör. 1,5)"
    />
    <CalcSelect
      id="bilesikPeriyot"
      label="Bileşim Sıklığı"
      options={periyotlar}
      value="12"
    />
    <CalcInput
      id="aylikEkleme"
      label="Aylık Ek Yatırım"
      type="number"
      suffix="₺"
      placeholder="0"
      step="any"
      min={0}
      required={false}
      helpText="İsteğe bağlı; her ay sonunda eklenir"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Vade Sonu Tutar</p>
      <p class="calc-result-value" id="toplam-tutar">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Yatırılan</span>
        <span class="calc-detail-value" id="toplam-yatirilan">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Faiz Getirisi</span>
        <span class="calc-detail-value" id="faiz-getirisi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Efektif Yıllık Oran</span>
        <span class="calc-detail-value" id="efektif-oran">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Aynı Sürede Basit Faiz Getirisi</span>
        <span class="calc-detail-value" id="basit-faiz">—</span>
      </div>
      <p class="calc-note">Vergi (stopaj) dikkate alınmamıştır; net getiri için faiz oranını stopaj sonrası değerle girin.</p>
    </div>
  </CalcResult>

  <script>
    import { formatTL, formatPercent, readNumber, setText, showResult, initCalculator } from './_shared';

    function calculate(): boolean {
      const P = readNumber('anapara');
      const faiz = readNumber('yillikFaiz');
      const t = readNumber('sure');
      const m = Math.round(readNumber('bilesikPeriyot')) || 12;
      const ek = Math.max(0, readNumber('aylikEkleme') || 0);

      if (!(P >= 0) || !(faiz >= 0) || !(t > 0) || t > 100 || (P === 0 && ek === 0)) {
        showResult(false);
        return false;
      }

      const r = faiz / 100;
      const buyume = Math.pow(1 + r / m, m * t);
      let toplam = P * buyume;

      // Aylık eklemeler: her ay sonunda yatırılan tutar, kalan süre boyunca aynı efektif oranla büyür.
      const aylar = Math.floor(t * 12 + 1e-9);
      const aylikCarpan = Math.pow(1 + r / m, m / 12);
      for (let k = 1; k <= aylar; k++) {
        toplam += ek * Math.pow(aylikCarpan, aylar - k) * Math.pow(1 + r / m, m * (t - aylar / 12));
      }
      const yatirilan = P + ek * aylar;
      const efektif = (Math.pow(1 + r / m, m) - 1) * 100;
      const basit = P * r * t;

      setText('toplam-tutar', formatTL(toplam));
      setText('toplam-yatirilan', formatTL(yatirilan));
      setText('faiz-getirisi', formatTL(toplam - yatirilan));
      setText('efektif-oran', formatPercent(efektif));
      setText('basit-faiz', ek > 0 ? `${formatTL(basit)} (yalnız anapara)` : formatTL(basit));

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Bileşik Faiz Nedir?</h2>
    <p>
      Bileşik faiz, kazanılan faizin anaparaya eklenerek bir sonraki dönemde onun da faiz kazanmasıdır; halk arasında "faizin faizi" denir. Süre uzadıkça ve bileşim sıklığı arttıkça etkisi büyür. Vadesi dolduğunda otomatik yenilenen mevduat hesapları, bileşik faizin en yaygın örneğidir.
    </p>
    <p><strong>Formül:</strong> A = P × (1 + r/m)<sup>m×t</sup></p>

    <h2>Örnek Hesaplama</h2>
    <p>
      100.000 TL'yi yıllık %36 nominal faizle 3 yıl değerlendirdiğinizi düşünün. Bileşim sıklığı sonucu şöyle değiştirir:
    </p>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Bileşim</th><th scope="col">Vade sonu tutar</th><th scope="col">Efektif yıllık oran</th></tr></thead>
        <tbody>
          <tr><td>Basit faiz</td><td>208.000,00 TL</td><td>%36,00</td></tr>
          <tr><td>Yıllık</td><td>251.545,60 TL</td><td>%36,00</td></tr>
          <tr><td>3 aylık</td><td>281.266,48 TL</td><td>%41,16</td></tr>
          <tr><td>Aylık</td><td>289.827,83 TL</td><td>%42,58</td></tr>
          <tr><td>Günlük</td><td>294.311,27 TL</td><td>%43,31</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Reel Getiriyi Unutmayın</h2>
    <p>
      Bileşik faiz nominal tutarı büyütür, ancak aynı dönemde fiyatlar da artar. Yatırımınızın satın alma gücünü korumak için net (stopaj sonrası) getirinin enflasyonun üzerinde olması gerekir. Reel getiri yaklaşık olarak (1 + nominal getiri) ÷ (1 + enflasyon) − 1 formülüyle bulunur.
    </p>
  </section>
</CalcLayout>
