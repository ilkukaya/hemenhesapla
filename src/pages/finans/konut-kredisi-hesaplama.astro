---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const faq = [
  {
    question: "Konut kredisi taksiti nasıl hesaplanır?",
    answer: "Konut kredisi taksiti anüite formülüyle hesaplanır: Aylık Taksit = Anapara × [r × (1+r)^n] / [(1+r)^n − 1]. Burada r aylık faiz oranı, n ise vade (ay sayısı) olup tüm taksitler eşit tutarda kalır. Konut değerleme raporu, tapu harcı ve zorunlu deprem sigortası (DASK) gibi ek masraflar taksit hesaplamasına dahil değildir, ayrıca planlanmalıdır."
  },
  {
    question: "Konut kredisinde sigorta neden önemlidir?",
    answer: "Bankalar konut kredisi kullandırımında genellikle zorunlu deprem sigortası (DASK) ve hayat sigortası talep eder. Konut sigortası ise isteğe bağlı olmakla birlikte yaygın şekilde önerilir. Bu sigorta bedelleri toplam kredi maliyetini artırır; hesap ederken bu tutarları da dahil etmek gerçekçi bir bütçe planlaması yapmanızı sağlar."
  },
  {
    question: "Konut kredisinde maksimum vade kaç yıldır?",
    answer: "Türkiye'de konut kredilerinde yasal azami vade 120 aydır (10 yıl). Ancak bazı bankalar belirli koşullarda daha uzun vade sunabilir. Vade uzadıkça aylık taksit düşer fakat toplam ödenecek faiz yükü artar. Kendi finansal durumunuza ve konutun kullanım amacına göre en uygun vadeyi seçmeniz önerilir."
  }
];

const meta = {
  title: "Konut Kredisi Hesaplama",
  description: "Konut kredisi aylık taksit, toplam ödeme ve toplam faiz tutarını anında hesaplayın. Sigorta maliyetini de dahil eden ücretsiz konut kredisi hesaplama aracı.",
  category: "finans",
  slug: "konut-kredisi-hesaplama",
  keywords: ["konut kredisi hesaplama", "mortgage hesaplama", "ev kredisi taksit", "konut kredisi faiz", "konut kredisi toplam maliyet"],
  dateModified: "2026-04-01",
  relatedCalcs: ["tasit-kredisi-hesaplama", "kredi-hesaplama", "mevduat-faizi-hesaplama"],
  faq,
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-6">
    <CalcInput
      id="tutar"
      label="Kredi Tutarı"
      type="number"
      suffix="₺"
      placeholder="500000"
      step={1000}
      min={50000}
    />
    <CalcInput
      id="faiz"
      label="Aylık Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="3.50"
      step={0.01}
      min={0.01}
    />
    <CalcInput
      id="vade"
      label="Vade"
      type="number"
      suffix="ay"
      placeholder="120"
      step={12}
      min={12}
      max={360}
    />
    <CalcInput
      id="sigorta"
      label="Sigorta Bedeli"
      type="number"
      suffix="₺"
      placeholder="0"
      step={100}
      min={0}
      value="0"
      helpText="İsteğe bağlı"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <span class="calc-result-label">Aylık Taksit</span>
      <span class="calc-result-value" id="aylik-taksit">—</span>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Ödeme</span>
        <span class="calc-detail-value" id="toplam-odeme">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Faiz</span>
        <span class="calc-detail-value" id="toplam-faiz">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Sigorta Dahil Toplam Maliyet</span>
        <span class="calc-detail-value" id="toplam-maliyet">—</span>
      </div>
    </div>
  </CalcResult>

  <section class="calc-content">
    <h2>Konut Kredisi Hesaplama Nasıl Yapılır?</h2>
    <p>
      Konut kredisi, bir ev veya daire satın almak için bankalardan uzun vadeli olarak kullanılan bir finansman aracıdır. Türkiye'de konut kredileri genellikle 12 ila 120 ay (1-10 yıl) arasında vadelendirilir ve sabit ya da değişken faizli olabilir. Aylık taksit tutarını önceden bilmek, bütçenizi doğru planlamanız açısından kritik önem taşır.
    </p>
    <h3>Konut Kredisi Taksit Formülü</h3>
    <p>
      Bankalar konut kredisi taksitini <strong>anüite yöntemi</strong> ile hesaplar. Formül şu şekildedir:
    </p>
    <p>
      <strong>Aylık Taksit = P × [r × (1+r)^n] / [(1+r)^n − 1]</strong>
    </p>
    <p>
      Bu formülde P kredi tutarını, r aylık faiz oranını (yüzde / 100), n ise vadeyi (ay) temsil eder. Tüm taksitler eşit tutarda olup her taksitte ödenen faiz payı giderek azalırken anapara payı artar.
    </p>
    <h3>Sigorta Maliyetinin Önemi</h3>
    <p>
      Konut kredisi kullanırken DASK (zorunlu deprem sigortası) ve banka tarafından talep edilen konut sigortası ile hayat sigortası gibi ek kalemler toplam maliyeti önemli ölçüde artırabilir. Hesap aracımızdaki sigorta bedeli alanına bu masrafları girerek gerçek toplam maliyeti görebilirsiniz. Sigorta poliçesi tek seferlik ödeme yerine yıllık ya da kredi süresine yayılmış şekilde de ödenebilir.
    </p>
    <h3>Dikkat Edilmesi Gerekenler</h3>
    <p>
      Konut kredisi seçerken yalnızca aylık taksit miktarına odaklanmak yanıltıcı olabilir. Dosya masrafı, ekspertiz ücreti, tapu harcı ve ipotek tesis ücreti gibi başlangıç giderleri de bütçenize eklenmesi gereken kalemlerdir. Farklı bankaların tekliflerini karşılaştırırken <strong>Yıllık Maliyet Oranı (YMO)</strong> en doğru karşılaştırma ölçütüdür; çünkü tüm masrafları tek bir orana yansıtır.
    </p>
    <h3>Sıkça Sorulan Sorular</h3>
    {faq.map((item) => (
      <div class="faq-item">
        <h4>{item.question}</h4>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</CalcLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('#calc-form input, #calc-form select');
    const resultArea = document.getElementById('calc-result');

    function debounce(fn: (...args: unknown[]) => void, delay = 150) {
      let timer: ReturnType<typeof setTimeout>;
      return (...args: unknown[]) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), delay); };
    }

    function formatTL(num: number) {
      return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
    }

    const debouncedCalc = debounce(calculate);
    inputs.forEach(input => {
      input.addEventListener('input', debouncedCalc);
      input.addEventListener('change', debouncedCalc);
    });

    function calculate() {
      const tutar = parseFloat((document.getElementById('tutar') as HTMLInputElement).value);
      const faiz = parseFloat((document.getElementById('faiz') as HTMLInputElement).value);
      const vade = parseInt((document.getElementById('vade') as HTMLInputElement).value);
      const sigorta = parseFloat((document.getElementById('sigorta') as HTMLInputElement).value) || 0;

      if (!tutar || !faiz || !vade || tutar <= 0 || faiz <= 0 || vade <= 0) {
        if (resultArea) resultArea.classList.add('hidden');
        return;
      }

      const r = faiz / 100;
      const pow = Math.pow(1 + r, vade);
      const aylikTaksit = tutar * r * pow / (pow - 1);
      const toplamOdeme = aylikTaksit * vade;
      const toplamFaiz = toplamOdeme - tutar;
      const toplamMaliyet = toplamOdeme + sigorta;

      (document.getElementById('aylik-taksit') as HTMLElement).textContent = formatTL(aylikTaksit);
      (document.getElementById('toplam-odeme') as HTMLElement).textContent = formatTL(toplamOdeme);
      (document.getElementById('toplam-faiz') as HTMLElement).textContent = formatTL(toplamFaiz);
      (document.getElementById('toplam-maliyet') as HTMLElement).textContent = formatTL(toplamMaliyet);

      if (resultArea) resultArea.classList.remove('hidden');
      updateURL();
    }

    function updateURL() {
      const params = new URLSearchParams();
      inputs.forEach(input => {
        const el = input as HTMLInputElement;
        if (el.value && el.id) params.set(el.id, el.value);
      });
      history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
    }

    function loadFromURL() {
      const params = new URLSearchParams(window.location.search);
      let hasParams = false;
      inputs.forEach(input => {
        const el = input as HTMLInputElement;
        if (el.id && params.has(el.id)) { el.value = params.get(el.id)!; hasParams = true; }
      });
      if (hasParams) calculate();
    }

    loadFromURL();
  });
</script>
