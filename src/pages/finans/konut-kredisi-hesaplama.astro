---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const meta = {
  title: "Konut Kredisi Hesaplama",
  seoTitle: "Konut Kredisi Hesaplama 2026 – Taksit ve Toplam Maliyet",
  description: "Konut kredisi hesaplama 2026: kredi tutarı, aylık faiz ve vadeye göre aylık taksiti, toplam faizi, sigorta dahil toplam maliyeti ve ay ay ödeme planını görün.",
  summary: "Konut kredisi taksiti eşit taksit formülüyle hesaplanır: Taksit = K × r(1+r)^n ÷ ((1+r)^n − 1). Konut kredileri KKDF ve BSMV'den muaf olduğu için r doğrudan aylık faiz oranıdır. Örneğin 2.000.000 TL, aylık %2,79 faiz ve 120 ay vadede taksit 57.932,14 TL, toplam geri ödeme 6.951.856,76 TL'dir.",
  howTo: [
    "Çekmek istediğiniz kredi tutarını girin.",
    "Bankanın konut kredisi için verdiği aylık faiz oranını yazın.",
    "Vadeyi ay olarak girin (ör. 60, 120, 180).",
    "İsterseniz DASK, konut ve hayat sigortası ile ekspertiz gibi ek masrafların toplamını ekleyin.",
    "Aylık taksiti, toplam maliyeti ve ödeme planını inceleyin."
  ],
  sources: [
    { name: "TCMB – Para Politikası Kurulu kararları (2026)", url: "https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Temel+Faaliyetler/Para+Politikasi/PPK/2026" },
    { name: "BDDK", url: "https://www.bddk.org.tr/" }
  ],
  category: "finans",
  slug: "konut-kredisi-hesaplama",
  keywords: ["konut kredisi hesaplama", "ev kredisi hesaplama", "konut kredisi taksit", "mortgage hesaplama", "konut kredisi faiz 2026", "konut kredisi ödeme planı"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/kredi-hesaplama", "finans/tasit-kredisi-hesaplama", "finans/kira-artis-hesaplama", "finans/tapu-harci-hesaplama"],
  faq: [
    {
      question: "Konut kredisi taksiti nasıl hesaplanır?",
      answer: "Konut kredisinde taksit, eşit taksit (annüite) formülüyle bulunur: Taksit = Kredi × r × (1+r)^n ÷ ((1+r)^n − 1). r aylık faiz oranı, n vadedir. İhtiyaç kredisinden farklı olarak konut kredisinde KKDF ve BSMV alınmaz, bu nedenle aynı faiz oranında taksit daha düşük çıkar."
    },
    {
      question: "Konut kredisinde KKDF ve BSMV var mı?",
      answer: "Hayır. Bireysel konut kredileri KKDF ve BSMV'den muaftır. Bu, ihtiyaç kredisine göre önemli bir avantajdır: ihtiyaç kredisinde faiz üzerine toplam %30 vergi eklenirken, konut kredisinde taksit yalnızca faiz ve ana paradan oluşur. Sigorta ve ekspertiz gibi masraflar ise ayrıca ödenir."
    },
    {
      question: "Konut kredisi ile evin yüzde kaçı finanse edilebilir?",
      answer: "BDDK düzenlemeleri, konut kredisinde kullandırılabilecek tutarı konutun ekspertiz değerine ve enerji sınıfına, ilk el ya da ikinci el olmasına göre sınırlar. Oranlar dönem dönem değiştiği için kredi başvurusu öncesinde bankanızdan güncel kredi/değer oranını öğrenin; kalan kısım peşinat olarak ödenir."
    },
    {
      question: "Konut kredisi çekerken hangi masraflar ödenir?",
      answer: "Başlıca masraflar ekspertiz ücreti, zorunlu deprem sigortası (DASK), bankanın talep ettiği konut ve hayat sigortaları ve tapu harcıdır; konut finansmanı kapsamındaki ipotek işlemleri harçtan istisnadır. Tapu harcı alıcı ve satıcı için ayrı ayrı %2'dir. Kredi tahsis ücreti de kredi tutarının binde 5'ini geçemez."
    },
    {
      question: "Konut kredisini erken kapatmak avantajlı mı?",
      answer: "Erken kapatmada kalan dönemlerin faizi alınmaz, bu yüzden özellikle ilk yıllarda faiz yükü ciddi azalır. Sabit faizli konut kredilerinde banka, kalan vadeye bağlı olarak sınırlı bir erken ödeme tazminatı isteyebilir. Kesin tutarı öğrenmek için bankanızdan erken kapama bakiyesi isteyin."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="tutar"
      label="Kredi Tutarı"
      type="number"
      suffix="₺"
      placeholder="2000000"
      step="any"
      min={0}
    />
    <CalcInput
      id="faiz"
      label="Aylık Faiz Oranı"
      type="number"
      suffix="%"
      placeholder="2.79"
      step="any"
      min={0}
    />
    <CalcInput
      id="vade"
      label="Vade"
      type="number"
      suffix="ay"
      placeholder="120"
      step={1}
      min={1}
      max={360}
    />
    <CalcInput
      id="sigorta"
      label="Sigorta ve Ek Masraflar (toplam)"
      type="number"
      suffix="₺"
      placeholder="0"
      step="any"
      min={0}
      required={false}
      helpText="İsteğe bağlı: DASK, hayat/konut sigortası, ekspertiz"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Aylık Taksit</p>
      <p class="calc-result-value" id="aylik-taksit">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Geri Ödeme</span>
        <span class="calc-detail-value" id="toplam-odeme">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Faiz</span>
        <span class="calc-detail-value" id="toplam-faiz">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Ek Masraflar Dahil Toplam Maliyet</span>
        <span class="calc-detail-value" id="toplam-maliyet">—</span>
      </div>
      <div class="calc-table-wrap">
        <table class="calc-table">
          <caption>Ödeme planı</caption>
          <thead>
            <tr><th scope="col">Ay</th><th scope="col">Taksit</th><th scope="col">Ana para</th><th scope="col">Faiz</th><th scope="col">Vergi</th><th scope="col">Kalan</th></tr>
          </thead>
          <tbody id="odeme-plani"></tbody>
        </table>
      </div>
      <p class="calc-note">Konut kredileri KKDF ve BSMV'den muaftır. Tapu harcı ve kredi tahsis ücreti dahil değildir.</p>
    </div>
  </CalcResult>

  <script>
    import { formatTL, readNumber, setText, showResult, initCalculator } from './_shared';
    import { amortize, renderSchedule } from './_loan';

    function calculate(): boolean {
      const tutar = readNumber('tutar');
      const faiz = readNumber('faiz');
      const vade = Math.round(readNumber('vade'));
      const sigorta = Math.max(0, readNumber('sigorta') || 0);

      if (!(tutar > 0) || !(faiz >= 0) || !(vade >= 1) || vade > 600) {
        showResult(false);
        return false;
      }

      const r = amortize(tutar, faiz, vade);
      setText('aylik-taksit', formatTL(r.payment));
      setText('toplam-odeme', formatTL(r.totalPayment));
      setText('toplam-faiz', formatTL(r.totalInterest));
      setText('toplam-maliyet', formatTL(r.totalPayment + sigorta));
      renderSchedule('odeme-plani', r.rows, formatTL, false);

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Konut Kredisi Nasıl Hesaplanır?</h2>
    <p>
      Konut kredileri eşit taksitle geri ödenir. Taksit tutarı; kredi tutarı, aylık faiz oranı ve vadeye bağlıdır. İhtiyaç kredilerinden farklı olarak konut kredisinde faiz üzerinden KKDF ve BSMV alınmaz, bu yüzden taksit doğrudan akdi faizle hesaplanır.
    </p>
    <p><strong>Taksit = Kredi × r × (1 + r)<sup>n</sup> ÷ ((1 + r)<sup>n</sup> − 1)</strong></p>

    <h2>Örnek Hesaplama</h2>
    <p>
      2.000.000 TL konut kredisi, aylık %2,79 faiz ve 120 ay vade için aylık taksit <strong>57.932,14 TL</strong> olur. On yılın sonunda toplam 6.951.856,76 TL geri ödenir; bunun 4.951.856,76 TL'si faizdir. Vadeyi 180 aya uzatmak taksiti yalnızca 56.196,79 TL'ye düşürür ama toplam faiz 8.115.421,36 TL'ye çıkar. Yüksek faiz ortamında uzun vade, taksiti çok az azaltırken toplam maliyeti belirgin biçimde artırır.
    </p>

    <h2>Toplam Maliyeti Etkileyen Kalemler</h2>
    <ul>
      <li><strong>Peşinat:</strong> BDDK'nın kredi/değer sınırları nedeniyle konut bedelinin bir kısmını kendiniz karşılamanız gerekir.</li>
      <li><strong>Sigortalar:</strong> DASK zorunludur; bankalar genellikle konut ve hayat sigortası da ister.</li>
      <li><strong>Tapu harcı:</strong> Satış bedeli üzerinden alıcı ve satıcı için ayrı ayrı %2.</li>
      <li><strong>Ekspertiz:</strong> Bankanın değerleme raporu için ekspertiz ücreti alınır.</li>
    </ul>
  </section>
</CalcLayout>
