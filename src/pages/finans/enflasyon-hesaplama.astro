---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const meta = {
  title: "Enflasyon Hesaplama",
  seoTitle: "Enflasyon Hesaplama – Paranın Alım Gücü ve Gelecek Değeri",
  description: "Enflasyon hesaplama: paranızın yıllar içinde ne kadar alım gücü kaybedeceğini ve aynı yaşam standardı için gereken tutarı yıllık enflasyonla hesaplayın.",
  summary: "Enflasyonun etkisi bileşik olarak hesaplanır: Gelecekte gereken tutar = Bugünkü tutar × (1 + enflasyon)^yıl, bugünkü paranın gelecekteki alım gücü = Tutar ÷ (1 + enflasyon)^yıl. Örneğin yıllık %30 enflasyonla 10.000 TL'nin 3 yıl sonraki alım gücü 4.551,66 TL'ye düşer; aynı sepeti almak için 21.970 TL gerekir.",
  howTo: [
    "Hesaplamak istediğiniz tutarı girin.",
    "Beklediğiniz ya da gerçekleşen yıllık enflasyon oranını yazın.",
    "Kaç yıllık süreyi hesaplamak istediğinizi girin.",
    "Aynı alım gücü için gereken tutarı, alım gücü kaybını ve toplam fiyat artışını görün."
  ],
  sources: [
    { name: "TÜİK – Tüketici Fiyat Endeksi", url: "https://data.tuik.gov.tr/" },
    { name: "TCMB", url: "https://www.tcmb.gov.tr/" }
  ],
  category: "finans",
  slug: "enflasyon-hesaplama",
  keywords: ["enflasyon hesaplama", "paranın alım gücü hesaplama", "enflasyon etkisi", "reel değer hesaplama", "TÜFE hesaplama", "paranın gelecekteki değeri"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/kira-artis-hesaplama", "finans/bilesik-faiz-hesaplama", "finans/yatirim-getiri-hesaplama", "finans/mevduat-faizi-hesaplama"],
  faq: [
    {
      question: "Enflasyon paranın değerini nasıl etkiler?",
      answer: "Enflasyon, fiyatların genel düzeyindeki artıştır; aynı miktar parayla daha az mal ve hizmet alabilirsiniz. Yıllık %30 enflasyonda bugün 1.000 TL olan bir sepet bir yıl sonra 1.300 TL olur. Başka bir deyişle cebinizdeki 1.000 TL'nin alım gücü, bugünkü fiyatlarla 769 TL'ye iner."
    },
    {
      question: "Birden fazla yıllık enflasyon nasıl hesaplanır?",
      answer: "Yıllık oranlar toplanmaz, çarpılır. İki yıl üst üste %30 enflasyon toplamda %60 değil, 1,30 × 1,30 − 1 = %69 fiyat artışı demektir. Farklı yıllar için her yılın oranını (1 + oran) olarak çarpıp 1 çıkararak toplam enflasyonu bulabilirsiniz."
    },
    {
      question: "Reel getiri nasıl hesaplanır?",
      answer: "Reel getiri = (1 + nominal getiri) ÷ (1 + enflasyon) − 1 formülüyle bulunur. Yıllık %40 net faiz getirisi ve %30 enflasyonda reel getiri %7,7'dir; basitçe 40 − 30 = %10 demek getiriyi olduğundan yüksek gösterir. Negatif reel getiri, birikiminizin alım gücünün azaldığını gösterir."
    },
    {
      question: "Resmi enflasyon verileri nereden öğrenilir?",
      answer: "Türkiye'de resmi tüketici enflasyonunu TÜİK açıklar; veriler her ayın 3'ünde saat 10.00'da yayımlanır. Aylık, yıllık ve 12 aylık ortalama değişim oranları ayrı ayrı verilir. Kira artışlarında 12 aylık ortalama, maaş ve fiyat karşılaştırmalarında genellikle yıllık değişim kullanılır."
    },
    {
      question: "Geçmişteki bir tutarın bugünkü değeri nasıl bulunur?",
      answer: "Geçmişteki tutarı, aradaki dönemdeki TÜFE endeks değerlerinin oranıyla çarparak bugünkü fiyatlarla karşılığını bulursunuz: Bugünkü değer = Eski tutar × (Güncel endeks ÷ Eski endeks). Endeks değerlerine TÜİK veri portalından ulaşabilirsiniz. Bu hesaplayıcıda aynı işlemi ortalama yıllık enflasyonla yapabilirsiniz."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="tutar"
      label="Tutar"
      type="number"
      suffix="₺"
      placeholder="10000"
      step="any"
      min={0}
    />
    <CalcInput
      id="enflasyonOrani"
      label="Yıllık Enflasyon Oranı"
      type="number"
      suffix="%"
      placeholder="30"
      step="any"
      min={-99}
      helpText="Beklenen ya da gerçekleşen ortalama yıllık oran"
    />
    <CalcInput
      id="yilSayisi"
      label="Süre"
      type="number"
      suffix="yıl"
      placeholder="3"
      step="any"
      min={0}
      max={100}
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Aynı Alım Gücü İçin Gereken Tutar</p>
      <p class="calc-result-value" id="gelecek-deger">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Bugünkü Paranın Gelecekteki Alım Gücü</span>
        <span class="calc-detail-value" id="gercek-deger">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Alım Gücü Kaybı</span>
        <span class="calc-detail-value" id="guc-kaybi">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Fiyat Artışı</span>
        <span class="calc-detail-value" id="toplam-artis">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    import { formatTL, formatPercent, readNumber, setText, showResult, initCalculator } from './_shared';

    function calculate(): boolean {
      const tutar = readNumber('tutar');
      const oran = readNumber('enflasyonOrani');
      const yil = readNumber('yilSayisi');

      if (!(tutar > 0) || !(oran > -100) || !(yil > 0) || yil > 100) {
        showResult(false);
        return false;
      }

      const carpan = Math.pow(1 + oran / 100, yil);
      const gelecek = tutar * carpan;
      const reel = tutar / carpan;

      setText('gelecek-deger', formatTL(gelecek));
      setText('gercek-deger', formatTL(reel));
      setText('guc-kaybi', `${formatTL(tutar - reel)} (${formatPercent((1 - 1 / carpan) * 100)})`);
      setText('toplam-artis', formatPercent((carpan - 1) * 100));

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Enflasyon Hesaplaması Nasıl Yapılır?</h2>
    <p>
      Enflasyon her yıl bir önceki yılın fiyatları üzerine eklendiği için etkisi bileşik faiz gibi birikir. Bu nedenle çok yıllı hesaplarda yıllık oranlar toplanmaz; (1 + oran) çarpanları üst üste çarpılır.
    </p>
    <ul>
      <li><strong>Aynı alım gücü için gereken tutar</strong> = Tutar × (1 + enflasyon)<sup>yıl</sup></li>
      <li><strong>Bugünkü paranın gelecekteki alım gücü</strong> = Tutar ÷ (1 + enflasyon)<sup>yıl</sup></li>
      <li><strong>Toplam fiyat artışı</strong> = (1 + enflasyon)<sup>yıl</sup> − 1</li>
    </ul>

    <h2>Örnek Hesaplama</h2>
    <p>
      Yıllık ortalama %30 enflasyon varsayımıyla bugün 10.000 TL'ye alınan bir sepetin 3 yıl sonraki fiyatı 10.000 × 1,30³ = <strong>21.970 TL</strong> olur. Toplam fiyat artışı %119,7'dir. Yastık altında tutulan 10.000 TL ise bugünkü fiyatlarla yalnızca 4.551,66 TL'lik alım gücüne sahip olur; kayıp %54,5'tir.
    </p>
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead><tr><th scope="col">Yıllık enflasyon</th><th scope="col">5 yıl sonra 10.000 TL'nin alım gücü</th><th scope="col">Gereken tutar</th></tr></thead>
        <tbody>
          <tr><td>%10</td><td>6.209,21 TL</td><td>16.105,10 TL</td></tr>
          <tr><td>%20</td><td>4.018,78 TL</td><td>24.883,20 TL</td></tr>
          <tr><td>%30</td><td>2.693,29 TL</td><td>37.129,30 TL</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Hangi Enflasyon Oranını Kullanmalıyım?</h2>
    <p>
      Geçmişe dönük hesaplar için TÜİK'in açıkladığı yıllık TÜFE değişimini, geleceğe dönük tahminler için TCMB'nin Piyasa Katılımcıları Anketi'ndeki beklentileri ya da enflasyon raporundaki ara hedefleri kullanabilirsiniz. Kişisel harcama sepetiniz resmi sepetten farklıysa (örneğin kira payınız yüksekse), hissedilen enflasyon resmi orandan farklı olabilir.
    </p>
  </section>
</CalcLayout>
