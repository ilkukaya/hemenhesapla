---
import CalcLayout from '../../layouts/CalcLayout.astro';
import CalcInput from '../../components/calculator/CalcInput.astro';
import CalcResult from '../../components/calculator/CalcResult.astro';

const meta = {
  title: "Yatırım Getiri Hesaplama",
  seoTitle: "Yatırım Getiri Hesaplama – ROI, Yıllık ve Reel Getiri",
  description: "Yatırım getiri hesaplama: alış ve satış tutarı, süre, temettü ve masraflarla net kârı, toplam getiri oranını (ROI), yıllıklandırılmış bileşik getiriyi ve reel getiriyi hesaplayın.",
  summary: "Getiri oranı (ROI) = (Satış + ek gelir − alış − masraflar) ÷ alış × 100. Farklı sürelerdeki yatırımları karşılaştırmak için yıllık bileşik getiri kullanılır: (Son değer ÷ İlk değer)^(12 ÷ ay) − 1. Örneğin 18 ayda 100.000 TL'den 160.000 TL'ye çıkan yatırımın toplam getirisi %60, yıllık bileşik getirisi %36,8'dir.",
  howTo: [
    "Yatırımın toplam alış maliyetini girin.",
    "Satış tutarını ya da güncel piyasa değerini yazın.",
    "Elde tutma süresini ay olarak girin.",
    "Varsa temettü, kira gibi ara gelirleri ve komisyon gibi masrafları ekleyin.",
    "Reel getiriyi görmek için aynı dönemdeki enflasyonu girin."
  ],
  sources: [
    { name: "TÜİK – Tüketici Fiyat Endeksi", url: "https://data.tuik.gov.tr/" },
    { name: "Sermaye Piyasası Kurulu", url: "https://spk.gov.tr/" }
  ],
  category: "finans",
  slug: "yatirim-getiri-hesaplama",
  keywords: ["yatırım getiri hesaplama", "ROI hesaplama", "yıllık getiri hesaplama", "bileşik yıllık büyüme oranı", "reel getiri hesaplama", "hisse getiri hesaplama"],
  dateModified: "2026-09-26",
  relatedCalcs: ["finans/bilesik-faiz-hesaplama", "finans/enflasyon-hesaplama", "finans/altin-hesaplama", "finans/doviz-cevirici"],
  faq: [
    {
      question: "Yatırım getirisi (ROI) nasıl hesaplanır?",
      answer: "ROI = (Net kâr ÷ Yatırım maliyeti) × 100 formülüyle bulunur. Net kâr; satış tutarı ile yatırım süresince elde edilen temettü, kira gibi gelirlerin toplamından alış maliyeti ve komisyon, vergi gibi masrafların çıkarılmasıyla hesaplanır. 50.000 TL'ye alınıp 65.000 TL'ye satılan bir hissenin ROI'si %30'dur."
    },
    {
      question: "Yıllık getiri neden toplam getiriyi süreye bölerek bulunmaz?",
      answer: "Getiriler bileşik biriktiği için doğrusal bölme yanıltıcıdır. 2 yılda %69 kazanan bir yatırımın yıllık getirisi %34,5 değil, 1,69^(1/2) − 1 = %30'dur. Bir yıldan kısa sürelerde ise doğrusal yöntem getiriyi olduğundan düşük gösterir. Bu nedenle hesaplayıcımız yıllıklandırılmış bileşik getiri (CAGR) kullanır."
    },
    {
      question: "Reel getiri nedir?",
      answer: "Reel getiri, enflasyondan arındırılmış getiridir: (1 + nominal getiri) ÷ (1 + enflasyon) − 1. Yatırımınız %40 kazandırırken aynı dönemde enflasyon %30 ise reel getiriniz yaklaşık %7,7'dir. Nominal olarak kâr eden bir yatırım, enflasyonun altında kalırsa alım gücünüzü azaltmış olur."
    },
    {
      question: "Hisse senedi kazançlarında vergi var mı?",
      answer: "Borsa İstanbul'da işlem gören hisse senetlerinin (yatırım ortaklıkları hariç) alım satım kazançlarında gerçek kişiler için stopaj oranı şu an %0'dır. Kâr payı (temettü) ödemelerinde ise %15 stopaj kesilir. Fon ve diğer menkul kıymetlerde oranlar ürüne ve elde tutma süresine göre değişir."
    },
    {
      question: "Farklı yatırımları nasıl karşılaştırmalıyım?",
      answer: "Farklı sürelerdeki yatırımları karşılaştırırken toplam getiriyi değil, yıllık bileşik getiriyi kullanın; sonra enflasyonu düşerek reel getiriye bakın. Masrafları ve vergileri hesaba katmayı, ayrıca her yatırımın risk düzeyini ve likiditesini de değerlendirmeyi unutmayın."
    }
  ]
};
---

<CalcLayout meta={meta}>
  <form id="calc-form" class="calc-inputs" novalidate>
    <CalcInput
      id="alisFiyati"
      label="Alış Tutarı (Toplam Maliyet)"
      type="number"
      suffix="₺"
      placeholder="100000"
      step="any"
      min={0}
    />
    <CalcInput
      id="satisFiyati"
      label="Satış Tutarı / Güncel Değer"
      type="number"
      suffix="₺"
      placeholder="160000"
      step="any"
      min={0}
    />
    <CalcInput
      id="yatirimSuresi"
      label="Elde Tutma Süresi"
      type="number"
      suffix="ay"
      placeholder="18"
      step="any"
      min={0}
    />
    <CalcInput
      id="ekGelir"
      label="Ara Gelirler"
      type="number"
      suffix="₺"
      placeholder="0"
      step="any"
      min={0}
      required={false}
      helpText="Temettü, kira, kupon gibi (isteğe bağlı)"
    />
    <CalcInput
      id="masraf"
      label="Masraflar"
      type="number"
      suffix="₺"
      placeholder="0"
      step="any"
      min={0}
      required={false}
      helpText="Komisyon, vergi, saklama ücreti (isteğe bağlı)"
    />
    <CalcInput
      id="enflasyon"
      label="Dönem Enflasyonu (yıllık)"
      type="number"
      suffix="%"
      placeholder="30"
      step="any"
      required={false}
      helpText="Reel getiri için (isteğe bağlı)"
    />
  </form>

  <CalcResult>
    <div slot="main">
      <p class="calc-result-label">Net Kâr / Zarar</p>
      <p class="calc-result-value" id="net-getiri">—</p>
    </div>
    <div slot="details">
      <div class="calc-detail-row">
        <span class="calc-detail-label">Toplam Getiri Oranı (ROI)</span>
        <span class="calc-detail-value" id="getiri-orani">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Yıllık Bileşik Getiri</span>
        <span class="calc-detail-value" id="yillik-getiri">—</span>
      </div>
      <div class="calc-detail-row">
        <span class="calc-detail-label">Yıllık Reel Getiri</span>
        <span class="calc-detail-value" id="reel-getiri">—</span>
      </div>
    </div>
  </CalcResult>

  <script>
    import { formatTL, formatPercent, readNumber, setText, showResult, initCalculator } from './_shared';

    function calculate(): boolean {
      const alis = readNumber('alisFiyati');
      const satis = readNumber('satisFiyati');
      const ay = readNumber('yatirimSuresi');
      const ek = Math.max(0, readNumber('ekGelir') || 0);
      const masraf = Math.max(0, readNumber('masraf') || 0);
      const enf = readNumber('enflasyon');

      if (!(alis > 0) || !(satis >= 0) || !(ay > 0)) {
        showResult(false);
        return false;
      }

      const sonDeger = satis + ek - masraf;
      const net = sonDeger - alis;
      const roi = (net / alis) * 100;
      const yillik = sonDeger > 0 ? (Math.pow(sonDeger / alis, 12 / ay) - 1) * 100 : -100;

      setText('net-getiri', formatTL(net));
      const netEl = document.getElementById('net-getiri');
      netEl?.classList.toggle('is-negative', net < 0);
      netEl?.classList.toggle('is-positive', net > 0);
      setText('getiri-orani', formatPercent(roi));
      setText('yillik-getiri', Number.isFinite(yillik) ? formatPercent(yillik) : '—');
      setText(
        'reel-getiri',
        Number.isFinite(enf) && enf > -100 && Number.isFinite(yillik)
          ? formatPercent(((1 + yillik / 100) / (1 + enf / 100) - 1) * 100)
          : 'Enflasyon girilmedi'
      );

      showResult(true);
      return true;
    }

    initCalculator({ calculate });
  </script>

  <section class="calc-content">
    <h2>Yatırım Getirisi Nasıl Hesaplanır?</h2>
    <p>
      Bir yatırımın başarısını ölçmenin en basit yolu, ne kadar kazandırdığını maliyetine oranlamaktır. Ancak farklı sürelerde tutulan yatırımları karşılaştırmak için getiriyi yıllık bazda ifade etmek, enflasyonlu ortamda ise reel getiriye bakmak gerekir.
    </p>
    <ul>
      <li><strong>Net kâr</strong> = Satış tutarı + Ara gelirler − Masraflar − Alış tutarı</li>
      <li><strong>ROI</strong> = Net kâr ÷ Alış tutarı × 100</li>
      <li><strong>Yıllık bileşik getiri</strong> = (Son değer ÷ Alış tutarı)<sup>12 ÷ ay</sup> − 1</li>
      <li><strong>Reel getiri</strong> = (1 + yıllık getiri) ÷ (1 + yıllık enflasyon) − 1</li>
    </ul>

    <h2>Örnek Hesaplama</h2>
    <p>
      100.000 TL'ye alınan bir fon payı 18 ay sonra 160.000 TL'ye satılıyor. Net kâr 60.000 TL, toplam getiri %60'tır. Yıllık bileşik getiri (1,60)<sup>12/18</sup> − 1 = <strong>%36,8</strong> olur. Aynı dönemde yıllık enflasyon %30 ise reel getiri 1,368 ÷ 1,30 − 1 ≈ %5,2'dir. Yani yatırım, enflasyonun biraz üzerinde bir kazanç sağlamıştır.
    </p>
    <p>
      Toplam getiriyi süreye bölerek hesaplamak (60 ÷ 1,5 = %40) yıllık getiriyi olduğundan yüksek gösterirdi. Bu fark, süre uzadıkça ve getiri arttıkça büyür.
    </p>

    <h3>Sonuçları Yorumlarken</h3>
    <ul>
      <li>Kısa süreli (birkaç aylık) yüksek getiriler yıllıklandırıldığında çok büyük görünebilir; bu değer tekrarlanabilir bir performans anlamına gelmez.</li>
      <li>Döviz ve altın yatırımlarında satış tutarını, alış-satış makası nedeniyle alış fiyatından değil satış fiyatından girin.</li>
      <li>Geçmiş getiri, gelecekteki getirinin garantisi değildir.</li>
    </ul>
  </section>
</CalcLayout>
