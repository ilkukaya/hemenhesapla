---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { popularCalcs } from '../utils/catalog';
---

<BaseLayout title="Sayfa bulunamadı | Hemen Hesapla" description="Aradığınız sayfa bulunamadı." noindex>
  <div class="container-page py-16 max-w-3xl">
    <p class="eyebrow mb-3">404</p>
    <h1 class="text-[2.25rem] sm:text-[2.75rem] font-extrabold tracking-[-0.03em]">Bu sayfa hesapta yoktu.</h1>
    <p class="mt-3 text-[1.0625rem] text-[var(--color-text-secondary)] max-w-xl">
      Aradığınız sayfa taşınmış veya kaldırılmış olabilir. Hesaplayıcıyı arayarak ya da aşağıdakilerden birini seçerek devam edin.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <button type="button" data-open-search class="btn-primary"><Icon name="search" size={17} /> Hesaplayıcı ara</button>
      <a href="/" class="btn-secondary">Ana sayfa</a>
    </div>

    <h2 class="eyebrow mt-12 mb-3">Popüler hesaplayıcılar</h2>
    <ul class="card grid sm:grid-cols-2 p-2">
      {popularCalcs.slice(0, 10).map((c) => (
        <li>
          <a href={c.href} class="tool-link">
            <span class="tool-icon"><Icon name={c.icon} size={18} /></span>
            <span class="font-semibold">{c.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
