---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  categoryColor?: string;
}

const { title, description, href, icon, categoryColor } = Astro.props;
---

<a
  href={href}
  class="calc-card group block bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 hover:shadow-md hover:border-[var(--color-primary)]/30 transition-all duration-200"
  data-title={title}
  data-description={description}
>
  <div class="flex items-start gap-3">
    <span class="text-2xl shrink-0" style={categoryColor ? `color: ${categoryColor}` : undefined}>{icon}</span>
    <div class="min-w-0">
      <h3 class="font-[var(--font-heading)] font-bold text-[0.9375rem] text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors leading-snug">
        {title}
      </h3>
      <p class="text-sm text-[var(--color-text-muted)] mt-1 line-clamp-2">{description}</p>
    </div>
  </div>
</a>
