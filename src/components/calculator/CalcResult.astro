---
import Icon from '../ui/Icon.astro';

interface Props {
  id?: string;
  emptyText?: string;
}
const { id = 'calc-result', emptyText = 'Değerleri girin; sonuç siz yazdıkça burada görünür.' } = Astro.props;
---

<div class="calc-empty" aria-hidden="true">
  <Icon name="calculator" size={20} />
  <span>{emptyText}</span>
</div>

<div id={id} class="calc-result hidden" aria-live="polite">
  <div class="calc-result-main">
    <slot name="main" />
  </div>

  <div class="calc-result-details">
    <slot name="details" />
  </div>

  <div class="calc-result-actions no-print">
    <button type="button" class="btn-secondary" data-action="copy-result">
      <Icon name="copy" size={16} /> Sonucu kopyala
    </button>
    <button type="button" class="btn-secondary" data-action="share">
      <Icon name="share-2" size={16} /> Paylaş
    </button>
    <button type="button" class="btn-ghost" data-action="reset">
      <Icon name="rotate-ccw" size={16} /> Temizle
    </button>
  </div>
</div>
