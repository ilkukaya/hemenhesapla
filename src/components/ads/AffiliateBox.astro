---
interface Props {
  title: string;
  description: string;
  ctaText: string;
  ctaUrl: string;
}

const { title, description, ctaText, ctaUrl } = Astro.props;
---

<div class="bg-gradient-to-br from-[var(--color-bg)] to-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 my-4">
  <p class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider mb-2">Önerilen</p>
  <h4 class="font-[var(--font-heading)] font-bold text-sm text-[var(--color-text)] mb-2">{title}</h4>
  <p class="text-sm text-[var(--color-text-secondary)] mb-3">{description}</p>
  <a
    href={ctaUrl}
    rel="noopener noreferrer nofollow sponsored"
    target="_blank"
    class="inline-flex items-center text-sm font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-light)] transition-colors"
  >
    {ctaText} →
  </a>
</div>
