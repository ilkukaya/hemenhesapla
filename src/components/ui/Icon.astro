---
// Lucide ikonlarını derleme sırasında satır içi SVG olarak basar (istemciye JS gitmez).
import * as icons from 'lucide-static';

interface Props {
  name?: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  label?: string;
}

const ALIASES: Record<string, string> = {
  bank: 'Landmark',
  home: 'House',
  chart: 'ChartColumn',
  graduation: 'GraduationCap',
  book: 'BookOpen',
  paint: 'PaintRoller',
  brick: 'BrickWall',
  grid: 'Grid3x3',
  function: 'SquareFunction',
  'percent-circle': 'CirclePercent',
  health: 'HeartPulse',
  build: 'Hammer',
  convert: 'ArrowLeftRight',
  money: 'Banknote',
  whatsapp: 'MessageCircle',
  share: 'Share2',
  reset: 'RotateCcw',
};

const toPascal = (s: string) =>
  s.split(/[-_\s]+/).filter(Boolean).map((p) => p[0].toUpperCase() + p.slice(1)).join('');

const { name = 'calculator', size = 20, class: className = '', strokeWidth = 1.75, label } = Astro.props;

const lib = icons as unknown as Record<string, string>;
const key = ALIASES[name] || toPascal(name);
const raw = lib[key] || lib.Calculator;

const svg = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s+class="[^"]*"/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
  .replace(
    '<svg',
    `<svg class="icon ${className}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`,
  )
  .replace(/\n\s*/g, ' ')
  .trim();
---

<Fragment set:html={svg} />
