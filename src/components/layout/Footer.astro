---
import categoriesData from '../../data/categories.json';
const categories = categoriesData.categories;

const popularCalcs = categories.flatMap(cat =>
  cat.calculators
    .filter(c => c.popular)
    .map(c => ({ ...c, categorySlug: cat.slug }))
);
---

<footer class="bg-[var(--color-primary-dark)] text-white mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span class="font-[var(--font-heading)] font-bold text-lg">
            Hemen<span class="text-[var(--color-accent)]">Hesapla</span>
          </span>
        </a>
        <p class="text-sm text-white/60 leading-relaxed">
          Türkiye'nin en kapsamlı online hesaplayıcı platformu. Hızlı, güvenilir ve ücretsiz hesaplama araçları.
        </p>
      </div>

      <!-- Kategoriler -->
      <div>
        <h3 class="font-[var(--font-heading)] font-bold text-sm uppercase tracking-wider mb-4 text-white/80">Kategoriler</h3>
        <ul class="space-y-2">
          {categories.map((cat) => (
            <li>
              <a href={`/${cat.slug}/`} class="text-sm text-white/60 hover:text-white transition-colors">
                {cat.icon} {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popüler Hesaplayıcılar -->
      <div>
        <h3 class="font-[var(--font-heading)] font-bold text-sm uppercase tracking-wider mb-4 text-white/80">Popüler</h3>
        <ul class="space-y-2">
          {popularCalcs.slice(0, 8).map((calc) => (
            <li>
              <a href={`/${calc.categorySlug}/${calc.slug}/`} class="text-sm text-white/60 hover:text-white transition-colors">
                {calc.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bilgi -->
      <div>
        <h3 class="font-[var(--font-heading)] font-bold text-sm uppercase tracking-wider mb-4 text-white/80">Bilgi</h3>
        <ul class="space-y-2">
          <li><a href="/hakkimizda/" class="text-sm text-white/60 hover:text-white transition-colors">Hakkımızda</a></li>
          <li><a href="/iletisim/" class="text-sm text-white/60 hover:text-white transition-colors">İletişim</a></li>
          <li><a href="/gizlilik/" class="text-sm text-white/60 hover:text-white transition-colors">Gizlilik Politikası</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-10 pt-6 text-center">
      <p class="text-sm text-white/40">
        &copy; {new Date().getFullYear()} hemenhesapla.net — Tüm hakları saklıdır.
      </p>
    </div>
  </div>
</footer>
