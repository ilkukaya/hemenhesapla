---
import Icon from '../ui/Icon.astro';
import { allCalcs, categories, normalizeTr } from '../../utils/catalog';

// Kullanıcıların sık yazdığı ama başlıkta geçmeyen terimler
const SYNONYMS: Record<string, string> = {
  'vucut-kitle-indeksi': 'bmi vki boy kilo endeksi',
  'net-brut-maas-hesaplama': 'maas brutten nete netten brute bordro',
  'kdv-hesaplama': 'katma deger vergisi kdv dahil haric',
  'kredi-hesaplama': 'ihtiyac kredisi taksit faiz',
  'doviz-cevirici': 'dolar euro kur sterlin',
  'yuzde-hesaplama': 'yuzdelik oran',
  'gebelik-haftasi-hesaplama': 'hamilelik kac haftalik',
  'dogum-tarihi-hesaplama': 'tahmini dogum hamilelik',
  'altin-hesaplama': 'gram ceyrek yarim tam altin',
  'kidem-tazminati-hesaplama': 'isten ayrilma tazminat',
  'emeklilik-hesaplama': 'ne zaman emekli olurum eyt prim gunu',
  'yas-hesaplama': 'kac yasindayim dogum gunu',
  'gun-hesaplama': 'iki tarih arasi gun sayisi',
  'vize-final-ortalama-hesaplama': 'vize final gecme notu ders ortalamasi',
};

const items = allCalcs.map((c) => ({
  ...c,
  haystack: normalizeTr(`${c.title} ${c.description} ${c.categoryName} ${SYNONYMS[c.slug] || ''}`),
}));
---

<dialog id="search-dialog" class="search-dialog" aria-label="Hesaplayıcı ara">
  <div class="search-panel">
    <div class="flex items-center gap-2 px-4 border-b border-[var(--color-border)]">
      <Icon name="search" size={20} class="text-[var(--color-text-muted)]" />
      <input
        id="search-q"
        type="search"
        inputmode="search"
        enterkeyhint="go"
        autocomplete="off"
        spellcheck="false"
        placeholder="Ne hesaplamak istiyorsunuz? (örn. kredi, maaş, vize)"
        class="flex-1 h-14 bg-transparent outline-none text-[1.0625rem] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="icon-btn" data-close aria-label="Aramayı kapat"><Icon name="x" size={20} /></button>
    </div>
    <p id="search-label" class="px-5 pt-3 pb-1 eyebrow">Popüler</p>
    <ul id="search-results" role="listbox" class="px-2 pb-2 overflow-y-auto overscroll-contain">
      {items.map((c) => (
        <li role="option" data-haystack={c.haystack} data-popular={c.popular ? '1' : '0'} data-title={normalizeTr(c.title)} aria-selected="false">
          <a href={c.href} class="tool-link" style={`--cat:${categories.find((k) => k.slug === c.category)?.color}`}>
            <span class="tool-icon"><Icon name={c.icon} size={18} /></span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-[var(--color-text)] truncate">{c.title}</span>
              <span class="block text-[0.8125rem] text-[var(--color-text-muted)] truncate">{c.categoryName} · {c.description}</span>
            </span>
            <Icon name="corner-down-left" size={16} class="search-enter text-[var(--color-text-muted)]" />
          </a>
        </li>
      ))}
    </ul>
    <p id="search-empty" class="hidden px-5 py-8 text-center text-[var(--color-text-muted)]">
      Sonuç bulunamadı. <a class="link" href="/iletisim/">Bu hesaplayıcıyı eklememizi isteyin</a>.
    </p>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    width: 100%;
    max-width: 640px;
    max-height: 100dvh;
    overflow: hidden;
    color: var(--color-text);
  }
  .search-dialog::backdrop { background: rgb(10 10 10 / .45); backdrop-filter: blur(2px); }
  .search-panel {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    background: var(--color-surface);
  }
  .search-panel { width: 100%; min-width: 0; overflow: hidden; }
  .search-panel #search-results { flex: 1; overflow-x: hidden; min-width: 0; }
  #search-results li, #search-results .tool-link { min-width: 0; }
  @media (min-width: 768px) {
    .search-dialog { margin-top: 10vh; }
    .search-panel { height: auto; max-height: 70vh; border-radius: 18px; border: 1px solid var(--color-border); box-shadow: var(--shadow-lg); overflow: hidden; }
  }
  .search-dialog[open] .search-panel { animation: sheet-in .18s ease-out; }
  #search-results li[aria-selected="true"] .tool-link { background: var(--color-surface-2); }
  #search-results .search-enter { opacity: 0; }
  #search-results li[aria-selected="true"] .search-enter { opacity: 1; }
  #search-q::-webkit-search-cancel-button { display: none; }
</style>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('search-q') as HTMLInputElement | null;
  const list = document.getElementById('search-results');
  const label = document.getElementById('search-label');
  const empty = document.getElementById('search-empty');
  const rows = Array.from(list?.querySelectorAll<HTMLLIElement>('li') ?? []);
  let active = -1;

  const norm = (s: string) =>
    s.toLocaleLowerCase('tr-TR')
      .replace(/ı/g, 'i').replace(/ğ/g, 'g').replace(/ü/g, 'u')
      .replace(/ş/g, 's').replace(/ö/g, 'o').replace(/ç/g, 'c');

  function visible() { return rows.filter((r) => !r.hidden); }

  function setActive(i: number) {
    const v = visible();
    v.forEach((r) => r.setAttribute('aria-selected', 'false'));
    active = Math.max(0, Math.min(i, v.length - 1));
    const el = v[active];
    if (el) {
      el.setAttribute('aria-selected', 'true');
      el.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
  }

  function filter(q: string) {
    const terms = norm(q).split(/\s+/).filter(Boolean);
    if (!terms.length) {
      rows.forEach((r) => (r.hidden = r.dataset.popular !== '1'));
      if (label) label.textContent = 'Popüler';
    } else {
      const scored = rows.map((r) => {
        const hay = r.dataset.haystack || '';
        const ok = terms.every((t) => hay.includes(t));
        const title = r.dataset.title || '';
        const score = !ok ? -1 : (title.startsWith(terms[0]) ? 3 : 0) + (title.includes(terms[0]) ? 2 : 0);
        return { r, score };
      });
      scored.sort((a, b) => b.score - a.score);
      scored.forEach(({ r, score }) => { r.hidden = score < 0; list?.appendChild(r); });
      if (label) label.textContent = 'Sonuçlar';
    }
    const count = visible().length;
    empty?.classList.toggle('hidden', count > 0);
    label?.classList.toggle('hidden', count === 0);
    setActive(0);
  }

  function open(q = '') {
    if (!dialog || !input) return;
    input.value = q;
    filter(q);
    if (!dialog.open) dialog.showModal();
    input.focus();
  }

  (window as any).hhOpenSearch = open;

  document.querySelectorAll('[data-open-search]').forEach((b) =>
    b.addEventListener('click', () => open((b as HTMLElement).dataset.query || '')),
  );
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  input?.addEventListener('input', () => filter(input.value));
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') {
      const a = visible()[active]?.querySelector('a');
      if (a) { e.preventDefault(); window.location.href = a.href; }
    }
  });

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
</script>
