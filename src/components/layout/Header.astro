---
import categoriesData from '../../data/categories.json';
const categories = categoriesData.categories;
---

<header class="bg-[var(--color-surface)] border-b border-[var(--color-border)] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src="/favicon.svg" alt="" width="32" height="32" />
        <span class="font-[var(--font-heading)] font-extrabold text-xl text-[var(--color-primary)]">
          Hemen<span class="text-[var(--color-accent)]">Hesapla</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {categories.slice(0, 5).map((cat) => (
          <a
            href={`/${cat.slug}/`}
            class="px-3 py-2 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] rounded-lg hover:bg-[var(--color-bg)] transition-colors"
          >
            {cat.name}
          </a>
        ))}
        <div class="relative group">
          <button class="px-3 py-2 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] rounded-lg hover:bg-[var(--color-bg)] transition-colors">
            Diğer ▾
          </button>
          <div class="absolute right-0 top-full mt-1 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg shadow-lg py-1 hidden group-hover:block min-w-[160px]">
            {categories.slice(5).map((cat) => (
              <a
                href={`/${cat.slug}/`}
                class="block px-4 py-2 text-sm text-[var(--color-text-secondary)] hover:bg-[var(--color-bg)] hover:text-[var(--color-primary)]"
              >
                {cat.icon} {cat.name}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-lg hover:bg-[var(--color-bg)] transition-colors"
        aria-label="Menüyü aç"
        aria-expanded="false"
      >
        <svg class="w-6 h-6 text-[var(--color-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)]">
    <nav class="px-4 py-3 space-y-1">
      {categories.map((cat) => (
        <a
          href={`/${cat.slug}/`}
          class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] rounded-lg hover:bg-[var(--color-bg)] transition-colors"
        >
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    const isOpen = !mobileMenu?.classList.contains('hidden');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!menuBtn?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
